<div class="fallout-maw-calendar-main-wrapper">
    {{#if uiElementStates.compactView}}
        <div class="fallout-maw-calendar-header-add-left">
            {{#if compactViewDisplay.currentSeasonName }}
                <div class="fallout-maw-calendar-season">
                    <div class="fallout-maw-calendar-season-text" data-tooltip="{{compactViewDisplay.currentSeasonName}}">{{{compactViewDisplay.currentSeasonIcon}}}</div>
                </div>
            {{/if}}
            <div class="fallout-maw-calendar-moons">
                {{#if (gt compactViewDisplay.selectedDayMoons.length 5)}}
                    <div class="fallout-maw-calendar-moon-group-wrapper">
                        <div class="fallout-maw-calendar-moon-phase {{compactViewDisplay.selectedDayMoons.0.phase.icon}}" data-tooltip="{{compactViewDisplay.selectedDayMoons.0.name}} - {{compactViewDisplay.selectedDayMoons.0.phase.name}}">{{{compactViewDisplay.selectedDayMoons.0.iconSVG}}}</div>
                        <span class="fallout-maw-calendar-moon-phase fa fa-caret-down"></span>
                        <div class="fallout-maw-calendar-moon-group">
                            {{#each compactViewDisplay.selectedDayMoons}}
                                <div class="fallout-maw-calendar-moon-phase {{phase.icon}}" data-tooltip="{{name}} - {{phase.name}}">{{{iconSVG}}}</div>
                            {{/each}}
                        </div>
                    </div>
                {{else}}
                    {{#each compactViewDisplay.selectedDayMoons}}
                        <div class="fallout-maw-calendar-moon-phase {{phase.icon}}" data-tooltip="{{name}} - {{phase.name}}">{{{iconSVG}}}</div>
                    {{/each}}
                {{/if}}
            </div>
        </div>
        <div class="fallout-maw-calendar-header-add-right">
            <div class="fallout-maw-calendar-note-buttons">
                <button class="fallout-maw-calendar-control {{#if (gt calendar.selectedDay.noteCount 0)}} fallout-maw-calendar-secondary{{else}} fallout-maw-calendar-grey{{/if}} fallout-maw-calendar-notes" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.Notes'}}"><span class="fa-solid fa-note-sticky"></span>&nbsp;{{calendar.selectedDay.noteCount}}</button>
                {{#if (gt calendar.selectedDay.noteReminderCount 0)}}
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-tertiary fallout-maw-calendar-reminder-notes" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.Notes'}}"><span class="fa fa-bell"></span>&nbsp;{{calendar.selectedDay.noteReminderCount}}</button>
                {{/if}}
                {{#if addNotes}}
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-save fallout-maw-calendar-add-note" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.AddNew'}}"><span class="fa-solid fa-note-sticky"></span>&nbsp;<span class="fa fa-plus"></span></button>
                {{/if}}
            </div>
        </div>
        <div class="fallout-maw-calendar-section">
            <div class="fallout-maw-calendar-date">
                <div class="fallout-maw-calendar-date-text">{{calendar.selectedDay.dateDisplay}}</div>
            </div>
        </div>
        {{#if showClock}}
        <div class="fallout-maw-calendar-section">
            <div class="fallout-maw-calendar-clock-display">
                {{fallout-maw-calendar-clock id=calendar.clockDisplayId calendarId=calendar.id theme='none'}}
                {{#if changeDateTime}}
                    {{#if showTimeControls}}
                        {{#if isPrimary}}
                            <div class="fallout-maw-calendar-time-keeper-buttons">
                                <button class="fallout-maw-calendar-control fallout-maw-calendar-time-start {{#if (eq clockClass 'started')}} fallout-maw-calendar-secondary{{else}} fallout-maw-calendar-save{{/if}}" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Time.Start'}}"><span class="fa {{#if (eq clockClass 'started')}} fa-pause{{else}} fa-play{{/if}}"></span></button>
                                <button class="fallout-maw-calendar-control fallout-maw-calendar-time-stop {{#if (eq clockClass 'stopped')}} fallout-maw-calendar-grey{{else}} fallout-maw-calendar-delete{{/if}}" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Time.Stop'}}"><span class="fa fa-stop"></span></button>
                            </div>

                        {{else if uiElementStates.primaryCheckRunning}}
                            <div class="fallout-maw-calendar-primary-loader"><span class="fas fa-spinner fa-spin"></span></div>
                        {{/if}}
                    {{/if}}
                {{/if}}
            </div>
        </div>
        {{/if}}
        {{#if changeDateTime}}
            <div class="fallout-maw-calendar-section">
                {{fallout-maw-calendar-date-time-controls showDateControls=showDateControls showTimeControls=showTimeControls displayType=compactViewDisplay.dateTimeControlDisplay fullDisplay=dateTimeFullDisplay largeSteps=uiElementStates.cvLargerSteps reverseTime=uiElementStates.cvReverseTime }}
            </div>
        {{/if}}
        <div class="fallout-maw-calendar-section">
            <div class="fallout-maw-calendar-side-drawer fallout-maw-calendar-note-list {{sideDrawerDirection}} {{#if uiElementStates.fallout-maw-calendar-note-list}} fallout-maw-calendar-open{{else}} fallout-maw-calendar-closed{{/if}}">
                <h2>{{localize 'FALLOUTMAW.Calendar.Notes.For'}} {{calendar.selectedDay.dateDisplay}}</h2>
                {{#if calendar.selectedDay.notes.length}}
                    <div class="fallout-maw-calendar-note-list">
                        {{#each calendar.selectedDay.notes}}
                            <div class="fallout-maw-calendar-note" data-index="{{entryId}}" draggable="{{#if ../reorderNotes}}true{{else}}false{{/if}}">
                                <div class="fallout-maw-calendar-note-details-wrapper">
                                    <h3 class="fallout-maw-calendar-note-title">{{title}}</h3>
                                    <div class="fallout-maw-calendar-note-details">
                                        {{#if ../isGM}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon {{playerVisible.color}}" data-tooltip="{{playerVisible.players}}">
                                                <span class="fa {{playerVisible.icon}}"></span>
                                            </div>
                                        {{/if}}
                                        {{#if userReminderRegistered}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon fallout-maw-calendar-reminder" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.ReminderHelp'}}">
                                                <span class="fa fa-bell"></span>
                                            </div>
                                        {{/if}}
                                        {{#if (and canEdit (ne 'none' macro))}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon" data-tooltip="{{localize 'DOCUMENT.Macro'}}">
                                                <span class="fas fa-scroll"></span>
                                            </div>
                                        {{/if}}
                                        <div class="fallout-maw-calendar-note-time fallout-maw-calendar-note-category" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.Time'}}">
                                            <span class="fa fa-clock"></span>  {{#if allDay}}{{localize 'FALLOUTMAW.Calendar.AllDay'}}{{else}}{{displayDate}}{{/if}}
                                        </div>
                                        {{#if authorDisplay}}
                                            <div class="fallout-maw-calendar-note-category" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.Author'}}" style="background-color:{{authorDisplay.color}};color:{{authorDisplay.textColor}};">
                                                <span class="fa fa-pencil-alt"></span> {{authorDisplay.name}}
                                            </div>
                                        {{/if}}
                                        {{#each categories}}
                                            <div class="fallout-maw-calendar-note-category" style="background-color:{{color}};color:{{textColor}};">
                                                {{name}}
                                            </div>
                                        {{/each}}
                                    </div>
                                </div>
                                {{#if ../reorderNotes}}
                                    <div class="fallout-maw-calendar-sorting-dragger"><span class="fa fa-arrows-alt-v"></span></div>
                                {{/if}}
                            </div>
                        {{/each}}
                    </div>
                {{else}}
                    <em>{{localize 'FALLOUTMAW.Calendar.Notes.Empty'}}</em>
                {{/if}}
            </div>
            <div class="fallout-maw-calendar-context-menu {{sideDrawerDirection}} fallout-maw-calendar-hide" data-id="">
                <div class="fallout-maw-calendar-day-context-list">
                    <div class="fallout-maw-calendar-context-list-action" data-action="remind"></div>
                    {{#if isGM}}
                        <div class="fallout-maw-calendar-context-list-action" data-action="showPlayers"><span class="fa fa-eye"></span>{{localize 'JOURNAL.ActionShow'}}</div>
                    {{/if}}
                    <div class="fallout-maw-calendar-context-list-break"></div>
                    <div class="fallout-maw-calendar-context-list-action" data-action="edit"><span class="fa fa-pen-to-square"></span>{{localize 'FALLOUTMAW.Calendar.Edit'}}</div>
                    <div class="fallout-maw-calendar-context-list-action" data-action="delete"><span class="fa fa-trash"></span>{{localize 'FALLOUTMAW.Calendar.Delete'}}</div>
                </div>
            </div>
        </div>

    {{else}}
        {{#unless (eq '' message)}}
            <div class="fallout-maw-calendar-message fallout-maw-calendar-warn">{{{message}}}</div>
        {{/unless}}
        <div class="fallout-maw-calendar-section">
            <div class="fallout-maw-calendar-calendar-display">
                {{fallout-maw-calendar-full-calendar id=calendar.calendarDisplayId calendarId=calendar.id theme='none' date=calendar.visibleDate}}
            </div>
            <div class="fallout-maw-calendar-actions-list">
                {{#if (gt mainViewDisplay.calendarList.length 1)}}
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-primary fallout-maw-calendar-calendars" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Calendars'}}"><span class="fa fa-calendar"></span></button>
                {{/if}}
                <button class="fallout-maw-calendar-control {{#if (gt calendar.selectedDay.noteCount 0)}} fallout-maw-calendar-secondary{{else}} fallout-maw-calendar-grey{{/if}} fallout-maw-calendar-notes" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.Notes'}}"><span class="fa fa-sticky-note"></span>&nbsp;{{calendar.selectedDay.noteCount}}</button>
                {{#if (gt calendar.selectedDay.noteReminderCount 0)}}
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-tertiary fallout-maw-calendar-reminder-notes" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.Notes'}}"><span class="fa fa-bell"></span>&nbsp;{{calendar.selectedDay.noteReminderCount}}</button>
                {{/if}}
                {{#if addNotes}}
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-save fallout-maw-calendar-add-note" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.AddNew'}}"><span class="fa fa-sticky-note"></span>&nbsp;<span class="fa fa-plus"></span></button>
                {{/if}}
                <button class="fallout-maw-calendar-control fallout-maw-calendar-grey fallout-maw-calendar-search" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Search.Title'}}"><span class="fa fa-search "></span></button>
                {{{mainViewDisplay.addonButtons}}}
                {{#if isGM}}
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-grey fallout-maw-calendar-time-options-button" data-tooltip="{{timeOptionLabels.title}}" aria-label="{{timeOptionLabels.title}}"><span class="fa-solid fa-sliders"></span></button>
                {{/if}}
                <span class="fallout-maw-calendar-spacer"></span>
                {{#if changeDateTime}}
                    {{#if showSetCurrentDate}}
                        <button class="fallout-maw-calendar-control fallout-maw-calendar-save fallout-maw-calendar-btn-apply " data-tooltip="{{localize 'FALLOUTMAW.Calendar.SetCurrentDate'}}"><span class="fa fa-calendar-check"></span></button>
                    {{/if}}
                {{/if}}
                <button class="fallout-maw-calendar-control fallout-maw-calendar-grey fallout-maw-calendar-today" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Today'}}"><span class="fa fa-calendar-day"></span></button>
                <button class="fallout-maw-calendar-control fallout-maw-calendar-grey fallout-maw-calendar-configure-button" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configure'}}"><span class="fa fa-cog"></span></button>
            </div>
            {{#if (gt mainViewDisplay.calendarList.length 1)}}
                <div class="fallout-maw-calendar-side-drawer fallout-maw-calendar-calendar-list {{sideDrawerDirection}} {{#if uiElementStates.fallout-maw-calendar-calendar-list}} fallout-maw-calendar-open{{else}} fallout-maw-calendar-closed{{/if}}">
                    <h2>{{localize 'FALLOUTMAW.Calendar.Calendars'}}</h2>
                    {{#each mainViewDisplay.calendarList}}
                        <div class="fallout-maw-calendar-calendar-display {{#if (eq id ../activeCalendarId)}} fallout-maw-calendar-active{{/if}} {{#if (eq id ../calendar.id)}} fallout-maw-calendar-visible{{/if}} {{#unless ../mainViewDisplay.showChangeCalendarControls}} fallout-maw-calendar-clickable{{/unless}}" data-calid="{{id}}">
                            <div class="fallout-maw-calendar-details">
                                <div class="fallout-maw-calendar-calendar-name">{{name}}</div>
                                <div class="fallout-maw-calendar-calendar-date">
                                    <div class="fa fa-calendar-day"></div>
                                    <div>{{date}}</div>
                                    <div>{{time}}</div>
                                    {{#if clockRunning}}
                                        <div class="fallout-maw-calendar-animated-clock fallout-maw-calendar-animate">{{fallout-maw-calendar-icon name='clock'}}</div>
                                    {{/if}}
                                </div>
                                {{#if ../mainViewDisplay.showChangeCalendarControls}}
                                    {{#unless (eq id ../activeCalendarId)}}
                                        <div class="fallout-maw-calendar-calendar-actions">
                                            <button class="fallout-maw-calendar-control fallout-maw-calendar-save"><span class="fa fa-check"></span> {{localize 'FALLOUTMAW.Calendar.MakeActive'}}</button>
                                        </div>
                                    {{/unless}}
                                {{/if}}
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{/if}}
            <div class="fallout-maw-calendar-side-drawer fallout-maw-calendar-note-list {{sideDrawerDirection}} {{#if uiElementStates.fallout-maw-calendar-note-list}} fallout-maw-calendar-open{{else}} fallout-maw-calendar-closed{{/if}}">
                <h2>{{localize 'FALLOUTMAW.Calendar.Notes.For'}} {{calendar.selectedDay.dateDisplay}}</h2>
                {{#if calendar.selectedDay.notes.length}}
                    <div class="fallout-maw-calendar-note-list">
                        {{#each calendar.selectedDay.notes}}
                            <div class="fallout-maw-calendar-note" data-index="{{entryId}}" draggable="{{#if ../reorderNotes}}true{{else}}false{{/if}}">
                                <div class="fallout-maw-calendar-note-details-wrapper">
                                    <h3 class="fallout-maw-calendar-note-title">{{title}}</h3>
                                    <div class="fallout-maw-calendar-note-details">
                                        {{#if ../isGM}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon {{playerVisible.color}}" data-tooltip="{{playerVisible.players}}">
                                                <span class="fa {{playerVisible.icon}}"></span>
                                            </div>
                                        {{/if}}
                                        {{#if userReminderRegistered}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon fallout-maw-calendar-reminder" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.ReminderHelp'}}">
                                                <span class="fa fa-bell"></span>
                                            </div>
                                        {{/if}}
                                        {{#if (and canEdit (ne 'none' macro))}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon" data-tooltip="{{localize 'DOCUMENT.Macro'}}">
                                                <span class="fas fa-scroll"></span>
                                            </div>
                                        {{/if}}
                                        <div class="fallout-maw-calendar-note-time fallout-maw-calendar-note-category" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.Time'}}">
                                            <span class="fa fa-clock"></span>  {{#if allDay}}{{localize 'FALLOUTMAW.Calendar.AllDay'}}{{else}}{{displayDate}}{{/if}}
                                        </div>
                                        {{#if authorDisplay}}
                                            <div class="fallout-maw-calendar-note-category" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.Author'}}" style="background-color:{{authorDisplay.color}};color:{{authorDisplay.textColor}};">
                                                <span class="fa fa-pencil-alt"></span> {{authorDisplay.name}}
                                            </div>
                                        {{/if}}
                                        {{#each categories}}
                                            <div class="fallout-maw-calendar-note-category" style="background-color:{{color}};color:{{textColor}};">
                                                {{name}}
                                            </div>
                                        {{/each}}
                                    </div>
                                </div>
                                {{#if ../reorderNotes}}
                                    <div class="fallout-maw-calendar-sorting-dragger"><span class="fa fa-arrows-alt-v"></span></div>
                                {{/if}}
                            </div>
                        {{/each}}
                    </div>
                {{else}}
                    <em>{{localize 'FALLOUTMAW.Calendar.Notes.Empty'}}</em>
                {{/if}}
            </div>
            <div class="fallout-maw-calendar-side-drawer fallout-maw-calendar-note-search {{sideDrawerDirection}} {{#if uiElementStates.fallout-maw-calendar-note-search}} fallout-maw-calendar-open{{else}} fallout-maw-calendar-closed{{/if}}">
                <h2>{{localize 'FALLOUTMAW.Calendar.SearchNotes'}}</h2>
                <div class="fallout-maw-calendar-search-box">
                    <input id="falloutMawCalendarSearchBox" type="text" value="{{mainViewDisplay.search.term}}" aria-label="{{localize 'FALLOUTMAW.Calendar.SearchNotes'}}" />
                    {{#if mainViewDisplay.search.results.length}}
                        <button class="fallout-maw-calendar-control fallout-maw-calendar-clear" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Clear'}}"><span class="fa fa-times"></span></button>
                    {{/if}}
                    <button class="fallout-maw-calendar-control"><span class="fa fa-search"></span></button>
                </div>
                <h3 class="fallout-maw-calendar-search-options-header">{{localize 'FALLOUTMAW.Calendar.Search.Options.Title'}} <span class="fa fa-caret-down"></span></h3>
                <div class="fallout-maw-calendar-search-options {{#if uiElementStates.searchOptionsOpen}} fallout-maw-calendar-open{{else}} fallout-maw-calendar-closed{{/if}}">
                    <p><strong>{{localize 'FALLOUTMAW.Calendar.Search.Options.FieldsLabel'}}:</strong> {{localize 'FALLOUTMAW.Calendar.Search.Options.FieldsHelp'}}</p>
                    <div class="fallout-maw-calendar-search-fields">
                        <label><input type="checkbox" data-field="date" {{checked mainViewDisplay.search.options.fields.date}}> {{localize 'FALLOUTMAW.Calendar.Search.Options.Fields.Date'}}</label>
                        <label><input type="checkbox" data-field="title" {{checked mainViewDisplay.search.options.fields.title}}> {{localize 'FALLOUTMAW.Calendar.Search.Options.Fields.Title'}}</label>
                        <label><input type="checkbox" data-field="details" {{checked mainViewDisplay.search.options.fields.details}}> {{localize 'FALLOUTMAW.Calendar.Search.Options.Fields.Details'}}</label>
                        <label><input type="checkbox" data-field="author" {{checked mainViewDisplay.search.options.fields.author}}> {{localize 'Author'}}</label>
                        <label><input type="checkbox" data-field="categories" {{checked mainViewDisplay.search.options.fields.categories}}> {{localize 'FALLOUTMAW.Calendar.Search.Options.Fields.Categories'}}</label>
                    </div>
                </div>
                <div class="fallout-maw-calendar-note-list">
                    {{#if mainViewDisplay.search.results.length}}
                        {{#each mainViewDisplay.search.results}}
                            <div class="fallout-maw-calendar-note" data-index="{{entryId}}">
                                <div class="fallout-maw-calendar-note-details-wrapper">
                                    <h3 class="fallout-maw-calendar-note-title">{{title}}</h3>
                                    <div class="fallout-maw-calendar-note-details">
                                        {{#if ../isGM}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon {{playerVisible.color}}" data-tooltip="{{playerVisible.players}}">
                                                <span class="fa {{playerVisible.icon}}"></span>
                                            </div>
                                        {{/if}}
                                        {{#if reminder}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon fallout-maw-calendar-reminder" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.ReminderHelp'}}">
                                                <span class="fa fa-bell"></span>
                                            </div>
                                        {{/if}}
                                        {{#if (and canEdit (ne 'none' macro))}}
                                            <div class="fallout-maw-calendar-note-category fallout-maw-calendar-note-icon" data-tooltip="{{localize 'DOCUMENT.Macro'}}">
                                                <span class="fas fa-scroll"></span>
                                            </div>
                                        {{/if}}
                                        <div class="fallout-maw-calendar-note-time fallout-maw-calendar-note-category" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.Time'}}">
                                            <span class="fa fa-clock"></span>  {{#if allDay}}{{localize 'FALLOUTMAW.Calendar.AllDay'}}{{else}}{{displayDate}}{{/if}}
                                        </div>
                                        {{#if authorDisplay}}
                                            <div class="fallout-maw-calendar-note-category" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Notes.Author'}}" style="background-color:{{authorDisplay.color}};color:{{authorDisplay.textColor}};">
                                                <span class="fa fa-pencil-alt"></span> {{authorDisplay.name}}
                                            </div>
                                        {{/if}}
                                        {{#each categories}}
                                            <div class="fallout-maw-calendar-note-category" style="background-color:{{color}};color:{{textColor}};">
                                                {{name}}
                                            </div>
                                        {{/each}}
                                    </div>
                                </div>
                            </div>
                        {{/each}}
                    {{else}}
                        <em>{{localize 'FALLOUTMAW.Calendar.SearchEmpty'}}</em>
                    {{/if}}
                </div>
            </div>
            {{#if isGM}}
                <div class="fallout-maw-calendar-side-drawer fallout-maw-calendar-time-options {{sideDrawerDirection}} {{#if uiElementStates.fallout-maw-calendar-time-options}} fallout-maw-calendar-open{{else}} fallout-maw-calendar-closed{{/if}}">
                    <h2>{{timeOptionLabels.title}}</h2>
                    <div class="fallout-maw-calendar-time-options-list">
                        <label class="fallout-maw-calendar-time-option" for="falloutMawCalendarRestMode">
                            <span>{{timeOptionLabels.restMode}}</span>
                            <input id="falloutMawCalendarRestMode" type="checkbox" data-time-option="restMode" {{checked timeOptions.restMode}}>
                        </label>
                        <label class="fallout-maw-calendar-time-option" for="falloutMawCalendarIgnoreTimeMechanics">
                            <span>{{timeOptionLabels.ignoreTimeMechanics}}</span>
                            <input id="falloutMawCalendarIgnoreTimeMechanics" type="checkbox" data-time-option="ignoreTimeMechanics" {{checked timeOptions.ignoreTimeMechanics}}>
                        </label>
                        <label class="fallout-maw-calendar-time-option" for="falloutMawCalendarNeedsPlayersOnly">
                            <span>{{timeOptionLabels.needsPlayersOnly}}</span>
                            <input id="falloutMawCalendarNeedsPlayersOnly" type="checkbox" data-time-option="needsPlayersOnly" {{checked timeOptions.needsPlayersOnly}}>
                        </label>
                    </div>
                </div>
            {{/if}}
            {{{mainViewDisplay.addonButtonSidePanels}}}
            <div class="fallout-maw-calendar-context-menu {{sideDrawerDirection}} fallout-maw-calendar-hide" data-id="">
                <div class="fallout-maw-calendar-day-context-list">
                    <div class="fallout-maw-calendar-context-list-action" data-action="remind"></div>
                    {{#if isGM}}
                        <div class="fallout-maw-calendar-context-list-action" data-action="showPlayers"><span class="fa fa-eye"></span>{{localize 'JOURNAL.ActionShow'}}</div>
                    {{/if}}
                    <div class="fallout-maw-calendar-context-list-break"></div>
                    <div class="fallout-maw-calendar-context-list-action" data-action="edit"><span class="fa fa-pen-to-square"></span>{{localize 'FALLOUTMAW.Calendar.Edit'}}</div>
                    <div class="fallout-maw-calendar-context-list-action" data-action="delete"><span class="fa fa-trash"></span>{{localize 'FALLOUTMAW.Calendar.Delete'}}</div>
                </div>
            </div>
        </div>
        {{#if showClock}}
            <div class="fallout-maw-calendar-section">
                <div class="fallout-maw-calendar-clock-display">
                    {{fallout-maw-calendar-clock id=calendar.clockDisplayId calendarId=calendar.id theme='none'}}
                </div>
                <div class="fallout-maw-calendar-actions-list">
                    {{#if changeDateTime}}
                        {{#if showTimeControls}}
                            {{#if isPrimary}}
                                <div class="fallout-maw-calendar-time-keeper-buttons">
                                    <button class="fallout-maw-calendar-control fallout-maw-calendar-time-start {{#if (eq clockClass 'started')}} fallout-maw-calendar-secondary{{else}} fallout-maw-calendar-save{{/if}}" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Time.Start'}}"><span class="fa {{#if (eq clockClass 'started')}} fa-pause{{else}} fa-play{{/if}}"></span></button>
                                    <button class="fallout-maw-calendar-control fallout-maw-calendar-time-stop {{#if (eq clockClass 'stopped')}} fallout-maw-calendar-grey{{else}} fallout-maw-calendar-delete{{/if}}" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Time.Stop'}}"><span class="fa fa-stop"></span></button>
                                </div>

                            {{else if uiElementStates.primaryCheckRunning}}
                                <div class="fallout-maw-calendar-primary-loader"><span class="fas fa-spinner fa-spin"></span></div>
                            {{/if}}
                        {{/if}}
                    {{/if}}
                </div>
            </div>
        {{/if}}
        {{#if changeDateTime}}
            <div class="fallout-maw-calendar-section">
                {{fallout-maw-calendar-date-time-controls showDateControls=showDateControls showTimeControls=showTimeControls displayType='full' fullDisplay=dateTimeFullDisplay }}
            </div>
        {{/if}}
    {{/if}}
</div>



