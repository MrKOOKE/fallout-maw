                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarMinutesInHour">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.MinutesInHour'}}</label>
                    <div class="form-fields">
                        <input value="{{time.minutesInHour}}" type="number" id="falloutMawCalendarMinutesInHour" />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.MinutesInHourHelp'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarSecondsInMinute">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.SecondsInMinute'}}</label>
                    <div class="form-fields">
                        <input value="{{time.secondsInMinute}}" type="number" id="falloutMawCalendarSecondsInMinute" />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.SecondsInMinuteHelp'}}</p>
                </div>
            </div>
            <div class="fallout-maw-calendar-section fallout-maw-calendar-open">
                <h2>{{localize 'FALLOUTMAW.Calendar.Configuration.Time.ClockSettings'}} <a href="https://simplecalendar.info/docs/calendar-configuration/time-settings#clock-settings" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Help'}}" target="_blank" class="fa fa-question-circle"></a></h2>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarShowClock">{{localize 'FALLOUTMAW.Calendar.Configuration.General.ShowClock'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{generalSettings.showClock}}" type="checkbox" id="falloutMawCalendarShowClock" {{checked generalSettings.showClock}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.General.ShowClockHelp'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarGameTimeRatio">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.GameTimeRatio'}}</label>
                    <div class="form-fields">
                        <input value="{{time.gameTimeRatio}}" type="number" id="falloutMawCalendarGameTimeRatio" />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.GameTimeRatioHelp'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarTimeUpdateFrequency">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.UpdateFrequency'}}</label>
                    <div class="form-fields">
                        <input value="{{time.updateFrequency}}" type="number" id="falloutMawCalendarTimeUpdateFrequency" />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.UpdateFrequencyHelp'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarUnifyClockWithFoundryPause">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.UnifyGameAndClock'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{time.unifyGameAndClockPause}}" type="checkbox" id="falloutMawCalendarUnifyClockWithFoundryPause" {{checked time.unifyGameAndClockPause}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.UnifyGameAndClockHelp'}}</p>
                </div>
            </div>
        </div>
        <div class="tab fallout-maw-calendar-note-settings" data-tab="noteSettings">
            <div class="fallout-maw-calendar-settings-group fallout-maw-calendar-open">
                <h2>{{localize 'FALLOUTMAW.Calendar.Configuration.Notes.Title'}} <a href="https://simplecalendar.info/docs/calendar-configuration/note-settings" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Help'}}" target="_blank" class="fa fa-question-circle"></a></h2>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarDefaultPlayerVisibility">{{localize 'FALLOUTMAW.Calendar.Configuration.DefaultNoteVisibility'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{generalSettings.noteDefaultVisibility}}" type="checkbox" id="falloutMawCalendarDefaultPlayerVisibility" {{checked generalSettings.noteDefaultVisibility}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.DefaultNoteVisibilityHint'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarPostNoteRemindersOnFoundryLoad">{{localize 'FALLOUTMAW.Calendar.Configuration.Notes.PostNoteRemindersOnFoundryLoadTitle'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{generalSettings.postNoteRemindersOnFoundryLoad}}" type="checkbox" id="falloutMawCalendarPostNoteRemindersOnFoundryLoad" {{checked generalSettings.postNoteRemindersOnFoundryLoad}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Notes.PostNoteRemindersOnFoundryLoadHelp'}}</p>
                </div>
            </div>
            <div class="fallout-maw-calendar-settings-group fallout-maw-calendar-open">
                <h2>{{localize 'FALLOUTMAW.Calendar.Configuration.Notes.NoteCategories'}} <a href="https://simplecalendar.info/docs/calendar-configuration/note-settings#note-categories" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Help'}}" target="_blank" class="fa fa-question-circle"></a></h2>
                <div class="fallout-maw-calendar-hidden-label">
                    <label id="fallout-maw-calendar-note-categories-name">{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.NameHelp'}}</label>
                    <label id="fallout-maw-calendar-note-categories-color">{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.ColorHelp'}}</label>
                </div>
                <div class="fallout-maw-calendar-f-table fallout-maw-calendar-note-categories">
                    <div class="fallout-maw-calendar-row fallout-maw-calendar-head">
                        <div class="fallout-maw-calendar-col" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.NameHelp'}}">{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.Name'}}</div>
                        <div class="fallout-maw-calendar-col" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.ColorHelp'}}">{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.Color'}}</div>
                        <div class="fallout-maw-calendar-col"></div>
                    </div>
                    {{#each noteCategories}}
                        <div class="fallout-maw-calendar-row" data-index="{{@index}}">
                            <div class="fallout-maw-calendar-col">
                                <label for="falloutMawCalendarNoteCategoryName{{@index}}" class="fallout-maw-calendar-hidden-label">{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.Name'}}</label>
                                <input id="falloutMawCalendarNoteCategoryName{{@index}}" class="fallout-maw-calendar-note-category-name" value="{{name}}" type="text"  aria-describedby="fallout-maw-calendar-note-categories-name" />
                            </div>
                            <div class="fallout-maw-calendar-col">
                                <label for="falloutMawCalendarNoteCategoryColor{{@index}}" class="fallout-maw-calendar-hidden-label">{{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.Color'}}</label>
                                <input id="falloutMawCalendarNoteCategoryColor{{@index}}" type="color" value="{{color}}" class="fallout-maw-calendar-note-category-color" aria-describedby="fallout-maw-calendar-note-categories-color" />
                            </div>
                            <div class="fallout-maw-calendar-col">
                                <button class="fallout-maw-calendar-control fallout-maw-calendar-delete" data-type="note-category"><span class="fa fa-trash"></span> {{localize 'FALLOUTMAW.Calendar.Configuration.Month.Remove'}}</button>
                            </div>
                        </div>
                    {{/each}}
                </div>
                <div class="fallout-maw-calendar-table-actions">
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-save" data-type="note-category"><span class="fa fa-plus"></span> {{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.Add'}}</button>
                    <span class="fallout-maw-calendar-spacer"></span>
                    <button class="fallout-maw-calendar-control fallout-maw-calendar-delete" data-type="note-category" data-index="all"><span class="fa fa-trash"></span> {{localize 'FALLOUTMAW.Calendar.Configuration.NoteCategories.RemoveAll'}}</button>
                </div>
            </div>
        </div>
        {{/if}}
        <div class="tab fallout-maw-calendar-about" data-tab="about">
            <div class="fallout-maw-calendar-logo">
                {{fallout-maw-calendar-icon name='logo'}}
            </div>
            <h1>{{localize 'FALLOUTMAW.Calendar.Title'}}</h1>
            <p class="fallout-maw-calendar-description">{{localize 'FALLOUTMAW.Calendar.Configuration.About.Description'}}</p>
            <div class="fallout-maw-calendar-row">
                <div class="fallout-maw-calendar-card fallout-maw-calendar-authors">
                    <h2>{{localize 'FALLOUTMAW.Calendar.Title'}}</h2>
                    <p>{{localize 'FALLOUTMAW.Calendar.Configuration.About.Maintenance'}}</p>
                    <p>{{localize 'FALLOUTMAW.Calendar.Configuration.About.Attribution'}}</p>
                </div>
            </div>
        </div>
    </div>
    <div class="fallout-maw-calendar-config-save">
        <button class="fallout-maw-calendar-control fallout-maw-calendar-save" id="falloutMawCalendarSave" type="button" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.Save'}}">
            <i class="far fa-save"></i> {{localize 'FALLOUTMAW.Calendar.Configuration.Save'}}
        </button>
    </div>
</form>

