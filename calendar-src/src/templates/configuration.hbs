<form autocomplete="off" class="fallout-maw-calendar-configuration-wrapper">
    <nav class="fallout-maw-calendar-sheet-tabs tabs">
        <div class="fallout-maw-calendar-tab-section fallout-maw-calendar-global-settings">
            <div class="fallout-maw-calendar-heading">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.Title'}}</div>
            <a class="fallout-maw-calendar-item" data-tab="globalSettings">{{localize 'FALLOUTMAW.Calendar.Settings'}}</a>
            {{#if isGM}}
            <a class="fallout-maw-calendar-item" data-tab="permissions">{{localize 'Permissions'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="importExport">{{localize 'FALLOUTMAW.Calendar.Configuration.General.ImportExport.Title'}}</a>
            {{/if}}
        </div>
        {{#if isGM}}
        <div class="fallout-maw-calendar-tab-section fallout-maw-calendar-stripe fallout-maw-calendar-calendar-settings">
            <div class="fallout-maw-calendar-calendar-selector">
                <div class="fallout-maw-calendar-heading">{{localize 'FALLOUTMAW.Calendar.Calendar'}}:<br/>{{object.name}}</div>
                <ul class="fallout-maw-calendar-closed">
                    {{#each calendars}}
                        <li class="{{#if (eq ../object.id id)}} fallout-maw-calendar-active{{/if}}" data-calendar="{{id}}">
                            {{name}} {{#unless (eq id 'default_temp')}}<button class="fallout-maw-calendar-control fallout-maw-calendar-delete" data-tooltip="{{localize 'FALLOUTMAW.Calendar.RemoveCalendar'}}" data-calendar="{{id}}"><span class="fa fa-trash"></span></button>{{/unless}}
                        </li>
                    {{/each}}
                    <li class="fallout-maw-calendar-item fallout-maw-calendar-new-calendar" data-tab="newCalendar">{{localize 'FALLOUTMAW.Calendar.AddNewCalendar'}}<span class="fa fa-plus-circle"></span></li>
                </ul>
            </div>
            <a class="fallout-maw-calendar-item" data-tab="quickSetup">{{localize 'FALLOUTMAW.Calendar.Configuration.General.QuickSetup'}}</a>
            <div class="fallout-maw-calendar-sub-heading">{{localize 'FALLOUTMAW.Calendar.Settings'}}</div>
            <a class="fallout-maw-calendar-item" data-tab="generalSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.General.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="displayOptions">{{localize 'FALLOUTMAW.Calendar.Configuration.General.DisplayOptions'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="yearSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.Year.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="monthSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.Month.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="weekdaySettings">{{localize 'FALLOUTMAW.Calendar.Configuration.Weekday.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="leapYearSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.LeapYear.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="seasonSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.Season.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="moonSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.Moon.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="timeSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.Title'}}</a>
            <a class="fallout-maw-calendar-item" data-tab="noteSettings">{{localize 'FALLOUTMAW.Calendar.Configuration.Notes.Title'}}</a>
        </div>
        {{/if}}
        <div class="fallout-maw-calendar-tab-section fallout-maw-calendar-help">
            <div class="fallout-maw-calendar-heading">{{localize 'FALLOUTMAW.Calendar.Help'}}</div>
            <a class="fallout-maw-calendar-item" href="https://simplecalendar.info/" target="_blank">{{localize 'FALLOUTMAW.Calendar.Documentation'}}&nbsp;<span class="fa fa-external-link-alt"></span></a>
            <a class="fallout-maw-calendar-item" data-tab="about">{{localize 'About'}}</a>
        </div>
    </nav>
    <div class="fallout-maw-calendar-tab-wrapper">
        <div class="tab fallout-maw-calendar-global-settings" data-tab="globalSettings">
            {{#if isGM}}
            <div class="fallout-maw-calendar-section fallout-maw-calendar-open">
                <h2>{{localize 'FALLOUTMAW.Calendar.Configuration.Global.Title'}} <a href="https://simplecalendar.info/docs/global-configuration/settings" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Help'}}" target="_blank" class="fa fa-question-circle"></a></h2>
                <p>{{localize 'FALLOUTMAW.Calendar.Configuration.Global.Description'}}</p>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarSyncCalendars">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.SyncCalendars.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{globalConfiguration.syncCalendars}}" type="checkbox" id="falloutMawCalendarSyncCalendars" {{checked globalConfiguration.syncCalendars}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.SyncCalendars.Description'}}</p>
                </div>
                <!--
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarCalendarsSameTimestamp">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.SameTimestamp.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{globalConfiguration.calendarsSameTimestamp}}" type="checkbox" id="falloutMawCalendarCalendarsSameTimestamp" {{checked globalConfiguration.calendarsSameTimestamp}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.SameTimestamp.Description'}}</p>
                </div>
                -->
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarSecondsInCombatRound">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.SecondsInCombatRound'}}</label>
                    <div class="form-fields">
                        <input value="{{globalConfiguration.secondsInCombatRound}}" type="number" id="falloutMawCalendarSecondsInCombatRound" />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Time.SecondsInCombatRoundHelp'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarCombatPauseClockRule">{{localize 'FALLOUTMAW.Calendar.Configuration.CombatPauseRule.Title'}}</label>
                    <div class="form-fields">
                        <select id="falloutMawCalendarCombatPauseClockRule">
                            {{selectOptions combatPauseRules selected=globalConfiguration.combatPauseRule localize=true}}
                        </select>
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.CombatPauseRule.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarShowNoteFolder">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.ShowNoteFolder.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{globalConfiguration.showNotesFolder}}" type="checkbox" id="falloutMawCalendarShowNoteFolder" {{checked globalConfiguration.showNotesFolder}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.ShowNoteFolder.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarInGameChatTimestamp">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.InGameChatTimestamp.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{globalConfiguration.inGameChatTimestamp}}" type="checkbox" id="falloutMawCalendarInGameChatTimestamp" {{checked globalConfiguration.inGameChatTimestamp}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Global.InGameChatTimestamp.Description'}}</p>
                </div>
            </div>
            {{/if}}
            <div class="fallout-maw-calendar-section fallout-maw-calendar-open">
                <h2>{{localize 'FALLOUTMAW.Calendar.Configuration.Client.Title'}} <a href="https://simplecalendar.info/docs/using-sc/client-settings" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Help'}}" target="_blank" class="fa fa-question-circle"></a></h2>
                <p>{{localize 'FALLOUTMAW.Calendar.Configuration.Client.Description'}}</p>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarTheme">{{localize 'FALLOUTMAW.Calendar.Configuration.Theme.Title'}}</label>
                    <div class="form-fields">
                        <select id="falloutMawCalendarTheme">
                            {{selectOptions clientSettings.themes selected=clientSettings.theme localize=true}}
                        </select>
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Theme.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarOpenOnLoad">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.OpenOnLoad.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{clientSettings.openOnLoad}}" type="checkbox" id="falloutMawCalendarOpenOnLoad" {{checked clientSettings.openOnLoad}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.OpenOnLoad.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarOpenInCompact">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.OpenCompact.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{clientSettings.openInCompact}}" type="checkbox" id="falloutMawCalendarOpenInCompact" {{checked clientSettings.openInCompact}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.OpenCompact.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarRememberPos">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.RememberPosition.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{clientSettings.rememberPos}}" type="checkbox" id="falloutMawCalendarRememberPos" {{checked clientSettings.rememberPos}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.RememberPosition.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarRememberCompactPos">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.RememberCompactPosition.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{clientSettings.rememberCompactPos}}" type="checkbox" id="falloutMawCalendarRememberCompactPos" {{checked clientSettings.rememberCompactPos}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.RememberCompactPosition.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarNoteReminderNotification">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.NoteReminderNotification.Title'}}</label>
                    <div class="form-fields">
                        <select id="falloutMawCalendarNoteReminderNotification">
                            {{selectOptions clientSettings.noteReminderNotifications selected=clientSettings.noteReminderNotification localize=true}}
                        </select>
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.NoteReminderNotification.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarSideDrawerDirection">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.NoteListOpenDirection.Title'}}</label>
                    <div class="form-fields">
                        <select id="falloutMawCalendarSideDrawerDirection">
                            {{selectOptions clientSettings.sideDrawerDirections selected=clientSettings.sideDrawerDirection localize=true}}
                        </select>
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.NoteListOpenDirection.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarAlwaysOpenNoteList">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.AlwaysShowNoteList.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{clientSettings.alwaysShowNoteList}}" type="checkbox" id="falloutMawCalendarAlwaysOpenNoteList" {{checked clientSettings.alwaysShowNoteList}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.AlwaysShowNoteList.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarPersistentOpen">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.PersistentOpen.Title'}}</label>
                    <div class="form-fields">
                        <input class="fallout-maw-calendar-toggle" value="{{clientSettings.persistentOpen}}" type="checkbox" id="falloutMawCalendarPersistentOpen" {{checked clientSettings.persistentOpen}} />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.PersistentOpen.Description'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label for="falloutMawCalendarCompactViewScale">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.CompactViewScale.Title'}}</label>
                    <div class="form-fields">
                        {{rangePicker name="falloutMawCalendarCompactViewScale" value=clientSettings.compactViewScale step=10 min=70 max=200}}
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.Client.CompactViewScale.Description'}}</p>
                </div>
            </div>
        </div>

        {{#if isGM}}
        <div class="tab fallout-maw-calendar-permissions" data-tab="permissions">
            <h2>{{localize 'Permissions'}} <a href="https://simplecalendar.info/docs/global-configuration/permissions" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Help'}}" target="_blank" class="fa fa-question-circle"></a></h2>
            <p>{{localize 'FALLOUTMAW.Calendar.Configuration.General.Permissions.Note'}}</p>
            <header class="fallout-maw-calendar-table-header flexrow">
                <label class="fallout-maw-calendar-index">{{localize 'PERMISSION.Permission'}}</label>
                <label>{{localize 'USER.RolePlayer'}}</label>
                <label>{{localize 'USER.RoleTrusted'}}</label>
                <label>{{localize 'USER.RoleAssistant'}}</label>
                <label>{{localize 'USER.RoleGamemaster'}}</label>
            </header>
            <ul class="fallout-maw-calendar-permissions-list">
                <li class="fallout-maw-calendar-permission form-group fallout-maw-calendar-open">
                    <label class="fallout-maw-calendar-index">{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="CalendarVisible.P" id="falloutMawCalendarCalendarVisibleP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RolePlayer'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RolePlayer'}}" {{checked globalConfiguration.permissions.viewCalendar.player}} />
                        <input type="checkbox" name="CalendarVisible.TP" id="falloutMawCalendarCalendarVisibleTP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RoleTrusted'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RoleTrusted'}}" {{checked globalConfiguration.permissions.viewCalendar.trustedPlayer}} />
                        <input type="checkbox" name="CalendarVisible.AGM" id="falloutMawCalendarCalendarVisibleAGM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RoleAssistant'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RoleAssistant'}}" {{checked globalConfiguration.permissions.viewCalendar.assistantGameMaster}} />
                        <input type="checkbox" name="CalendarVisible.GM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RoleGamemaster'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisible'}}: {{localize 'USER.RoleGamemaster'}}" checked disabled />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.General.CalendarPlayerVisibleHelp'}}</p>
                </li>
                <li class="fallout-maw-calendar-permission form-group fallout-maw-calendar-open">
                    <label class="fallout-maw-calendar-index">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="AddNotes.P" id="falloutMawCalendarAddNotesP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RolePlayer'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RolePlayer'}}" {{checked globalConfiguration.permissions.addNotes.player}} />
                        <input type="checkbox" name="AddNotes.TP" id="falloutMawCalendarAddNotesTP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RoleTrusted'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RoleTrusted'}}" {{checked globalConfiguration.permissions.addNotes.trustedPlayer}} />
                        <input type="checkbox" name="AddNotes.AGM" id="falloutMawCalendarAddNotesAGM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RoleAssistant'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RoleAssistant'}}" {{checked globalConfiguration.permissions.addNotes.assistantGameMaster}} />
                        <input type="checkbox" name="AddNotes.GM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RoleGamemaster'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotes'}}: {{localize 'USER.RoleGamemaster'}}" checked disabled />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerAddNotesHelp'}}</p>
                </li>
                <li class="fallout-maw-calendar-permission form-group fallout-maw-calendar-open">
                    <label class="fallout-maw-calendar-index">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="AddNotes.P" id="falloutMawCalendarReorderNotesP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RolePlayer'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RolePlayer'}}" {{checked globalConfiguration.permissions.reorderNotes.player}} />
                        <input type="checkbox" name="AddNotes.TP" id="falloutMawCalendarReorderNotesTP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RoleTrusted'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RoleTrusted'}}" {{checked globalConfiguration.permissions.reorderNotes.trustedPlayer}} />
                        <input type="checkbox" name="AddNotes.AGM" id="falloutMawCalendarReorderNotesAGM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RoleAssistant'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RoleAssistant'}}" {{checked globalConfiguration.permissions.reorderNotes.assistantGameMaster}} />
                        <input type="checkbox" name="AddNotes.GM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RoleGamemaster'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotes'}}: {{localize 'USER.RoleGamemaster'}}" checked disabled />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayerReorderNotesHelp'}}</p>
                </li>
                <li class="fallout-maw-calendar-permission form-group fallout-maw-calendar-open">
                    <label class="fallout-maw-calendar-index">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="AddNotes.P" id="falloutMawCalendarChangeDateTimeP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RolePlayer'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RolePlayer'}}" {{checked globalConfiguration.permissions.changeDateTime.player}} />
                        <input type="checkbox" name="AddNotes.TP" id="falloutMawCalendarChangeDateTimeTP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RoleTrusted'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RoleTrusted'}}" {{checked globalConfiguration.permissions.changeDateTime.trustedPlayer}} />
                        <input type="checkbox" name="AddNotes.AGM" id="falloutMawCalendarChangeDateTimeAGM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RoleAssistant'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RoleAssistant'}}" {{checked globalConfiguration.permissions.changeDateTime.assistantGameMaster}} />
                        <input type="checkbox" name="AddNotes.GM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RoleGamemaster'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTime'}}: {{localize 'USER.RoleGamemaster'}}" checked disabled />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeDateTimeHelp'}}</p>
                </li>
                <li class="fallout-maw-calendar-permission form-group fallout-maw-calendar-open">
                    <label class="fallout-maw-calendar-index">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}</label>
                    <div class="form-fields">
                        <input type="checkbox" name="AddNotes.P" id="falloutMawCalendarChangeActiveCalP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RolePlayer'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RolePlayer'}}" {{checked globalConfiguration.permissions.changeActiveCalendar.player}} />
                        <input type="checkbox" name="AddNotes.TP" id="falloutMawCalendarChangeActiveCalTP" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RoleTrusted'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RoleTrusted'}}" {{checked globalConfiguration.permissions.changeActiveCalendar.trustedPlayer}} />
                        <input type="checkbox" name="AddNotes.AGM" id="falloutMawCalendarChangeActiveCalAGM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RoleAssistant'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RoleAssistant'}}" {{checked globalConfiguration.permissions.changeActiveCalendar.assistantGameMaster}} />
                        <input type="checkbox" name="AddNotes.GM" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RoleGamemaster'}}" aria-label="{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendar'}}: {{localize 'USER.RoleGamemaster'}}" checked disabled />
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.General.PlayersChangeActiveCalendarHelp'}}</p>
                </li>
            </ul>
        </div>
        <div class="tab fallout-maw-calendar-import-export" data-tab="importExport">
            <h2>{{localize 'FALLOUTMAW.Calendar.Configuration.General.ImportExport.Title'}} <a href="https://simplecalendar.info/docs/global-configuration/import-export" data-tooltip="{{localize 'FALLOUTMAW.Calendar.Help'}}" target="_blank" class="fa fa-question-circle"></a></h2>
            <div class="fallout-maw-calendar-section fallout-maw-calendar-open">
                <div class="form-group fallout-maw-calendar-open">
                    <label>{{localize 'FALLOUTMAW.Calendar.Import'}}</label>
                    <div class="form-fields fallout-maw-calendar-importing">
                        <input type="file" id="falloutMawCalendarImportCalendarPicker" accept="application/json, .json" />
                        <div class="fallout-maw-calendar-progress fallout-maw-calendar-hide">
                            <div class="fallout-maw-calendar-progress-bar"></div>
                        </div>
                        <div class="fallout-maw-calendar-file-details"></div>
                    </div>
                    <p class="notes">{{localize 'FALLOUTMAW.Calendar.Configuration.ImportExport.ImportDescription'}}</p>
                </div>
                <div class="form-group fallout-maw-calendar-open">
                    <label>{{localize 'FALLOUTMAW.Calendar.Export'}}</label>
                    <div class="form-fields">
                        <ul class="fallout-maw-calendar-calendar-list">
                            <li><label><input type="checkbox" data-id="global" checked /><span class="fa fa-cog"></span>&nbsp;{{localize 'FALLOUTMAW.Calendar.Configuration.Global.Title'}}</label></li>
                            <li><label><input type="checkbox" data-id="permissions" checked /><span class="fa fa-key"></span>&nbsp;{{localize 'Permissions'}}</label></li>
                            {{#each calendars}}
                                <li><label><input type="checkbox" data-id="{{id}}" checked /><strong><span class="fa fa-calendar"></span> {{name}}</strong>: {{localize 'FALLOUTMAW.Calendar.CalendarConfiguration'}}</label></li>
