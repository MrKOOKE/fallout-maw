{
  "schemaVersion": 1,
  "status": "ready-for-direct-world-write",
  "scope": {
    "include": [
      "damageSources",
      "energySources",
      "weapons",
      "nonCivilianEquipment"
    ],
    "exclude": [
      "actors",
      "civilianEquipment",
      "compendiumItems",
      "robots"
