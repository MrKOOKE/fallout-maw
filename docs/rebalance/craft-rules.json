    "precisionPlatform": 10,
    "advancedEnergyOrGuidance": 10,
    "powerArmor": 20,
    "exceptionalUniqueArchitecture": 20,
    "minimum": 20
  },
  "priceCalculator": {
    "implementation": "systems/fallout-maw/src/sheets/item-sheet.mjs",
    "componentCost": "round(sum(component.price * quantity) / resultQuantity)",
    "toolCost": "round(sum(tool.price * quantity / tool.maxSupply) / resultQuantity)",
    "difficultyPercent": "5*n*(n+1)/2 + (n+1)*r, where tens=floor(difficulty/10), n=floor(tens/5), r=tens-5*n",
    "finalPrice": "round(componentCost * (1 + difficultyPercent/100) + toolCost)",
    "mandatoryAfterRecipeChange": true
  },
