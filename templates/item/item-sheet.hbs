{{#*inline "weaponActionSettings"}}
    <div class="fallout-maw-weapon-action-settings-list">
      {{#each actionChoices}}
      {{#if selected}}
      <section class="fallout-maw-weapon-action-settings" data-weapon-action-settings="{{key}}">
        <h3>{{displayLabel}}</h3>
        {{#if ../isModuleModifier}}
        <label><span>{{localize "FALLOUTMAW.Item.ModuleActionAvailability"}}</span>
          <select name="{{../path}}.{{key}}.availability">{{#each availabilityChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
        </label>
        {{/if}}
        <div class="fallout-maw-list-grid three-columns">
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponActionName"}}</span>
            <input type="text" name="{{../path}}.{{key}}.name" value="{{name}}" placeholder="{{label}}">
          </label>
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponActionPointCost"}}</span>
            <input type="number" name="{{#if ../isModuleModifier}}system.functions.module.weapon.actionPointCosts.{{key}}{{else}}{{../path}}.{{key}}.actionPointCost{{/if}}" value="{{actionPointCost}}" {{#unless ../isModuleModifier}}min="0"{{/unless}} step="1">
          </label>
        </div>
        {{#if isReload}}
        {{else if isVolley}}
        <div class="fallout-maw-list-grid three-columns">
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponVolleyDamageRadius"}}</span>
            <input type="text" name="{{../path}}.volley.damageRadius" value="{{volleyDamageRadius}}" data-formula-autocomplete="all" {{#if ../usesDamageSource}}disabled{{/if}}>
          </label>
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponVolleyExplosionDelay"}}</span>
            <input type="text" name="{{../path}}.volley.regionDelaySeconds" value="{{volleyRegionDelaySeconds}}" data-formula-autocomplete="all" {{#if ../usesDamageSource}}disabled{{/if}}>
          </label>
        </div>
        <div class="fallout-maw-panel-header">
          <h4>{{localize "FALLOUTMAW.Item.WeaponVolleyRegion"}}</h4>
          <button type="button" data-add-volley-region-damage {{#if ../usesDamageSource}}disabled{{/if}}><i class="fa-solid fa-plus"></i> {{localize "FALLOUTMAW.Item.WeaponVolleyAddRegionDamage"}}</button>
        </div>
        {{#if ../isModuleModifier}}
        <label><span>{{localize "FALLOUTMAW.Item.ModuleListMode"}}</span><select name="{{../path}}.{{key}}.regionDamageEntriesMode">{{#each regionDamageEntriesModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{/if}}
        <div class="fallout-maw-settings-table fallout-maw-damage-entry-table fallout-maw-volley-region-damage">
          <div class="fallout-maw-settings-row fallout-maw-grid-header">
            <span>{{localize "FALLOUTMAW.Item.WeaponDamageType"}}</span>
            <span>{{localize "FALLOUTMAW.Common.Value"}}</span>
            <span></span>
          </div>
          {{#each volleyRegionDamageRows}}
          <div class="fallout-maw-settings-row" data-volley-region-damage-row="{{index}}">
            <select name="{{../../path}}.volley.regionDamageEntries.{{index}}.damageTypeKey" data-volley-region-damage-type {{#if ../../usesDamageSource}}disabled{{/if}}>
              {{#each choices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <input type="text" name="{{../../path}}.volley.regionDamageEntries.{{index}}.amount" value="{{amount}}" data-formula-autocomplete="all" data-volley-region-damage-amount {{#if ../../usesDamageSource}}disabled{{/if}}>
            <button type="button" class="fallout-maw-icon-delete-button" data-delete-volley-region-damage="{{index}}" title="{{localize 'FALLOUTMAW.Common.Delete'}}" {{#if ../../usesDamageSource}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button>
          </div>
          {{else}}
          <p class="fallout-maw-empty-list">{{localize "FALLOUTMAW.Item.WeaponVolleyNoRegionDamage"}}</p>
          {{/each}}
        </div>
        <div class="fallout-maw-list-grid three-columns">
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponVolleyRegionRadius"}}</span>
            <input type="text" name="{{../path}}.volley.regionRadius" value="{{volleyRegionRadius}}" data-formula-autocomplete="all" {{#if ../usesDamageSource}}disabled{{/if}}>
          </label>
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponVolleyRegionDuration"}}</span>
            <input type="text" name="{{../path}}.volley.regionDurationSeconds" value="{{volleyRegionDurationSeconds}}" data-formula-autocomplete="all" {{#if ../usesDamageSource}}disabled{{/if}}>
          </label>
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponVolleyRegionRadiusDelta"}}</span>
            <input type="text" name="{{../path}}.volley.regionRadiusDeltaMeters" value="{{volleyRegionRadiusDeltaMeters}}" data-formula-autocomplete="all" {{#if ../usesDamageSource}}disabled{{/if}}>
          </label>
        </div>
        <div class="fallout-maw-panel-header">
          <h4>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.SpecialProperties"}}</h4>
          <button type="button" data-add-region-special-property data-region-special-property-path="{{../path}}.volley" {{#if ../usesDamageSource}}disabled{{/if}}><i class="fa-solid fa-plus"></i> {{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.AddSpecialProperty"}}</button>
        </div>
        {{#if ../isModuleModifier}}
        <label><span>{{localize "FALLOUTMAW.Item.ModuleListMode"}}</span><select name="{{../path}}.{{key}}.regionSpecialPropertiesMode">{{#each regionSpecialPropertiesModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{/if}}
        <div class="fallout-maw-settings-table fallout-maw-region-special-property-list">
          {{#each volleyRegionSpecialProperties}}
          <div class="fallout-maw-settings-row fallout-maw-region-special-property-row" data-region-special-property-row="{{index}}">
            <select name="{{../../path}}.volley.regionSpecialProperties.{{index}}.type" data-region-special-property-type="{{index}}" data-region-special-property-path="{{../../path}}.volley" {{#if ../../usesDamageSource}}disabled{{/if}}>
              {{#each choices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            {{#if isSmoke}}
            <label><span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.SmokeThickness"}}</span><input type="text" name="{{../../path}}.volley.regionSpecialProperties.{{index}}.smoke.thickness" value="{{smoke.thickness}}" data-formula-autocomplete="all" {{#if ../../usesDamageSource}}disabled{{/if}}></label>
            <label><span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.SmokeDensity"}}</span><input type="text" name="{{../../path}}.volley.regionSpecialProperties.{{index}}.smoke.densityPercent" value="{{smoke.densityPercent}}" data-formula-autocomplete="all" {{#if ../../usesDamageSource}}disabled{{/if}}></label>
            {{/if}}
            <button type="button" class="fallout-maw-icon-delete-button" data-delete-region-special-property="{{index}}" data-region-special-property-path="{{../../path}}.volley" title="{{localize 'FALLOUTMAW.Common.Delete'}}" {{#if ../../usesDamageSource}}disabled{{/if}}><i class="fa-solid fa-trash"></i></button>
          </div>
          {{/each}}
        </div>
        {{#if ../isModuleModifier}}
        <div class="fallout-maw-list-grid two-columns">
          <label><span>{{localize "FALLOUTMAW.Item.WeaponExplosionAnimation"}}</span><input type="text" name="{{../path}}.volley.explosionAnimationKey" value="{{explosionAnimationKey}}"></label>
          <label><span>{{localize "FALLOUTMAW.Item.WeaponExplosionSound"}}</span><input type="text" name="{{../path}}.volley.explosionSoundPath" value="{{explosionSoundPath}}"></label>
        </div>
        {{/if}}
        {{else}}
        <div class="fallout-maw-list-grid three-columns">
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponAttackCone"}}</span>
            <input type="number" name="{{../path}}.{{key}}.attackConeDegrees" value="{{attackConeDegrees}}" {{#unless ../isModuleModifier}}min="0"{{/unless}} step="1">
          </label>
          {{#if isPush}}
          <label><span>{{localize "FALLOUTMAW.Item.WeaponMaxRange"}}</span><input type="number" name="{{../path}}.push.maxRangeMeters" value="{{maxRangeMeters}}" step="1"></label>
          <label><span>{{localize "FALLOUTMAW.Item.WeaponModeAccuracyModifier"}}</span><input type="number" name="{{../path}}.push.accuracyModifier" value="{{accuracyModifier}}" step="1"></label>
          <label><span>{{localize "FALLOUTMAW.Item.WeaponPushDifficultyModifier"}}</span><input type="number" name="{{../path}}.push.pushDifficultyModifier" value="{{pushDifficultyModifier}}" step="1"></label>
          {{/if}}
          {{#if isBurst}}
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponBurstCount"}}</span>
            <input type="number" name="{{../path}}.burst.count" value="{{burstCount}}" {{#unless ../isModuleModifier}}min="1"{{/unless}} step="1">
          </label>
          <label>
            <span>{{localize "FALLOUTMAW.Item.WeaponBurstDifficultyPerShot"}}</span>
            <input type="number" name="{{../path}}.burst.difficultyPerShot" value="{{burstDifficultyPerShot}}" {{#unless ../isModuleModifier}}min="0"{{/unless}} step="1">
          </label>
          {{/if}}
        </div>
        {{#if isMelee}}
        <div class="fallout-maw-weapon-action-mode-grid">
          <section class="fallout-maw-weapon-action-mode">
            <div class="fallout-maw-weapon-action-mode-header">
              <h4>{{localize "FALLOUTMAW.Item.WeaponAttackModeThrust"}}</h4>
              <div>
                {{#if ../isModuleModifier}}
                <select name="{{../path}}.{{key}}.thrust.enabled">{{#each thrustChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                {{else}}
                <input aria-label="{{localize 'FALLOUTMAW.Effects.Enable'}}" type="checkbox" name="{{../path}}.{{key}}.thrust.enabled" data-weapon-attack-mode-enabled="thrust" {{checked thrust.enabled}}>
                {{/if}}
                <span>{{localize "FALLOUTMAW.Effects.Enable"}}</span>
              </div>
            </div>
            <div class="fallout-maw-list-grid three-columns">
              <label>
                <span>{{localize "FALLOUTMAW.Item.WeaponModeAccuracyModifier"}}</span>
                <input type="number" name="{{../path}}.{{key}}.thrust.accuracyModifier" value="{{thrust.accuracyModifier}}" step="1">
              </label>
              <label>
                <span>{{localize "FALLOUTMAW.Item.WeaponModeCriticalChanceModifier"}}</span>
                <input type="number" name="{{../path}}.{{key}}.thrust.criticalChanceModifier" value="{{thrust.criticalChanceModifier}}" step="1">
              </label>
              <label>
                <span>{{localize "FALLOUTMAW.Item.WeaponModeDamagePercentModifier"}}</span>
                <input type="number" name="{{../path}}.{{key}}.thrust.damagePercentModifier" value="{{thrust.damagePercentModifier}}" step="1">
              </label>
            </div>
          </section>
          <section class="fallout-maw-weapon-action-mode">
            <div class="fallout-maw-weapon-action-mode-header">
              <h4>{{localize "FALLOUTMAW.Item.WeaponAttackModeSwing"}}</h4>
              <div>
                {{#if ../isModuleModifier}}
                <select name="{{../path}}.{{key}}.swing.enabled">{{#each swingChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                {{else}}
                <input aria-label="{{localize 'FALLOUTMAW.Effects.Enable'}}" type="checkbox" name="{{../path}}.{{key}}.swing.enabled" data-weapon-attack-mode-enabled="swing" {{checked swing.enabled}}>
                {{/if}}
                <span>{{localize "FALLOUTMAW.Effects.Enable"}}</span>
              </div>
            </div>
            <div class="fallout-maw-list-grid three-columns">
              <label>
                <span>{{localize "FALLOUTMAW.Item.WeaponModeAccuracyModifier"}}</span>
                <input type="number" name="{{../path}}.{{key}}.swing.accuracyModifier" value="{{swing.accuracyModifier}}" step="1">
              </label>
              <label>
                <span>{{localize "FALLOUTMAW.Item.WeaponModeCriticalChanceModifier"}}</span>
                <input type="number" name="{{../path}}.{{key}}.swing.criticalChanceModifier" value="{{swing.criticalChanceModifier}}" step="1">
              </label>
              <label>
                <span>{{localize "FALLOUTMAW.Item.WeaponModeDamagePercentModifier"}}</span>
                <input type="number" name="{{../path}}.{{key}}.swing.damagePercentModifier" value="{{swing.damagePercentModifier}}" step="1">
              </label>
            </div>
          </section>
        </div>
        {{/if}}
        {{/if}}
        {{#unless isReload}}
        <div class="fallout-maw-panel-header fallout-maw-weapon-action-subheader">
          <h4>{{localize "FALLOUTMAW.Item.WeaponCriticalFailureConsequences"}}</h4>
          <button type="button" data-add-weapon-critical-failure-consequence="{{key}}"><i class="fa-solid fa-plus"></i> {{localize "FALLOUTMAW.Item.WeaponAddCriticalFailureConsequence"}}</button>
        </div>
        {{#if ../isModuleModifier}}
        <label><span>{{localize "FALLOUTMAW.Item.ModuleListMode"}}</span><select name="{{../path}}.{{key}}.criticalFailureConsequencesMode">{{#each criticalFailureConsequencesModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
        {{/if}}
        <div class="fallout-maw-settings-table fallout-maw-weapon-critical-failure-consequences">
          <div class="fallout-maw-settings-row fallout-maw-grid-header">
            <span>{{localize "FALLOUTMAW.Common.Type"}}</span>
            <span>{{localize "FALLOUTMAW.Item.WeaponCriticalFailureResource"}}</span>
            <span>{{localize "FALLOUTMAW.Common.Value"}}</span>
            <span></span>
          </div>
          {{#each criticalFailureConsequences}}
          <div class="fallout-maw-settings-row">
            <input type="hidden" name="{{../../path}}.{{../key}}.criticalFailureConsequences.{{index}}.id" value="{{id}}">
            <select name="{{../../path}}.{{../key}}.criticalFailureConsequences.{{index}}.type">
              {{#each typeChoices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <div class="fallout-maw-stacked-controls">
              <select name="{{../../path}}.{{../key}}.criticalFailureConsequences.{{index}}.resourceType">
                {{#each resourceChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              {{#if isActorResource}}
              <select name="{{../../path}}.{{../key}}.criticalFailureConsequences.{{index}}.resourceKey">
                {{#each actorResourceChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              {{/if}}
            </div>
            <input type="number" name="{{../../path}}.{{../key}}.criticalFailureConsequences.{{index}}.amount" value="{{amount}}" {{#unless ../isModuleModifier}}min="0"{{/unless}} step="1">
            <button type="button" data-weapon-action-key="{{../key}}" data-delete-weapon-critical-failure-consequence="{{index}}" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
          </div>
          {{else}}
          <p class="fallout-maw-empty-list">{{localize "FALLOUTMAW.Item.WeaponNoCriticalFailureConsequences"}}</p>
          {{/each}}
        </div>
        {{/unless}}
      </section>
      {{/if}}
      {{/each}}
    </div>
{{/inline}}
{{#*inline "damageMitigationEditor"}}
<div data-mitigation-function-path="{{path}}">
    <div class="fallout-maw-panel-header">
      <h3>{{localize "FALLOUTMAW.Item.EquipmentRequirements"}}</h3>
      <button type="button" data-add-item-requirement><i class="fa-solid fa-plus"></i> {{localize "FALLOUTMAW.Item.WeaponAddRequirement"}}</button>
    </div>
    <div class="fallout-maw-settings-table fallout-maw-weapon-requirements">
      <div class="fallout-maw-settings-row fallout-maw-grid-header">
        <span>{{localize "FALLOUTMAW.Common.Type"}}</span>
        <span>{{localize "FALLOUTMAW.Item.WeaponRequirementTarget"}}</span>
        <span>{{localize "FALLOUTMAW.Common.Value"}}</span>
        <span></span>
      </div>
      {{#each itemRequirements}}
      <div class="fallout-maw-settings-row">
        <select name="{{../path}}.requirements.{{index}}.type" data-item-requirement-type="{{index}}">
          {{#each typeChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <select name="{{../path}}.requirements.{{index}}.key">
          {{#each keyChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <input type="number" name="{{../path}}.requirements.{{index}}.value" value="{{value}}" min="0" step="1">
        <button type="button" data-delete-item-requirement="{{index}}" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{else}}
      <p class="fallout-maw-empty-list">{{localize "FALLOUTMAW.Item.WeaponNoRequirements"}}</p>
      {{/each}}
    </div>
    <div class="fallout-maw-mitigation-controls">
      <label>
        <span>{{localize "FALLOUTMAW.Item.MitigationMode"}}</span>
        <select name="{{path}}.mode">
          {{#each damageMitigationModeChoices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "FALLOUTMAW.Item.MitigationWearResistance"}}</span>
        <input type="number" name="{{path}}.wearResistance" value="{{data.wearResistance}}" min="0" step="1">
      </label>
      {{#if showDamageMitigationLimbSetSelector}}
      <label>
        <span>{{localize "FALLOUTMAW.Item.MitigationLimbSet"}}</span>
        <select data-mitigation-limb-set-select>
          {{#each damageMitigationLimbSetEditorChoices}}
          <option value="{{id}}" {{#if active}}selected{{/if}}>{{limbsShortLabel}}</option>
          {{/each}}
        </select>
      </label>
      {{/if}}
    </div>
    {{#unless damageMitigationUsesConstructPart}}
    <div class="fallout-maw-hidden-controls">
      {{#each damageMitigationLimbSetChoices}}
      <input type="hidden" name="{{../path}}.limbSetIds.{{@index}}" value="{{id}}">
      {{/each}}
    </div>
    {{/unless}}
    <div class="fallout-maw-mitigation-table-list">
      {{#each damageMitigationTables}}
      <section class="fallout-maw-mitigation-table">
        <h3>{{limbSetLabel}}</h3>
        <div class="fallout-maw-mitigation-matrix" style="--fallout-maw-mitigation-columns: {{columns}};">
          <div class="fallout-maw-mitigation-cell fallout-maw-grid-header"></div>
          {{#each limbs}}
          <div class="fallout-maw-mitigation-cell fallout-maw-grid-header" title="{{label}}">{{shortLabel}}</div>
          {{/each}}
          {{#each rows}}
          <div class="fallout-maw-mitigation-cell fallout-maw-mitigation-damage-type" title="{{damageTypeLabel}}">
            <span class="{{damageTypeIconClass}}" style="{{damageTypeIconStyle}}">
              <img src="{{damageTypeImg}}" alt="{{damageTypeLabel}}">
            </span>
          </div>
          {{#each cells}}
          <label class="fallout-maw-mitigation-cell" data-mitigation-cell data-mitigation-group="{{../../../path}}:{{../../id}}" data-mitigation-row="{{rowIndex}}" data-mitigation-column="{{columnIndex}}">
            <input class="mitigation-value-{{valueClass}}" type="number" name="{{../../../path}}.entries.{{limbKey}}.{{damageTypeKey}}.value" value="{{value}}" step="1">
            <button type="button" class="fallout-maw-mitigation-fill-handle" data-mitigation-fill-handle title="{{localize 'FALLOUTMAW.Item.FillMitigationValues'}}" aria-label="{{localize 'FALLOUTMAW.Item.FillMitigationValues'}}"><i class="fa-solid fa-grip"></i></button>
          </label>
          {{/each}}
          {{/each}}
        </div>
      </section>
      {{/each}}
    </div>
</div>
{{/inline}}
{{#*inline "functionModuleSlots"}}
<div data-module-function-path="{{path}}">
    <div class="fallout-maw-panel-header">
      <h3>{{localize "FALLOUTMAW.Item.WeaponModuleSlots"}}</h3>
      <button type="button" data-add-weapon-module-slot><i class="fa-solid fa-plus"></i> {{localize "FALLOUTMAW.Item.WeaponAddModuleSlot"}}</button>
    </div>
    <div class="fallout-maw-weapon-module-pending-list">
      {{#each moduleSlots}}
      {{#unless moduleKey}}
      <div class="fallout-maw-weapon-module-slot-pending">
        <select data-weapon-module-slot-key-select="{{index}}">
          {{#each choices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <button type="button" data-delete-weapon-module-slot="{{index}}" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/unless}}
      {{/each}}
    </div>
    <div class="fallout-maw-weapon-module-slots">
      {{#each moduleSlots}}
      {{#if moduleKey}}
      <div class="fallout-maw-weapon-module-slot-card">
        <div class="fallout-maw-weapon-module-drop {{#unless item}}empty{{/unless}}" data-weapon-module-slot-drop="{{index}}" {{#if item}}title="{{item.name}}"{{/if}}>
          {{#if item}}
          <img src="{{item.img}}" alt="">
          {{else}}
          <i class="fa-solid fa-plus" aria-hidden="true"></i>
          {{/if}}
        </div>
        <strong class="fallout-maw-weapon-module-slot-label">{{moduleKey}}</strong>
        <button type="button" class="fallout-maw-weapon-module-slot-delete" data-delete-weapon-module-slot="{{index}}" title="{{#if item}}{{localize 'FALLOUTMAW.Item.ModuleRemove'}}{{else}}{{localize 'FALLOUTMAW.Item.ModuleSlotDelete'}}{{/if}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/if}}
      {{else}}
      <p class="fallout-maw-empty-list">{{localize "FALLOUTMAW.Item.WeaponModuleNoSlots"}}</p>
      {{/each}}
    </div>
</div>
{{/inline}}
<div class="fallout-maw-sheet-body">
<header class="sheet-header fallout-maw-sheet-header">
  <img class="profile-img" src="{{item.img}}" {{#unless isTrauma}}data-action="editImage" data-edit="img"{{/unless}} title="{{item.name}}" height="80">
  <div class="fallout-maw-header-fields">
    {{#if isTrauma}}
    <h1 class="fallout-maw-title-display">{{item.name}}</h1>
    <div class="fallout-maw-header-grid">
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Reaction.DepthFilters.damageScope.Options.limb'}}</span>
        <input type="text" value="{{system.limbLabel}}" disabled>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Reaction.DepthFilters.damageType.Label'}}</span>
        <input type="text" value="{{system.damageTypeLabel}}" disabled>
      </label>
    </div>
    {{else if isDisease}}
    <h1 class="fallout-maw-title-display">{{item.name}}</h1>
    <div class="fallout-maw-header-grid">
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Reaction.DepthFilters.need.Label'}}</span>
        <input type="text" value="{{system.needLabel}}" disabled>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.Actor.Level'}}</span>
        <input type="number" value="{{system.level}}" disabled>
      </label>
    </div>
    {{else}}
    <input class="fallout-maw-title-input" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'DOCUMENT.FIELDS.name.label'}}">
    {{#if isGear}}
    <div class="fallout-maw-header-grid fallout-maw-equipped-header-grid">
      <div class="fallout-maw-inline-checkbox fallout-maw-equipped-control">
        <span>{{localize "FALLOUTMAW.Item.Equipped"}}</span>
        <input type="checkbox" name="system.equipped" aria-label="{{localize 'FALLOUTMAW.Item.Equipped'}}" {{checked system.equipped}}>
      </div>
      <div class="fallout-maw-inline-checkbox fallout-maw-equipped-control">
        <span>{{localize "FALLOUTMAW.Common.Locked"}}</span>
