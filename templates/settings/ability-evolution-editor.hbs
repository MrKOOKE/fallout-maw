<div class="fallout-maw-evolution-editor-layout">
  <header class="fallout-maw-evolution-toolbar">
    <div>
      <strong>{{rootAbility.name}}</strong>
      <span>{{nodes.length}} {{localize 'FALLOUTMAW.AuditTemplates.Text2079714a4c38'}}</span>
    </div>
    <div class="fallout-maw-inline-controls">
      <button type="button" data-action="addEvolutionNode"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text331e9dee6d20'}}</button>
      <button type="button" data-action="editEvolutionNode" {{#unless canEditSelected}}disabled{{/unless}}><i class="fa-solid fa-pen"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textb813eeabe338'}}</button>
      <button type="button" data-action="deleteEvolutionNode" {{#unless canDeleteSelected}}disabled{{/unless}}><i class="fa-solid fa-trash"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text52cde6ed4443'}}</button>
      <button type="button" data-action="resetEvolutionView" title="{{localize 'FALLOUTMAW.AuditTemplates.Textb305d8f2fab5'}}"><i class="fa-solid fa-crosshairs"></i></button>
      <span class="fallout-maw-evolution-zoom" data-evolution-zoom-label>{{viewport.zoom}}%</span>
    </div>
  </header>

  <div class="fallout-maw-evolution-workspace">
    <div class="fallout-maw-evolution-viewport" data-evolution-viewport>
      <div class="fallout-maw-evolution-stage" data-evolution-stage>
        <svg class="fallout-maw-evolution-links" aria-hidden="true">
          {{#each links}}
          <path d="{{path}}" data-evolution-link-id="{{id}}"></path>
          {{/each}}
        </svg>
        {{#each nodes}}
        <button type="button"
                class="fallout-maw-evolution-node{{#if isRoot}} root{{/if}}{{#if selected}} selected{{/if}}"
                style="left: {{x}}px; top: {{y}}px;"
                data-action="selectEvolutionNode"
                data-evolution-node
                data-node-id="{{id}}">
          <img src="{{ability.img}}" alt="" draggable="false">
          <span>
            <strong>{{ability.name}}</strong>
            {{#if isRoot}}<small>{{localize 'FALLOUTMAW.AuditTemplates.Text602e979b8e35'}}</small>{{else}}<small>{{childCount}} {{localize 'FALLOUTMAW.AuditTemplates.Textc58a477d8b85'}}</small>{{/if}}
          </span>
        </button>
        {{/each}}
      </div>
      <div class="fallout-maw-evolution-help">{{localize 'FALLOUTMAW.AuditTemplates.Text67dbe505f978'}}</div>
    </div>

  </div>
</div>
