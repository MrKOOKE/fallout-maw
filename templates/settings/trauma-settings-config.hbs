<div class="fallout-maw-config-body fallout-maw-trauma-config-body">
  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div>
        <h2>{{localize 'FALLOUTMAW.Common.Limbs'}}</h2>
        <p class="fallout-maw-help-text">{{localize 'FALLOUTMAW.AuditTemplates.Textb0cc17210ca1'}}</p>
      </div>
      <div class="fallout-maw-button-row">
        <button type="button" data-action="migratePresetSettings"><i class="fa-solid fa-code-compare"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textd65ee7f569f9'}}</button>
      </div>
    </header>

    <div class="fallout-maw-trauma-limb-summary-list">
      {{#each limbs}}
      <div class="fallout-maw-trauma-limb-summary-row" data-trauma-limb="{{key}}">
        <div class="fallout-maw-trauma-limb-summary-name">
          <strong>{{label}}</strong>
          <span>{{key}}</span>
        </div>
        <button type="button" data-action="openLimb"><i class="fa-solid fa-bone"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text8960ddc30e73'}}</button>
      </div>
      {{else}}
      <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Textde2396e3c934'}}</p>
      {{/each}}
    </div>
  </section>
</div>
