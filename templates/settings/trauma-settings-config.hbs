<div class="fallout-maw-config-body fallout-maw-trauma-config-body">
  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div>
        <h2>Конечности</h2>
        <p class="fallout-maw-help-text">Для каждого уникального ключа конечности используется одна общая настройка травм.</p>
      </div>
      <div class="fallout-maw-button-row">
        <button type="button" data-action="migratePresetSettings"><i class="fa-solid fa-code-compare"></i> Мигрировать из других пресетов</button>
      </div>
    </header>

    <div class="fallout-maw-trauma-limb-summary-list">
      {{#each limbs}}
      <div class="fallout-maw-trauma-limb-summary-row" data-trauma-limb="{{key}}">
        <div class="fallout-maw-trauma-limb-summary-name">
          <strong>{{label}}</strong>
          <span>{{key}}</span>
        </div>
        <button type="button" data-action="openLimb"><i class="fa-solid fa-bone"></i> Настроить</button>
      </div>
      {{else}}
      <p class="fallout-maw-empty-list">В настройках рас нет конечностей.</p>
      {{/each}}
    </div>
  </section>
</div>
