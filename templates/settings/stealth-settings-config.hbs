<div class="fallout-maw-config-body">
  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <h2>{{localize 'FALLOUTMAW.AuditSystem.Text065'}}</h2>
      <div class="fallout-maw-button-row">
        <button type="button" data-action="migratePresetSettings"><i class="fa-solid fa-code-compare"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textd65ee7f569f9'}}</button>
      </div>
    </header>

    <div class="fallout-maw-settings-grid">
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textb3538b864fdf'}}</span>
        <select name="difficulty.skillKey">
          {{#each difficultySkillChoices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <div>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text018cae930c44'}}</span>
        <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text018cae930c44'}}" type="checkbox" name="autoDetection.enabled" {{#if settings.autoDetection.enabled}}checked{{/if}}>
      </div>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text0c2341890f7f'}}</span>
        <input type="text" name="autoDetection.movementThresholdFormula" value="{{settings.autoDetection.movementThresholdFormula}}" data-formula-autocomplete="all">
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel" data-stealth-attack-bonuses>
    <header class="fallout-maw-panel-header">
      <h2>{{localize "FALLOUTMAW.Settings.Stealth.AttackBonusesTitle"}}</h2>
    </header>
    <p class="hint">{{localize "FALLOUTMAW.Settings.Stealth.AttackBonusesHint"}}</p>
    <div class="fallout-maw-settings-grid">
      <label>
        <span>{{localize "FALLOUTMAW.Settings.Stealth.AccuracyFormula"}}</span>
        <input type="text" name="attackBonuses.accuracyFormula" value="{{settings.attackBonuses.accuracyFormula}}" data-formula-autocomplete="all">
      </label>
      <label>
        <span>{{localize "FALLOUTMAW.Settings.Stealth.CriticalChanceFormula"}}</span>
        <input type="text" name="attackBonuses.criticalChanceFormula" value="{{settings.attackBonuses.criticalChanceFormula}}" data-formula-autocomplete="all">
      </label>
      <label>
        <span>{{localize "FALLOUTMAW.Settings.Stealth.DamagePercentFormula"}}</span>
        <input type="text" name="attackBonuses.damagePercentFormula" value="{{settings.attackBonuses.damagePercentFormula}}" data-formula-autocomplete="all">
      </label>
      <label>
        <span>{{localize "FALLOUTMAW.Settings.Stealth.CriticalDamagePercentFormula"}}</span>
        <input type="text" name="attackBonuses.criticalDamagePercentFormula" value="{{settings.attackBonuses.criticalDamagePercentFormula}}" data-formula-autocomplete="all">
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <h2>{{localize 'FALLOUTMAW.AuditTemplates.Textcf33de2b0f1f'}}</h2>
    </header>
    <div class="fallout-maw-settings-grid">
      <label>
        <span>{{localize 'FALLOUTMAW.Common.Skill'}}</span>
        <select name="detection.skillKey">
          {{#each detectionSkillChoices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textbd9390a81d56'}}</span>
        <input type="text" name="detection.rangeFormula" value="{{settings.detection.rangeFormula}}" data-formula-autocomplete="all">
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <h2>{{localize 'FALLOUTMAW.AuditTemplates.Texte46e59c4bd17'}}</h2>
      <div class="fallout-maw-button-row">
        <button type="button" data-action="addAttenuationLevel"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.Tile.AddSpecialProperty'}}</button>
      </div>
    </header>
    <div class="fallout-maw-settings-table fallout-maw-stealth-settings-table">
      <div class="fallout-maw-settings-row fallout-maw-grid-header">
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textbac1dc6cbfde'}}</span>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text35bce22f2a3a'}}</span>
        <span></span>
      </div>
      {{#each attenuationLevels}}
      <div class="fallout-maw-settings-row">
        <input type="number" name="attenuationLevels.{{index}}.threshold" value="{{threshold}}" min="0" max="1" step="0.01">
        <input type="number" name="attenuationLevels.{{index}}.penaltyPercent" value="{{penaltyPercent}}" min="0" max="100" step="1">
        <button class="fallout-maw-icon-button" type="button" data-action="removeAttenuationLevel" data-index="{{index}}" title="{{localize 'FALLOUTMAW.Common.Delete'}}" aria-label="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/each}}
    </div>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <h2>{{localize 'FALLOUTMAW.AuditTemplates.Text62a92af3ac3d'}}</h2>
      <div class="fallout-maw-button-row">
        <button type="button" data-action="addDifficultyLevel"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.Tile.AddSpecialProperty'}}</button>
      </div>
    </header>
    <div class="fallout-maw-settings-table fallout-maw-stealth-settings-table fallout-maw-stealth-difficulty-settings-table">
      <div class="fallout-maw-settings-row fallout-maw-grid-header">
        <span>{{localize 'FALLOUTMAW.Common.Label'}}</span>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textbac1dc6cbfde'}}</span>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text66f2995732e7'}}</span>
        <span></span>
      </div>
      {{#each difficultyLevels}}
      <div class="fallout-maw-settings-row">
        <input type="text" name="difficultyLevels.{{index}}.label" value="{{label}}">
        <input type="number" name="difficultyLevels.{{index}}.threshold" value="{{threshold}}" min="0" max="1" step="0.01">
        <input type="number" name="difficultyLevels.{{index}}.difficultyBonus" value="{{difficultyBonus}}" step="1">
        <button class="fallout-maw-icon-button" type="button" data-action="removeDifficultyLevel" data-index="{{index}}" title="{{localize 'FALLOUTMAW.Common.Delete'}}" aria-label="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/each}}
    </div>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit"><i class="fa-solid fa-save"></i> {{localize "FALLOUTMAW.Common.SaveChanges"}}</button>
  </footer>
</div>
