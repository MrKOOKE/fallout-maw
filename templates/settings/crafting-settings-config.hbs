<div class="fallout-maw-config-body">
  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div>
        <h2>{{localize 'FALLOUTMAW.AuditTemplates.Textae9f7c749442'}}</h2>
        <p class="hint">{{localize 'FALLOUTMAW.AuditTemplates.Text97ff8a46cf6f'}}</p>
      </div>
      <div class="fallout-maw-button-row">
        <button type="button" data-action="migratePresetSettings"><i class="fa-solid fa-code-compare"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textd65ee7f569f9'}}</button>
      </div>
    </header>

    <div class="fallout-maw-settings-grid fallout-maw-crafting-mode-grid">
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text58e3e5e6a23a'}}</span>
        <select name="craft.mode" data-crafting-mode="craft">
          {{#each craftModeChoices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Groups.repair.Label'}}</span>
        <select name="repair.mode" data-crafting-mode="repair">
          {{#each repairModeChoices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Groups.medicine.Label'}}</span>
        <select name="medicine.mode" data-crafting-mode="medicine">
          {{#each medicineModeChoices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Groups.butchering.Label'}}</span>
        <select name="butchering.mode" data-crafting-mode="butchering">
          {{#each butcheringModeChoices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel" data-crafting-check-options="craft" {{#unless craftSkillChecks}}hidden{{/unless}}>
    <header class="fallout-maw-panel-header">
      <div>
        <h2>{{localize 'FALLOUTMAW.AuditTemplates.Text0dd9539dfce6'}}</h2>
        <p class="hint">{{localize 'FALLOUTMAW.AuditTemplates.Text19bbb554b29b'}}</p>
      </div>
    </header>
    <div class="fallout-maw-settings-grid">
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textfa47bb8aa16e'}}</span>
        <input type="number" name="craft.failureRefundPercent" value="{{settings.craft.failureRefundPercent}}" min="0" max="100" step="1">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text04f5a76c23c6'}}</span>
        <input type="number" name="craft.criticalFailureRefundPercent" value="{{settings.craft.criticalFailureRefundPercent}}" min="0" max="100" step="1">
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel" data-crafting-check-options="repair" {{#unless repairSkillChecks}}hidden{{/unless}}>
    <header class="fallout-maw-panel-header">
      <div>
        <h2>{{localize 'FALLOUTMAW.AuditTemplates.Textaf252dd2e077'}}</h2>
        <p class="hint">{{localize 'FALLOUTMAW.AuditTemplates.Textb81dcf17eeb5'}}</p>
      </div>
    </header>
    <div class="fallout-maw-settings-grid">
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textdfb9ae275eb4'}}</span>
        <input type="number" name="repair.failureToolCostIncreasePercent" value="{{settings.repair.failureToolCostIncreasePercent}}" min="0" max="1000" step="1">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Texta56b05979fec'}}</span>
        <input type="number" name="repair.criticalFailureToolCostIncreasePercent" value="{{settings.repair.criticalFailureToolCostIncreasePercent}}" min="0" max="1000" step="1">
      </label>
    </div>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit"><i class="fa-solid fa-save"></i> {{localize "FALLOUTMAW.Common.SaveChanges"}}</button>
  </footer>
</div>
