<div class="fallout-maw-config-body">
  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <h2>{{localize 'FALLOUTMAW.AuditSystem.Text057'}}</h2>
      <div class="fallout-maw-button-row">
        <button type="button" data-action="migratePresetSettings"><i class="fa-solid fa-code-compare"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textd65ee7f569f9'}}</button>
        <button type="button" data-action="createCategory"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textf775edce0224'}}</button>
      </div>
    </header>

    <div class="fallout-maw-settings-table item-category-settings">
      <div class="fallout-maw-settings-row fallout-maw-grid-header">
        <span></span>
        <span>{{localize "FALLOUTMAW.Common.Label"}}</span>
        <span></span>
      </div>
      {{#each categories}}
      <div class="fallout-maw-settings-row" data-item-category-row>
        <button type="button" class="fallout-maw-drag-handle" data-drag-handle title="{{localize 'FALLOUTMAW.Common.Reorder'}}"><i class="fa-solid fa-grip-lines"></i></button>
        <div class="fallout-maw-item-category-fields">
          <input type="text" data-field="categoryLabel" value="{{label}}">
          <div class="fallout-maw-item-subcategory-list">
            {{#each subcategories}}
            <div class="fallout-maw-item-subcategory-row" data-item-subcategory-row>
              <input type="text" data-field="subcategoryLabel" value="{{label}}">
              <button type="button" data-action="deleteSubcategory" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
            </div>
            {{/each}}
            <button type="button" class="fallout-maw-secondary-button" data-action="createSubcategory"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textcfeb45e0c7ae'}}</button>
          </div>
        </div>
        <button type="button" data-action="deleteCategory" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{else}}
      <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text8b3929be00e9'}}</p>
      {{/each}}
    </div>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit"><i class="fa-solid fa-save"></i> {{localize "FALLOUTMAW.Common.SaveChanges"}}</button>
  </footer>
</div>
