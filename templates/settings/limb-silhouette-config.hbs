<div class="fallout-maw-silhouette-editor">
  <div class="fallout-maw-silhouette-body">
    <aside class="fallout-maw-silhouette-tools" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text6d9c150fd308'}}">
      <button type="button" class="fallout-maw-silhouette-tool command {{#if hasSilhouette}}danger{{/if}}" data-action="chooseImage" title="{{#if hasSilhouette}}{{localize 'FALLOUTMAW.AuditTemplates.Text4b05713b8886'}}{{else}}{{localize 'FALLOUTMAW.AuditTemplates.Text47a39353960c'}}{{/if}}">
        <i class="fa-solid {{#if hasSilhouette}}fa-trash{{else}}fa-image{{/if}}"></i>
        <span>{{#if hasSilhouette}}{{localize 'FALLOUTMAW.Common.Delete'}}{{else}}{{localize 'FALLOUTMAW.AuditTemplates.Textf909c7e10ef6'}}{{/if}}</span>
      </button>

      <div class="fallout-maw-silhouette-tool-group">
        {{#each tools}}
        <button type="button" class="fallout-maw-silhouette-tool {{#if active}}active{{/if}}" data-action="setTool" data-tool="{{key}}" title="{{label}}">
          <i class="fa-solid {{icon}}"></i>
          <span>{{label}}</span>
        </button>
        {{/each}}
      </div>

      <div class="fallout-maw-silhouette-tool-group">
        <button type="button" class="fallout-maw-silhouette-tool command" data-action="undo" {{#unless canUndo}}disabled{{/unless}} title="{{localize 'FALLOUTMAW.AuditTemplates.Text555ad1c0c33d'}}">
          <i class="fa-solid fa-rotate-left"></i>
          <span>{{localize 'FALLOUTMAW.AuditTemplates.Textf6dab074d7bb'}}</span>
        </button>
        <button type="button" class="fallout-maw-silhouette-tool command" data-action="clearSilhouette" {{#unless canClearSilhouette}}disabled{{/unless}} title="{{localize 'FALLOUTMAW.AuditTemplates.Text9cffc97c95a8'}}">
          <i class="fa-solid fa-xmark"></i>
          <span>{{localize 'FALLOUTMAW.AuditTemplates.Text98b2073ed181'}}</span>
        </button>
      </div>
    </aside>

    <div class="fallout-maw-silhouette-stage">
      {{#if hasSilhouette}}
      <svg class="fallout-maw-silhouette-svg" viewBox="{{viewBox}}" data-action="addPoint" data-silhouette-svg>
        <defs>
          <mask id="{{brushMaskId}}" maskUnits="userSpaceOnUse" maskContentUnits="userSpaceOnUse" x="0" y="0" width="{{imageWidth}}" height="{{imageHeight}}">
            <rect x="0" y="0" width="{{imageWidth}}" height="{{imageHeight}}" fill="white"></rect>
            <polyline data-silhouette-eraser-mask-path points="" fill="none" stroke="black" stroke-linecap="round" stroke-linejoin="round"></polyline>
          </mask>
        </defs>
        {{#if sourceImage}}
        <image class="fallout-maw-silhouette-source-image" href="{{sourceImage}}" x="0" y="0" width="{{imageWidth}}" height="{{imageHeight}}"></image>
        {{/if}}
        <g data-silhouette-remaining-layer>
          {{#each remaining}}
          <path class="fallout-maw-silhouette-remaining" d="{{d}}" fill="{{fill}}"></path>
          {{/each}}
        </g>
        <g data-silhouette-parts-layer>
          {{#each parts}}
          <path class="fallout-maw-silhouette-part" d="{{d}}" fill="{{fill}}" data-limb-key="{{limbKey}}" {{#if mask}}mask="{{mask}}"{{/if}}>
            <title>{{label}}</title>
          </path>
          {{/each}}
        </g>
        {{#each outline}}
        <path class="fallout-maw-silhouette-outline" d="{{d}}"></path>
        {{/each}}
        {{#if draftPoints}}
        <polyline class="fallout-maw-silhouette-draft-line" points="{{draftPoints}}"></polyline>
        {{/if}}
        <polyline class="fallout-maw-silhouette-gesture-preview" points="" data-silhouette-gesture-preview></polyline>
        <polygon class="fallout-maw-silhouette-preview" points="{{previewPoints}}" data-silhouette-preview></polygon>
        <circle class="fallout-maw-silhouette-brush-cursor" cx="0" cy="0" r="{{brushRadius}}" data-silhouette-brush-cursor></circle>
        {{#each draftPointMarkers}}
        <circle class="fallout-maw-silhouette-draft-point" cx="{{x}}" cy="{{y}}" r="3"></circle>
        {{/each}}
      </svg>
      {{else}}
      <div class="fallout-maw-silhouette-empty">
        <i class="fa-solid fa-image"></i>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text779c9ed28cee'}}</span>
      </div>
      {{/if}}
    </div>

    <aside class="fallout-maw-silhouette-side">
      <div class="fallout-maw-silhouette-side-title">{{localize 'FALLOUTMAW.Item.FirstAidLimbs'}}</div>
      <div class="fallout-maw-silhouette-limb-list">
        {{#each limbs}}
        <button type="button" class="fallout-maw-silhouette-limb {{#if active}}active{{/if}}" data-action="selectLimb" data-limb-key="{{key}}">
          <span class="fallout-maw-silhouette-limb-swatch" style="background: {{color}}"></span>
          <span>{{label}}</span>
          <strong>{{areaPercent}}%</strong>
        </button>
        {{else}}
        <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Texteeacd7d526a2'}}</p>
        {{/each}}
      </div>
      <p class="hint">{{localize 'FALLOUTMAW.AuditTemplates.Textb462d4a9f285'}} {{unassignedPercent}}%.</p>
    </aside>
  </div>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="save" {{#unless canSave}}disabled{{/unless}}><i class="fa-solid fa-save"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text4864057d626a'}}</button>
    <button type="button" data-action="close"><i class="fa-solid fa-xmark"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text4ae50d30739d'}}</button>
  </footer>
</div>
