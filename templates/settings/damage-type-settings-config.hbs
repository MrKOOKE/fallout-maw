<div class="fallout-maw-config-body">
  <section class="fallout-maw-panel" hidden>
    <header class="fallout-maw-panel-header">
      <h2>{{damageType.label}}</h2>
      <p class="hint">{{damageType.key}}</p>
    </header>

    <div class="fallout-maw-list-grid two-columns" hidden>
      <label hidden>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text82564a304999'}}</span>
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div class="fallout-maw-section-toggle">
        <input aria-label="{{localize 'FALLOUTMAW.Item.ProsthesisBleedingEffect'}}" type="checkbox" name="settings.bleeding.enabled" {{checked settings.bleeding.enabled}}>
        <span>{{localize 'FALLOUTMAW.Item.ProsthesisBleedingEffect'}}</span>
      </div>
    </header>
    <div class="fallout-maw-list-grid two-columns">
      <label>
        <span>{{localize 'FALLOUTMAW.Effects.Name'}}</span>
        <input type="text" name="settings.bleeding.effectName" value="{{settings.bleeding.effectName}}">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textcb72800fd14b'}}</span>
        <file-picker type="image" name="settings.bleeding.img" value="{{settings.bleeding.img}}"></file-picker>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text3ad337a2f8c2'}}</span>
        <input type="number" name="settings.bleeding.percent" value="{{settings.bleeding.percent}}" min="0" max="100" step="1">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text9ef751e1d4d4'}}</span>
        <input type="number" name="settings.bleeding.durationSeconds" value="{{settings.bleeding.durationSeconds}}" min="1" step="1">
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div class="fallout-maw-section-toggle">
        <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text47529292b136'}}" type="checkbox" name="settings.equipmentConditionDamage.enabled" {{checked settings.equipmentConditionDamage.enabled}}>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text47529292b136'}}</span>
      </div>
    </header>
    <label>
      <span>{{localize 'FALLOUTMAW.AuditTemplates.Text1c0b6fe71f73'}}</span>
      <input type="text" name="settings.equipmentConditionDamage.formula" value="{{settings.equipmentConditionDamage.formula}}">
    </label>
    <p class="hint">{{localize 'FALLOUTMAW.AuditTemplates.Text910f4ab33a36'}}</p>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div class="fallout-maw-section-toggle">
        <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Texta6c12d6f7df9'}}" type="checkbox" name="settings.needIncrease.enabled" {{checked settings.needIncrease.enabled}}>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Texta6c12d6f7df9'}}</span>
      </div>
    </header>
    <div class="fallout-maw-list-grid two-columns">
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Reaction.DepthFilters.need.Label'}}</span>
        <select name="settings.needIncrease.needKey">
          {{#each needOptions}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text67931d740bd0'}}</span>
        <input type="number" name="settings.needIncrease.percent" value="{{settings.needIncrease.percent}}" min="0" step="1">
      </label>
      <div class="fallout-maw-inline-checkbox">
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text4172f841f5d1'}}</span>
        <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text4172f841f5d1'}}" type="checkbox" name="settings.needIncrease.preventHealthDamage" {{checked settings.needIncrease.preventHealthDamage}}>
      </div>
    </div>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div class="fallout-maw-section-toggle">
        <input aria-label="{{localize 'TYPES.RegionBehavior.fallout-maw.periodicDamage'}}" type="checkbox" name="settings.periodic.enabled" {{checked settings.periodic.enabled}}>
        <span>{{localize 'TYPES.RegionBehavior.fallout-maw.periodicDamage'}}</span>
      </div>
    </header>
    <div class="fallout-maw-list-grid two-columns">
      <label>
        <span>{{localize 'FALLOUTMAW.Effects.Name'}}</span>
        <input type="text" name="settings.periodic.effectName" value="{{settings.periodic.effectName}}">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textcb72800fd14b'}}</span>
        <file-picker type="image" name="settings.periodic.img" value="{{settings.periodic.img}}"></file-picker>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text93fba23f7219'}}</span>
        <input type="number" name="settings.periodic.immediatePercent" value="{{settings.periodic.immediatePercent}}" min="0" max="100" step="1">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textac9ef51c9a65'}}</span>
        <input type="number" name="settings.periodic.delayedPercent" value="{{settings.periodic.delayedPercent}}" min="0" max="100" step="1">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textbeb766cc6769'}}</span>
        <input type="number" name="settings.periodic.tickCount" value="{{settings.periodic.tickCount}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text68e8803ccf89'}}</span>
        <input type="number" name="settings.periodic.intervalSeconds" value="{{settings.periodic.intervalSeconds}}" min="1" step="1">
      </label>
    </div>
  </section>

  <section class="fallout-maw-panel">
    <header class="fallout-maw-panel-header">
      <div class="fallout-maw-section-toggle">
        <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text2173ae668b91'}}" type="checkbox" name="settings.resourceLimit.enabled" {{checked settings.resourceLimit.enabled}}>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text2173ae668b91'}}</span>
      </div>
      <button type="button" data-action="addResourceLimit"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text47b5ccf71f29'}}</button>
    </header>
    <div class="fallout-maw-list-grid two-columns">
      <label>
        <span>{{localize 'FALLOUTMAW.Effects.Name'}}</span>
        <input type="text" name="settings.resourceLimit.effectName" value="{{settings.resourceLimit.effectName}}">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textcb72800fd14b'}}</span>
        <file-picker type="image" name="settings.resourceLimit.img" value="{{settings.resourceLimit.img}}"></file-picker>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Texta7df1c71c4a6'}}</span>
        <input type="color" name="settings.resourceLimit.color" value="{{settings.resourceLimit.color}}">
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text9ef751e1d4d4'}}</span>
        <input type="number" name="settings.resourceLimit.durationSeconds" value="{{settings.resourceLimit.durationSeconds}}" min="1" step="1">
      </label>
    </div>

    <div class="fallout-maw-resource-limit-list">
      {{#each resourceLimitRows}}
      <div class="fallout-maw-settings-row fallout-maw-resource-limit-row" data-resource-limit-row>
        <select name="settings.resourceLimit.resources.{{@index}}.resourceKey">
          {{#each options}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <label>
          <span>{{localize 'FALLOUTMAW.AuditTemplates.Textedba8464deb5'}}</span>
          <input type="number" name="settings.resourceLimit.resources.{{@index}}.percent" value="{{percent}}" min="0" step="1">
        </label>
        <button type="button" class="fallout-maw-icon-button" data-action="deleteResourceLimit" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text201e42ee5e62'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{/each}}
    </div>
  </section>

  <footer class="sheet-footer flexrow">
    <button type="submit"><i class="fa-solid fa-save"></i> {{localize "FALLOUTMAW.Common.SaveChanges"}}</button>
  </footer>
</div>
