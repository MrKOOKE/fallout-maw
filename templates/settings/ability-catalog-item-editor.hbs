            <label><span>{{localize "FALLOUTMAW.Ability.Actions.EventSkillFailureControl"}}</span><select data-field="action.skillFailureControl">{{#each skillFailureControlChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
