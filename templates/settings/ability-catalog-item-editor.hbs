<div class="fallout-maw-sheet-body">
<header class="sheet-header fallout-maw-sheet-header">
  <input type="hidden" data-field="img" value="{{ability.img}}">
  <img class="profile-img" src="{{ability.img}}" data-action="editAbilityImage" title="{{ability.name}}" height="80" width="80">
  <div class="fallout-maw-header-fields">
    <input class="fallout-maw-title-input" data-field="name" type="text" value="{{ability.name}}" placeholder="{{localize 'DOCUMENT.FIELDS.name.label'}}">
  </div>
</header>

<nav class="sheet-tabs tabs fallout-maw-item-tabs" data-group="primary">
  <a class="item {{tabs.details.cssClass}}" data-action="selectTab" data-group="{{tabs.details.group}}" data-tab="{{tabs.details.id}}">{{localize 'FALLOUTMAW.Item.DetailsTab'}}</a>
  <a class="item {{tabs.functions.cssClass}}" data-action="selectTab" data-group="{{tabs.functions.group}}" data-tab="{{tabs.functions.id}}">{{localize 'FALLOUTMAW.Item.FunctionsTab'}}</a>
</nav>

{{#if isDetailsTab}}
<section class="tab {{tabs.details.cssClass}}" data-group="{{tabs.details.group}}" data-tab="{{tabs.details.id}}">
  <section class="fallout-maw-panel fallout-maw-ability-category-panel">
    <label class="fallout-maw-ability-category-field">
      <span>{{localize "FALLOUTMAW.Ability.Category.Label"}}</span>
      <input type="text" data-field="category" value="{{system.category}}" placeholder="{{localize "FALLOUTMAW.Ability.Category.Placeholder"}}">
    </label>
  </section>

  <section class="fallout-maw-panel">
    <div class="fallout-maw-panel-header">
      <h2>{{localize 'FALLOUTMAW.AuditTemplates.Text08489afc3ad0'}}</h2>
      <button type="button" data-action="addAcquisitionRequirement"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text3167c32814a0'}}</button>
    </div>
    <div class="fallout-maw-acquisition-requirements" data-acquisition-requirements>
      {{#each acquisitionRequirements}}
      <div class="fallout-maw-ability-condition-row{{#if isPending}} empty{{else}} configured{{/if}}" data-acquisition-requirement-row data-requirement-id="{{id}}">
        {{#if isPending}}
        <label>
          <span>{{localize 'FALLOUTMAW.Item.TrapDetectionCondition'}}</span>
          <select data-field="acquisitionRequirementType">
            {{#each typeChoices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
        </label>
        <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteAcquisitionRequirement" title="{{localize 'FALLOUTMAW.AuditTemplates.Texte1d9a652fecc'}}"><i class="fa-solid fa-trash"></i></button>
        {{else}}
        <input type="hidden" data-field="acquisitionRequirementType" value="{{type}}">
        <div class="fallout-maw-ability-condition-card">
          <div class="fallout-maw-ability-condition-card-header">
            <h4>{{typeLabel}}</h4>
            <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteAcquisitionRequirement" title="{{localize 'FALLOUTMAW.AuditTemplates.Texte1d9a652fecc'}}"><i class="fa-solid fa-trash"></i></button>
          </div>
          <div class="fallout-maw-ability-condition-fields">
            {{#if isRace}}
            <label>
              <span>{{localize 'FALLOUTMAW.Actor.Race'}}</span>
              <select data-field="acquisitionRequirementRaceId">
                {{#each raceChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </label>
            {{/if}}
            {{#if isCharacteristic}}
            <label>
              <span>{{localize 'FALLOUTMAW.Item.WeaponRequirementCharacteristic'}}</span>
              <select data-field="acquisitionRequirementCharacteristicKey">
                {{#each characteristicChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label>
              <span>{{localize 'FALLOUTMAW.AuditTemplates.Text54ddf3d43e27'}}</span>
              <input type="number" data-field="acquisitionRequirementValue" value="{{value}}" min="0" step="1">
            </label>
            {{/if}}
            {{#if isSkill}}
            <label>
              <span>{{localize 'FALLOUTMAW.Common.Skill'}}</span>
              <select data-field="acquisitionRequirementSkillKey">
                {{#each skillChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </label>
            <label>
              <span>{{localize 'FALLOUTMAW.AuditTemplates.Text54ddf3d43e27'}}</span>
              <input type="number" data-field="acquisitionRequirementValue" value="{{value}}" min="0" step="1">
            </label>
            {{/if}}
            {{#if isAbility}}
            <label>
              <span>{{localize 'FALLOUTMAW.Item.MitigationMode'}}</span>
              <select data-field="acquisitionRequirementMode">
                {{#each modeChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </label>
            <div class="fallout-maw-acquisition-ability-controls" data-acquisition-ability-controls>
              <div class="fallout-maw-acquisition-ability-dropzone" data-acquisition-ability-dropzone>
                <i class="fa-solid fa-arrow-down"></i>
                <span>{{localize 'FALLOUTMAW.AuditTemplates.Text69756aff0848'}}</span>
              </div>
              <button type="button" data-action="openAcquisitionAbilityPicker"><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.Tile.AddSpecialProperty'}}</button>
              <div class="fallout-maw-acquisition-ability-list">
                {{#each abilityEntries}}
                <div class="fallout-maw-acquisition-ability-chip" data-acquisition-requirement-ability-id="{{id}}">
                  <input type="hidden" data-field="acquisitionRequirementAbilityId" value="{{id}}">
                  <img src="{{img}}" alt="">
                  <strong>{{name}}</strong>
                  <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="removeAcquisitionRequirementAbility" title="{{localize 'FALLOUTMAW.AuditTemplates.Textfea46e16e44c'}}"><i class="fa-solid fa-trash"></i></button>
                </div>
                {{else}}
                <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Texta6335889e0f8'}}</p>
                {{/each}}
              </div>
            </div>
            {{/if}}
          </div>
        </div>
        {{/if}}
      </div>
      {{else}}
      <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text862fe00ef622'}}</p>
      {{/each}}
    </div>
  </section>
  {{#unless isFeature}}
  <section class="fallout-maw-panel">
    <h2>{{localize 'FALLOUTMAW.AuditTemplates.Textfdf846076a7a'}}</h2>
    <div class="fallout-maw-list-grid two-columns">
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textc2cccf0dbfc9'}}</span>
        <input type="number" data-field="cost" value="{{system.cost}}" min="0" step="1">
      </label>
      <div class="fallout-maw-inline-checkbox">
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text751ebaeaab7a'}}</span>
        <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text751ebaeaab7a'}}" type="checkbox" data-field="onlyFree" {{checked onlyFree}}>
      </div>
      <div class="fallout-maw-inline-checkbox">
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textbba35584046a'}}</span>
        <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Textbba35584046a'}}" type="checkbox" data-field="onlyManual" {{checked onlyManual}}>
      </div>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textab531d9e4ea8'}}</span>
        <select data-field="researchSkillKey">
          {{#each researchSkillChoices}}
          <option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text721948b5d7ac'}}</span>
        <input type="number" data-field="researchDifficulty" value="{{researchDifficulty}}" min="0" step="1">
      </label>
    </div>
  </section>
  {{/unless}}

  <section class="fallout-maw-panel fallout-maw-evolution-settings-panel">
    <div class="fallout-maw-panel-header">
      <div>
        <h2>{{localize 'FALLOUTMAW.AuditTemplates.Textb9c0e1fc2e54'}}</h2>
        <p class="fallout-maw-form-hint">{{localize 'FALLOUTMAW.AuditTemplates.Textf239aebe0920'}} {{evolutionNodeCount}}{{localize 'FALLOUTMAW.AuditTemplates.Text2f2cce8ce3bb'}}</p>
      </div>
      <button type="button" data-action="openEvolutionEditor"><i class="fa-solid fa-diagram-project"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text65b477e2ef5d'}}</button>
    </div>
  </section>

  {{#if showEvolutionSummary}}
  <section class="fallout-maw-panel fallout-maw-description-panel">
    <h2>{{localize 'FALLOUTMAW.Effects.Changes'}}</h2>
    <p class="fallout-maw-form-hint">{{localize 'FALLOUTMAW.AuditTemplates.Textcecdc39afafa'}}</p>
    <prose-mirror data-field="evolutionSummary" value="{{ability.evolutionSummary}}" class="sized" compact>
      {{{evolutionSummaryHTML}}}
    </prose-mirror>
  </section>
  {{/if}}

  <section class="fallout-maw-panel fallout-maw-description-panel">
    <h2>{{localize 'FALLOUTMAW.Common.Description'}}</h2>
    <prose-mirror data-field="description" value="{{ability.description}}" class="sized" compact>
      {{{descriptionHTML}}}
    </prose-mirror>
  </section>
</section>
{{/if}}

{{#if isFunctionsTab}}
<section class="tab {{tabs.functions.cssClass}}" data-group="{{tabs.functions.group}}" data-tab="{{tabs.functions.id}}">
  <section class="fallout-maw-panel">
    <div class="fallout-maw-panel-header">
      <h2>{{localize 'FALLOUTMAW.Item.FunctionsTab'}}</h2>
      <div class="fallout-maw-inline-controls">
        <button type="button" data-action="addFunction" {{#unless canAddFunction}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.Item.AddFunction'}}</button>
      </div>
    </div>
    {{#if showFunctionPicker}}
    <div class="fallout-maw-function-picker">
      <select data-choose-ability-function>
        {{#each functionChoices}}
        <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    {{/if}}
    {{#if showFixedFunctionPicker}}
    <div class="fallout-maw-function-picker">
      <input type="search" data-fixed-ability-function-search placeholder="{{localize 'FALLOUTMAW.AuditTemplates.Textb6d89c96a388'}}">
      <select data-choose-fixed-ability-function>
        {{#each fixedFunctionChoices}}
        <option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>
    {{/if}}
  </section>

  {{#each functions}}
  <section class="fallout-maw-panel" data-ability-function-row data-function-id="{{id}}" data-function-type="{{type}}">
    <div class="fallout-maw-panel-header">
      <h2>{{typeLabel}}</h2>
      <div class="fallout-maw-inline-controls">
        <button type="button" class="fallout-maw-icon-button" data-action="deleteFunction"><i class="fa-solid fa-trash"></i></button>
      </div>
    </div>

    {{#if isFixed}}
    <input type="hidden" data-field="fixedKey" value="{{fixedKey}}">
    <div class="fallout-maw-inline-checkbox fallout-maw-fixed-function-enabled">
      <span>{{localize 'FALLOUTMAW.AuditTemplates.Textf7c5358f4095'}}</span>
      <input aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Textf7c5358f4095'}}" type="checkbox" data-field="functionEnabled" {{checked enabled}}>
    </div>
    {{#if fixedBloodbathSettings}}
    <div class="fallout-maw-ability-subsection">
      <label class="fallout-maw-field">
        <span>{{localize "FALLOUTMAW.Item.WeaponExplosionAnimation"}}</span>
        <input type="text" data-field="fixed.bloodbath.explosionAnimationKey" value="{{fixedBloodbathSettings.explosionAnimationKey}}">
      </label>
    </div>
    {{/if}}
    {{#if fixedReactiveSettings}}
    <div class="fallout-maw-ability-subsection">
      <h3>{{localize 'FALLOUTMAW.AuditTemplates.Text724770a9d0b9'}}</h3>
      <div class="fallout-maw-fixed-settings">
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.Item.TrapActivation'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text784ec2cc9b33'}}</span>
            <input type="number" data-field="fixed.reactive.energyCost" value="{{fixedReactiveSettings.energyCost}}" min="0" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.Item.Duration'}}</span>
            <div class="fallout-maw-split-number-field-control">
              <input type="number" data-field="fixed.reactive.durationAmount" value="{{fixedReactiveSettings.durationAmount}}" min="1" step="1">
              <select data-field="fixed.reactive.durationUnit">
                {{#each fixedReactiveSettings.durationUnitChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </label>
        </div>
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.AuditTemplates.Text5985ff4b1830'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text150ff45ef2fd'}}</span>
            <input type="number" data-field="fixed.reactive.movementPointsPerActionPoint" value="{{fixedReactiveSettings.movementPointsPerActionPoint}}" min="1" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text410e7bb06332'}}</span>
            <input type="number" data-field="fixed.reactive.actionPointsPerThreshold" value="{{fixedReactiveSettings.actionPointsPerThreshold}}" min="1" step="1">
          </label>
        </div>
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.Ability.TriggerCost.Overload'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text65c6d0b7a88b'}}</span>
            <input type="number" data-field="fixed.reactive.overloadEnergyCost" value="{{fixedReactiveSettings.overloadEnergyCost}}" min="0" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.Item.Duration'}}</span>
            <div class="fallout-maw-split-number-field-control">
              <input type="number" data-field="fixed.reactive.overloadDurationAmount" value="{{fixedReactiveSettings.overloadDurationAmount}}" min="0" step="1">
              <select data-field="fixed.reactive.overloadDurationUnit">
                {{#each fixedReactiveSettings.overloadDurationUnitChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </label>
        </div>
      </div>
    </div>
    {{/if}}
    {{#if fixedDeusSettings}}
    <div class="fallout-maw-ability-subsection">
      <h3>{{localize 'FALLOUTMAW.AuditTemplates.Texteaf83c6a589b'}}</h3>
      <div class="fallout-maw-fixed-settings">
        <label>
          <span>{{localize 'FALLOUTMAW.AuditTemplates.Textd4a4b731c018'}}</span>
          <input type="number" data-field="fixed.damageRequired" value="{{fixedDeusSettings.damageRequired}}" min="1" step="1">
        </label>
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.AuditTemplates.Text1419ff627e1f'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Textcf1676954aaf'}}</span>
            <input type="number" data-field="fixed.insight.skillBonus" value="{{fixedDeusSettings.insight.skillBonus}}" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.Item.Duration'}}</span>
            <div class="fallout-maw-split-number-field-control">
              <input type="number" data-field="fixed.insight.durationAmount" value="{{fixedDeusSettings.insightDurationAmount}}" min="0" step="1">
              <select data-field="fixed.insight.durationUnit">
                {{#each fixedDeusSettings.insightDurationUnitChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </label>
        </div>
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.AuditTemplates.Textc6234f033fe9'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text73f2ad36b755'}}</span>
            <input type="number" data-field="fixed.disintegrate.destroyPercent" value="{{fixedDeusSettings.disintegrate.destroyPercent}}" min="0" max="100" step="1">
          </label>
        </div>
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.AuditTemplates.Text3631f50973ac'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Texta56eacb901ce'}}</span>
            <input type="number" data-field="fixed.luckyFind.valueMin" value="{{fixedDeusSettings.luckyFind.valueMin}}" min="0" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Textb4357caf638e'}}</span>
            <input type="number" data-field="fixed.luckyFind.valueMax" value="{{fixedDeusSettings.luckyFind.valueMax}}" min="0" step="1">
          </label>
        </div>
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.AuditTemplates.Text4d53c14ee50d'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text29f3b29df0d0'}}</span>
            <select data-field="fixed.rescue.restoreMode" data-fixed-rescue-mode>
              {{#each fixedDeusSettings.restoreModeChoices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </label>
          <label data-fixed-rescue-count {{#unless fixedDeusSettings.isRestoreCountMode}}hidden{{/unless}}>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text33fd10aea732'}}</span>
            <input type="number" data-field="fixed.rescue.restoreCount" value="{{fixedDeusSettings.rescue.restoreCount}}" min="1" step="1">
          </label>
        </div>
      </div>
    </div>
    {{/if}}
    {{#if fixedCurseAndBlessingSettings}}
    <div class="fallout-maw-ability-subsection">
      <h3>{{localize 'FALLOUTMAW.AuditTemplates.Text95d62e15fbf9'}}</h3>
      <div class="fallout-maw-fixed-settings">
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.Item.TrapEffect'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text784ec2cc9b33'}}</span>
            <input type="number" data-field="fixed.curse.energyCost" value="{{fixedCurseAndBlessingSettings.energyCost}}" min="0" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Textabfcc7d3560c'}}</span>
            <input type="text" data-field="fixed.curse.triggerFormula" value="{{fixedCurseAndBlessingSettings.triggerFormula}}" data-formula-autocomplete="all">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Textf818a822ba11'}}</span>
            <div class="fallout-maw-split-number-field-control">
              <input type="number" data-field="fixed.curse.durationAmount" value="{{fixedCurseAndBlessingSettings.durationAmount}}" min="0" step="1">
              <select data-field="fixed.curse.durationUnit">
                {{#each fixedCurseAndBlessingSettings.durationUnitChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </label>
        </div>
      </div>
    </div>
    {{/if}}
    {{#if fixedAllOrNothingSettings}}
    <div class="fallout-maw-ability-subsection">
      <h3>{{localize 'FALLOUTMAW.AuditTemplates.Texta732462540b9'}}</h3>
      <div class="fallout-maw-fixed-settings">
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.Item.TrapActivation'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text784ec2cc9b33'}}</span>
            <input type="number" data-field="fixed.allOrNothing.energyCost" value="{{fixedAllOrNothingSettings.energyCost}}" min="0" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text1f84cb6afdf2'}}</span>
            <input type="text" data-field="fixed.allOrNothing.chanceFormula" value="{{fixedAllOrNothingSettings.chanceFormula}}" data-formula-autocomplete="all">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text1f0232bd21e8'}}</span>
            <input type="number" data-field="fixed.allOrNothing.pelletCoveragePercent" value="{{fixedAllOrNothingSettings.pelletCoveragePercent}}" min="0" max="100" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text01b304362ad8'}}</span>
            <input type="number" data-field="fixed.allOrNothing.burstCoveragePercent" value="{{fixedAllOrNothingSettings.burstCoveragePercent}}" min="0" max="100" step="1">
          </label>
        </div>
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.Ability.TriggerCost.Overload'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text65c6d0b7a88b'}}</span>
            <input type="number" data-field="fixed.allOrNothing.overloadEnergyCost" value="{{fixedAllOrNothingSettings.overloadEnergyCost}}" min="0" step="1">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.Item.Duration'}}</span>
            <div class="fallout-maw-split-number-field-control">
              <input type="number" data-field="fixed.allOrNothing.overloadDurationAmount" value="{{fixedAllOrNothingSettings.overloadDurationAmount}}" min="0" step="1">
              <select data-field="fixed.allOrNothing.overloadDurationUnit">
                {{#each fixedAllOrNothingSettings.overloadDurationUnitChoices}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
            </div>
          </label>
        </div>
      </div>
    </div>
    {{/if}}
    {{#if fixedReaperSettings}}
    <div class="fallout-maw-ability-subsection">
      <h3>{{localize 'FALLOUTMAW.AuditTemplates.Texta8d03aa6c641'}}</h3>
      <div class="fallout-maw-fixed-settings">
        <div class="fallout-maw-fixed-settings-row">
          <strong>{{localize 'FALLOUTMAW.AuditTemplates.Text7f221ae2e10d'}}</strong>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text4fd04528888d'}}</span>
            <input type="text" data-field="fixed.reaper.killChanceFormula" value="{{fixedReaperSettings.killChanceFormula}}" data-formula-autocomplete="all">
          </label>
          <label>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Text93bbbb10afa0'}}</span>
            <input type="text" data-field="fixed.reaper.attackChanceFormula" value="{{fixedReaperSettings.attackChanceFormula}}" data-formula-autocomplete="all">
          </label>
        </div>
      </div>
    </div>
    {{/if}}
    {{#if fixedVirtuosoSettings}}
