                <div class="fallout-maw-item-use-category-header">
                  <span>{{localize 'FALLOUTMAW.AuditSystem.Text057'}}</span>
                  <button type="button" data-action="addConditionItemCategory" {{#unless canAddItemCategory}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.Tile.AddSpecialProperty'}}</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each itemCategoryRows}}
                  <div class="fallout-maw-item-use-category-row" data-item-use-category-index="{{index}}">
                    <select data-field="conditionItemCategory">
                      {{#each choices}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionItemCategory" title="{{localize 'FALLOUTMAW.AuditTemplates.Text64378b66f8e3'}}"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}
                  <span class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text44001c59ff99'}}</span>
                  {{/each}}
                </div>
              </div>
              <label>
                <span>{{localize 'FALLOUTMAW.AuditTemplates.Text24881d40ba46'}}</span>
                <input type="number" data-field="conditionRequiredCount" value="{{requiredCount}}" min="1" step="1">
              </label>
              <label class="fallout-maw-split-number-field">
                <span>{{localize 'FALLOUTMAW.Item.Duration'}}</span>
                <div>
                  <input type="number" data-field="conditionDurationAmount" value="{{durationAmount}}" min="0" step="1">
                  <select data-field="conditionDurationUnit">
                    {{#each durationUnitChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </div>
              </label>
              {{/if}}

              {{#if isCooldown}}
              <label>
                <span>{{localize 'FALLOUTMAW.AuditTemplates.Text9ef751e1d4d4'}}</span>
                <input type="number" data-field="conditionDurationSeconds" value="{{durationSeconds}}" min="0" step="1">
              </label>
              {{/if}}

              {{#if isDuration}}
              <div class="fallout-maw-split-number-field-control fallout-maw-condition-duration-control">
                <input type="number" data-field="conditionDurationAmount" value="{{durationAmount}}" min="0" step="1" aria-label="{{localize 'FALLOUTMAW.Item.Duration'}}">
                <select data-field="conditionDurationUnit" aria-label="{{localize 'FALLOUTMAW.Effects.DurationUnit'}}">
                  {{#each durationUnitChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
              {{/if}}

            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}
        {{#if isOrGroup}}
        </div>
        {{/if}}
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if hasPenalties}}
    <div class="fallout-maw-ability-subsection">
      <div class="fallout-maw-panel-header">
        <h3>{{localize 'FALLOUTMAW.AuditTemplates.Textc8a7794f69f8'}}</h3>
        <button type="button" data-action="addFunctionPenalty" {{#unless canAddPenalty}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textd3361f2cba6a'}}</button>
      </div>
      {{#if hasUnsupportedEventReactionPenalties}}
      <p class="fallout-maw-event-reaction-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "FALLOUTMAW.Events.Reaction.UnsupportedPenalties"}}</p>
      {{/if}}
      <div data-ability-penalties>
        {{#each penalties}}
        <div class="fallout-maw-ability-change-card{{#if ../hasUnsupportedEventReactionPenalties}} unsupported{{/if}}" data-ability-penalty-row data-change-id="{{id}}">
          <div class="fallout-maw-trauma-effect-row fallout-maw-grid-header">
            <span>{{localize 'FALLOUTMAW.Common.Key'}}</span>
            <span>{{localize 'FALLOUTMAW.Common.Type'}}</span>
            <span>{{localize 'FALLOUTMAW.Common.Value'}}</span>
            <span>{{localize 'FALLOUTMAW.AuditTemplates.Textb5b6ddbf62af'}}</span>
            <span></span>
          </div>
          <div class="fallout-maw-trauma-effect-row">
            <input type="text" data-field="changeKey" data-effect-key-autocomplete value="{{key}}">
            <select data-field="changeType">
              {{#each typeChoices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <input type="text" data-field="changeValue" value="{{value}}" data-formula-autocomplete="all">
            <input type="number" data-field="changePriority" value="{{priority}}" step="1">
            <button type="button" class="fallout-maw-icon-button" data-action="deleteFunctionPenalty" title="{{localize 'FALLOUTMAW.AuditTemplates.Text32f5f556b7af'}}"><i class="fa-solid fa-trash"></i></button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </section>
  {{else}}
  <section class="fallout-maw-panel">
    <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Textd2e9ece45428'}}</p>
  </section>
  {{/each}}

</section>
{{/if}}

</div>
