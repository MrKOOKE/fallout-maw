                        <input type="number" data-field="triggerCost.overloadDurationAmount" value="{{overloadDurationAmount}}" min="0" step="1" aria-label="{{localize 'FALLOUTMAW.Ability.TriggerCost.OverloadDuration'}}" placeholder="{{localize 'FALLOUTMAW.Ability.TriggerCost.OverloadDuration'}}">
