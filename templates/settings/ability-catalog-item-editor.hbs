                <label>
                  <span>Название пула</span>
                  <input type="text" data-field="conditionAccumulationName" value="{{accumulationSettings.name}}" placeholder="Например: Адаптивное сопротивление">
                </label>
                <label>
                  <span>Число из события</span>
                  <select data-field="conditionAccumulationValueSource">
                    {{#each accumulationSettings.valueSourceChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label>
                  <span>Конвертировать в очки, %</span>
                  <input type="number" data-field="conditionAccumulationPercent" value="{{accumulationSettings.percent}}" min="0" step="0.01">
                </label>
                <label>
                  <span>Разделять очки по</span>
                  <select data-field="conditionAccumulationGroupBy">
                    {{#each accumulationSettings.groupByChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label>
                  <span>Общий максимум, 0 — без ограничения</span>
                  <input type="number" data-field="conditionAccumulationTotalCap" value="{{accumulationSettings.totalCap}}" min="0" step="1">
                </label>
                <label>
                  <span>Максимум одной группы, 0 — без ограничения</span>
                  <input type="number" data-field="conditionAccumulationBucketCap" value="{{accumulationSettings.bucketCap}}" min="0" step="1">
                </label>
                <label>
                  <span>Округление очков</span>
                  <select data-field="conditionAccumulationRounding">
                    {{#each accumulationSettings.roundingChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <label>
                  <span>Таймер эффекта</span>
                  <select data-field="conditionAccumulationDurationPolicy">
                    {{#each accumulationSettings.durationPolicyChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </label>
                <p class="fallout-maw-hint">Это условие создаёт пул очков из подходящих событий. Длительность задаётся отдельным условием «Длительность». Само накопление не меняет ключи — подключите его к нужной строке изменения кнопкой с монетами.</p>
              </div>
              {{/if}}

              {{#if isEventReaction}}
