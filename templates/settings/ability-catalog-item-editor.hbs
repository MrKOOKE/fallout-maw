                  {{/each}}
                </select>
              </label>
              {{#if showLimbChoice}}
              <label>
                <span>Конечность</span>
                <select data-field="conditionLimbKey">
                  {{#each limbChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              {{/if}}
              <label>
                <span>Оператор</span>
                <select data-field="conditionOperator">
                  {{#each healthOperatorChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              <label>
                <span>Процент ОЗ</span>
                <input type="number" data-field="conditionPercent" value="{{percent}}" min="0" max="100" step="1">
              </label>
              {{/if}}

              {{#if isEquipment}}
              <label>
                <span>Слот экипировки</span>
                <select data-field="conditionEquipmentSlotKey">
                  {{#each equipmentSlotChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              <label>
                <span>Оператор</span>
                <select data-field="conditionOperator">
                  {{#each equipmentOperatorChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              {{/if}}

              {{#if isTargetFaction}}
              <div class="fallout-maw-item-use-category-field">
                <div class="fallout-maw-item-use-category-header">
                  <span>Фракции цели</span>
                  <button type="button" data-action="addConditionTargetFaction" {{#unless canAddTargetFaction}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each targetFactionRows}}
                  <div class="fallout-maw-item-use-category-row" data-target-faction-index="{{index}}">
                    <select data-field="conditionTargetFaction">
                      {{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionTargetFaction" title="Удалить фракцию"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}<span class="fallout-maw-empty-list">Фракции не выбраны.</span>{{/each}}
                </div>
              </div>
              {{/if}}

              {{#if isTargetRace}}
              <label><span>Раса цели</span><select data-field="conditionTargetRace">{{#each targetRaceChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{/if}}

              {{#if isTargetType}}
              <label><span>Тип цели</span><select data-field="conditionTargetType">{{#each targetTypeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              {{/if}}

              {{#if isPosture}}
              <label><span>Чье положение</span><select data-field="conditionPostureSubject">{{#each postureSubjectChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <div class="fallout-maw-item-use-category-field">
                <div class="fallout-maw-item-use-category-header">
                  <span>Положения</span>
                  <button type="button" data-action="addConditionPosture" {{#unless canAddPosture}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each postureRows}}
                  <div class="fallout-maw-item-use-category-row" data-posture-index="{{index}}">
                    <select data-field="conditionPosture">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionPosture" title="Удалить положение"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}<span class="fallout-maw-empty-list">Положения не выбраны.</span>{{/each}}
                </div>
              </div>
              {{/if}}

              {{#if isOccupiedCover}}
              <div class="fallout-maw-item-use-category-field">
                <div class="fallout-maw-item-use-category-header">
                  <span>Виды укрытия</span>
                  <button type="button" data-action="addConditionCover" {{#unless canAddCover}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each coverRows}}
                  <div class="fallout-maw-item-use-category-row" data-cover-index="{{index}}">
                    <select data-field="conditionCover">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionCover" title="Удалить укрытие"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}<span class="fallout-maw-empty-list">Укрытия не выбраны.</span>{{/each}}
                </div>
              </div>
              {{/if}}

              {{#if isAttackDistance}}
              <label>
                <span>Режим дистанции</span>
                <select data-field="conditionAttackDistanceMode">
                  {{#each attackDistanceModeChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
              {{#if showAttackDistanceSide}}
              <label>
                <span>Сторона эффективной дистанции</span>
              <select data-field="conditionAttackDistanceSide">
                  {{#each attackDistanceSideChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
              </select>
              </label>
              {{else}}
              <input type="hidden" data-field="conditionAttackDistanceSide" value="{{attackDistanceSide}}">
              {{/if}}
              {{#if showAttackDistanceFree}}
              <label>
                <span>От, м</span>
                <input type="number" data-field="conditionAttackDistanceMinMeters" value="{{attackDistanceMinMeters}}" min="0" step="any" placeholder="0">
              </label>
              <label>
                <span>До, м</span>
              <input type="number" data-field="conditionAttackDistanceMaxMeters" value="{{attackDistanceMaxMeters}}" min="0" step="any" placeholder="∞">
              </label>
              {{else}}
              <input type="hidden" data-field="conditionAttackDistanceMinMeters" value="{{attackDistanceMinMeters}}">
              <input type="hidden" data-field="conditionAttackDistanceMaxMeters" value="{{attackDistanceMaxMeters}}">
              {{/if}}
              {{/if}}

              {{#if isWeaponAction}}
              <div class="fallout-maw-item-use-category-field">
                <div class="fallout-maw-item-use-category-header">
                  <span>Типы атаки</span>
                  <button type="button" data-action="addConditionWeaponAction" {{#unless canAddWeaponAction}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each weaponActionRows}}
                  <div class="fallout-maw-item-use-category-row" data-weapon-action-index="{{index}}">
                    <select data-field="conditionWeaponAction">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionWeaponAction" title="Удалить тип атаки"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}<span class="fallout-maw-empty-list">Типы атаки не выбраны.</span>{{/each}}
                </div>
              </div>
              {{/if}}

              {{#if isSkillCondition}}
              <div class="fallout-maw-item-use-category-field">
                <div class="fallout-maw-item-use-category-header">
                  <span>{{skillConditionLabel}}</span>
                  <button type="button" data-action="addConditionWeaponSkill" {{#unless canAddSkill}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each skillRows}}
                  <div class="fallout-maw-item-use-category-row" data-skill-index="{{index}}">
                    <select data-field="conditionSkill">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionWeaponSkill" title="Удалить навык"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}<span class="fallout-maw-empty-list">Навыки не выбраны.</span>{{/each}}
                </div>
              </div>
              {{/if}}

              {{#if isWeaponProficiency}}
              <div class="fallout-maw-item-use-category-field">
                <div class="fallout-maw-item-use-category-header">
                  <span>Задействованные оружейные владения</span>
                  <button type="button" data-action="addConditionWeaponProficiency" {{#unless canAddProficiency}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each proficiencyRows}}
                  <div class="fallout-maw-item-use-category-row" data-proficiency-index="{{index}}">
                    <select data-field="conditionProficiency">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionWeaponProficiency" title="Удалить владение"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}<span class="fallout-maw-empty-list">Владения не выбраны.</span>{{/each}}
                </div>
              </div>
              {{/if}}

              {{#if isTrial}}
              <div class="fallout-maw-ability-action-section fallout-maw-trial-condition">
                <input type="hidden" data-field="conditionTrialRoutesPrimaryChanges" value="{{trialRoutesPrimaryChanges}}">
                <div class="fallout-maw-list-grid three-columns">
                  <label>
                    <span>Кого испытывать</span>
                    <select data-field="conditionTrialSubject">
                      {{#each trialSubjectChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </label>
                  <label>
                    <span>Как выбрать проверку</span>
                    <select data-field="conditionTrialSelectionMode">
                      {{#each trialSelectionModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </label>
                  <label>
                    <span>Сложность</span>
                    <input type="text" data-field="conditionTrialDifficultyFormula" value="{{trialDifficultyFormula}}" data-formula-autocomplete="all">
                  </label>
                </div>
                <div class="fallout-maw-item-use-category-field">
                  <div class="fallout-maw-item-use-category-header">
                    <span>Проверяемые навыки</span>
                    <button type="button" data-action="addConditionTrialEntry"><i class="fa-solid fa-plus"></i> Добавить навык</button>
                  </div>
                  <div class="fallout-maw-item-use-category-list">
                    {{#each trialEntryRows}}
                    <div class="fallout-maw-item-use-category-row" data-trial-entry-row data-trial-entry-id="{{id}}" data-trial-entry-index="{{index}}">
                      <input type="hidden" data-field="conditionTrialEntryKind" value="skill">
                      <select data-field="conditionTrialEntryKey">
                        {{#each skillChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                      </select>
                      <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionTrialEntry" title="Удалить навык"><i class="fa-solid fa-trash"></i></button>
                    </div>
                    {{else}}<span class="fallout-maw-empty-list">Добавьте хотя бы один навык.</span>{{/each}}
                  </div>
                </div>
                <div class="fallout-maw-item-use-category-field">
                  <div class="fallout-maw-item-use-category-header">
                    <span>Ветки результатов</span>
                    <button type="button" data-action="addConditionTrialBranch"><i class="fa-solid fa-plus"></i> Добавить ветку</button>
                  </div>
                  <p class="fallout-maw-hint">Каждый результат относится только к одной ветке. Последствия ветки применяются к участникам, получившим один из отмеченных результатов.</p>
                  <div class="fallout-maw-attack-hit-outcomes">
                    {{#each trialBranchRows}}
                    <details class="fallout-maw-attack-hit-outcome" data-trial-branch-row data-trial-branch-id="{{id}}" data-trial-branch-index="{{index}}" data-sync="ability-trial-branch-{{id}}">
                      <summary><strong>{{name}}</strong><span>{{consequenceCount}} последствий</span></summary>
                      <div class="fallout-maw-attack-hit-outcome-body">
                        <div class="fallout-maw-ability-condition-card-header">
                          <label class="fallout-maw-grow-field"><span>Название ветки</span><input type="text" data-field="conditionTrialBranchName" value="{{name}}"></label>
                          <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionTrialBranch" title="Удалить ветку"><i class="fa-solid fa-trash"></i></button>
                        </div>
                        <div class="fallout-maw-list-grid two-columns">
                          {{#each resultChoices}}
                          <label class="checkbox"><input type="checkbox" data-field="conditionTrialBranchResultKey" value="{{value}}" {{#if checked}}checked{{/if}} {{#if disabled}}disabled{{/if}}><span>{{label}}</span></label>
                          {{/each}}
                        </div>
                        <label>
                          <span>После этой ветки</span>
                          <select data-field="conditionTrialBranchFlow">{{#each flowChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                        </label>
                        <div class="fallout-maw-item-use-category-header">
                          <span>Последствия</span>
                          <button type="button" data-action="addConditionTrialLink"><i class="fa-solid fa-plus"></i> Добавить последствие</button>
                        </div>
                        {{#each links}}
                        <fieldset class="fallout-maw-fieldset fallout-maw-trial-outcome" data-trial-link-row data-trial-link-id="{{id}}" data-trial-link-index="{{index}}">
                          <input type="hidden" data-field="conditionTrialLinkConstructId" value="{{constructId}}">
                          {{#unless isPrimaryChangesPercent}}<input type="hidden" data-field="conditionTrialLinkPercentFormula" value="{{percentFormula}}">{{/unless}}
                          {{#unless usesPrimaryDurationPercent}}<input type="hidden" data-field="conditionTrialLinkDurationPercentFormula" value="{{durationPercentFormula}}">{{/unless}}
                          <div class="fallout-maw-settings-row fallout-maw-trial-link-type-row">
                            <select data-field="conditionTrialLinkType">
                              {{#each typeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                            </select>
                            <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionTrialLink" title="Удалить последствие"><i class="fa-solid fa-trash"></i></button>
                          </div>
                          {{#unless isPending}}
                          <div class="fallout-maw-trial-recipient-row">
                            <label><span>Кому применить</span><select data-field="conditionTrialLinkRecipient">{{#each recipientChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                            <label><span>Кратность</span><select data-field="conditionTrialLinkMode">{{#each modeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                          </div>
                          {{#if isPrimaryChanges}}
                          <p class="fallout-maw-hint">Будут применены основные изменения функции ({{primaryChangeCount}} строк) с длительностью из основной функции.</p>
                          {{/if}}
                          {{#if isPrimaryChangesPercent}}
                          <label><span>Процент основных изменений</span><input type="text" data-field="conditionTrialLinkPercentFormula" value="{{percentFormula}}" data-formula-autocomplete="all"></label>
                          <p class="fallout-maw-hint">Значения основных изменений будут масштабированы по этой формуле.</p>
                          {{/if}}
                          {{#if usesPrimaryDurationPercent}}
                          <label><span>Процент основной длительности</span><input type="text" data-field="conditionTrialLinkDurationPercentFormula" value="{{durationPercentFormula}}" data-formula-autocomplete="all"></label>
                          <p class="fallout-maw-hint">Длительность рассчитывается отдельно от условия «Длительность» основной функции.</p>
                          {{/if}}
                          {{#if isConstruct}}
                          {{#if construct}}
                          {{#with construct}}
                          <div class="fallout-maw-ability-construct" data-ability-construct-row data-construct-id="{{id}}" data-construct-index="{{index}}">
                            <input type="hidden" data-field="constructType" value="{{type}}">
                            <label class="fallout-maw-grow-field"><span>Название последствия</span><input type="text" data-field="constructName" value="{{name}}" placeholder="{{typeLabel}}"></label>
                            {{#if isDamage}}
                            <div class="fallout-maw-list-grid three-columns">
                              <input type="hidden" data-field="constructDamageAmountMode" value="formula">
                              <label><span>Формула урона</span><input type="text" data-field="constructDamageFormula" value="{{damage.formula}}" data-formula-autocomplete="all"></label>
                              <label><span>Тип урона</span><select data-field="constructDamageTypeKey">{{#each damage.damageTypeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                              <label><span>Распределение по телу</span><select data-field="constructDamageLimbMode">{{#each damage.ordinaryLimbModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                            </div>
                            {{/if}}
                            {{#if isTemporaryEffect}}
                            <input type="hidden" data-field="constructDurationSeconds" value="{{durationSeconds}}">
                            {{#unless ../usesPrimaryDurationPercent}}
                            <label class="fallout-maw-construct-duration">
                              <span>Длительность эффекта</span>
                              <span class="fallout-maw-split-number-field">
                                <input type="number" min="0" step="1" value="{{durationAmount}}" data-field="constructDurationAmount">
                                <select data-field="constructDurationUnit">{{#each durationUnitChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                              </span>
                            </label>
                            {{/unless}}
                            <div class="fallout-maw-item-use-category-header"><span>Изменения активного эффекта</span><button type="button" data-action="addAbilityConstructChange"><i class="fa-solid fa-plus"></i> Добавить ключ</button></div>
                            {{#if changes.length}}<div class="fallout-maw-trauma-effect-row fallout-maw-grid-header"><span>Ключ</span><span>Тип</span><span>Значение</span><span>Приоритет</span><span></span></div>{{/if}}
                            {{#each changes}}
                            <div class="fallout-maw-trauma-effect-row" data-ability-construct-change-row data-change-id="{{id}}">
                              <input type="text" data-field="constructChangeKey" value="{{key}}" data-effect-key-autocomplete>
                              <select data-field="constructChangeType">{{#each typeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
                              <input type="text" data-field="constructChangeValue" value="{{value}}" data-formula-autocomplete="all">
                              <input type="number" data-field="constructChangePriority" value="{{priority}}" step="1">
                              <button type="button" class="fallout-maw-icon-button" data-action="deleteAbilityConstructChange" title="Удалить ключ"><i class="fa-solid fa-trash"></i></button>
                            </div>
                            {{else}}<p class="fallout-maw-empty-list">Изменения эффекта не настроены.</p>{{/each}}
                            {{/if}}
                            {{#if isResourceChange}}
                            <div class="fallout-maw-item-use-category-header"><span>Изменения ресурсов</span><button type="button" data-action="addAbilityConstructResource"><i class="fa-solid fa-plus"></i> Добавить ресурс</button></div>
                            {{#each resources}}
                            <div class="fallout-maw-construct-resource-row" data-ability-construct-resource-row data-resource-id="{{id}}">
                              <label><span>Ресурс</span><select data-field="constructResourceKey">{{#each resourceChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                              <label><span>Формула изменения</span><input type="text" data-field="constructResourceFormula" value="{{formula}}" data-formula-autocomplete="all"></label>
                              <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteAbilityConstructResource" title="Удалить ресурс"><i class="fa-solid fa-trash"></i></button>
                            </div>
                            {{else}}<p class="fallout-maw-empty-list">Изменения ресурсов не настроены.</p>{{/each}}
                            {{/if}}
                          </div>
                          {{/with}}
                          {{else}}
                          <p class="fallout-maw-event-reaction-warning"><i class="fa-solid fa-triangle-exclamation"></i> Данные последствия не найдены. Удалите эту строку и создайте последствие заново.</p>
                          {{/if}}
                          {{/if}}
                          {{/unless}}
                        </fieldset>
                        {{else}}<p class="fallout-maw-empty-list">Последствия для этой ветки не настроены.</p>{{/each}}
                      </div>
                    </details>
                    {{else}}<p class="fallout-maw-empty-list">Ветки результатов не настроены.</p>{{/each}}
                  </div>
                </div>
              </div>
              {{/if}}

              {{#if isAura}}
              <div class="fallout-maw-aura-condition">
                <label><span>Режим наложения</span><select data-field="conditionAuraMode">{{#each auraModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                <div class="fallout-maw-item-use-category-field">
                  <div class="fallout-maw-item-use-category-header">
                    <span>{{auraTargetGroupsLabel}}</span>
                    <button type="button" data-action="addConditionAuraTargetGroup" {{#unless canAddAuraTargetGroup}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                  </div>
                  <div class="fallout-maw-item-use-category-list">
                    {{#each auraTargetGroupRows}}
                    <div class="fallout-maw-item-use-category-row" data-aura-target-group-index="{{index}}">
                      <select data-field="conditionAuraTargetGroup">{{#each choices}}<option value="{{value}}" {{#if selected}}selected{{/if}} {{#if disabled}}disabled{{/if}}>{{label}}</option>{{/each}}</select>
                      <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionAuraTargetGroup" title="Удалить группу целей"><i class="fa-solid fa-trash"></i></button>
                    </div>
                    {{else}}<span class="fallout-maw-empty-list">Цели не выбраны.</span>{{/each}}
                  </div>
                </div>
                <div class="fallout-maw-aura-condition-caption">Условия воздействия</div>
                <div class="fallout-maw-aura-condition-fields">
                  <label><span>Радиус, м</span><input type="text" data-field="conditionAuraRadiusMeters" value="{{auraRadiusMeters}}" data-formula-autocomplete="all"></label>
                  <label><span>Требуется актеров для работы</span><input type="text" data-field="conditionRequiredCount" value="{{requiredCount}}" data-formula-autocomplete="all"></label>
                  {{#if showAuraIncludeSelf}}
                  <label><span>Учитывать себя</span><select data-field="conditionAuraIncludeSelf">{{#each auraIncludeSelfChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{/if}}
                  <label><span>Только в бою</span><select data-field="conditionAuraCombatOnly">{{#each auraCombatOnlyChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Блокирование стенами</span><select data-field="conditionAuraWallsBlock">{{#each auraWallsBlockChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Только участники боя</span><select data-field="conditionAuraCombatantsOnly">{{#each auraCombatantsOnlyChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{#unless showAuraTriggerTiming}}
                  <label><span>Игнорировать мертвых и без сознания</span><select data-field="conditionAuraIgnoreIncapacitated">{{#each auraIgnoreIncapacitatedChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{/unless}}
                  {{#if showAuraTriggerTiming}}
                  <label class="checkbox"><input type="checkbox" data-field="conditionAuraAllowUnconscious" {{#if auraAllowUnconscious}}checked{{/if}}><span>Работает при состоянии «Без сознания»</span></label>
                  <label class="checkbox"><input type="checkbox" data-field="conditionAuraAllowDead" {{#if auraAllowDead}}checked{{/if}}><span>Работает при состоянии «Мёртв»</span></label>
                  {{/if}}
                  <label><span>Игнорировать скрытых</span><select data-field="conditionAuraIgnoreHidden">{{#each auraIgnoreHiddenChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  {{#if showAuraTriggerTiming}}
                  <label><span>Сработать при создании ауры</span><select data-field="conditionAuraTriggerOnCreate">{{#each auraTriggerOnCreateChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Сработать при входе цели</span><select data-field="conditionAuraTriggerOnEnter">{{#each auraTriggerOnEnterChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
                  <label><span>Повторять для цели, сек</span><input type="number" data-field="conditionAuraRepeatSeconds" value="{{auraRepeatSeconds}}" min="1" step="1"></label>
                  {{/if}}
                </div>
                {{#if showAuraTriggerTiming}}
                <p class="fallout-maw-hint">Экземпляр активного эффекта является самой аурой. После его удаления проверки и повторения прекращаются.</p>
                {{/if}}
                {{#if showActiveApplicationAuraProjectionHint}}
                <p class="fallout-maw-hint">Созданный активный эффект является источником ауры на выбранной цели. Изменения накладываются отдельными проекциями и исчезают вместе с источником. Задайте длительность больше 0 секунд.</p>
                {{/if}}
              </div>
              {{/if}}

              {{#if isLimitedChanges}}
              <label>
                <span>Количество</span>
                <select data-field="conditionSelectionMode">{{#each changeSelectionModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              </label>
              <label>
                <span>Выбрать изменений</span>
                <input type="text" data-field="conditionLimitFormula" value="{{changeLimitFormula}}" data-formula-autocomplete="all">
                <input type="hidden" data-field="conditionLimitLegacy" value="{{changeLimit}}">
              </label>
              <label>
                <span>Всего изменений</span>
                <input type="number" value="{{changeLimitTotal}}" disabled>
              </label>
              {{/if}}

              {{#if isSelectedChanges}}
              <label>
                <span>Количество</span>
                <select data-field="conditionSelectionMode">{{#each changeSelectionModeChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              </label>
              <label>
                <span>Выбрать изменений</span>
                <input type="text" data-field="conditionLimitFormula" value="{{changeLimitFormula}}" data-formula-autocomplete="all">
                <input type="hidden" data-field="conditionLimitLegacy" value="{{changeLimit}}">
              </label>
              <label>
                <span>Всего изменений</span>
                <input type="number" value="{{changeLimitTotal}}" disabled>
              </label>
              {{/if}}

              {{#if isLimitedEffectCopies}}
              <label>
                <span>Максимум копий</span>
                <input type="text" data-field="conditionLimitFormula" value="{{effectCopyLimitFormula}}" data-formula-autocomplete="all">
                <input type="hidden" data-field="conditionLimitLegacy" value="{{effectCopyLimit}}">
              </label>
              <label class="checkbox">
                <input type="checkbox" data-field="conditionRefresh" {{#if refresh}}checked{{/if}}>
                <span>Обновлять существующий эффект</span>
              </label>
              {{/if}}

              {{#if isLimitedUses}}
              <label>
                <span>Использовано</span>
                <input type="number" data-field="conditionUsesSpent" value="{{usesSpent}}" min="0" step="1">
              </label>
              <label>
                <span>Максимум применений</span>
                <input type="number" data-field="conditionUsesMax" value="{{usesMax}}" min="1" step="1">
              </label>
              {{/if}}

              {{#if isEnergyConsumption}}
              <label>
                <span>Название</span>
                <input type="text" data-field="conditionEnergyConsumptionName" value="{{energyConsumptionName}}">
              </label>
              <label>
                <span>Расход в час</span>
                <input type="number" data-field="conditionAmountPerHour" value="{{amountPerHour}}" min="0" step="0.01">
              </label>
              {{/if}}

              {{#if isItemUse}}
              <div class="fallout-maw-item-use-category-field">
                <div class="fallout-maw-item-use-category-header">
                  <span>Категории предметов</span>
                  <button type="button" data-action="addConditionItemCategory" {{#unless canAddItemCategory}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить</button>
                </div>
                <div class="fallout-maw-item-use-category-list">
                  {{#each itemCategoryRows}}
                  <div class="fallout-maw-item-use-category-row" data-item-use-category-index="{{index}}">
                    <select data-field="conditionItemCategory">
                      {{#each choices}}
                      <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                      {{/each}}
                    </select>
                    <button type="button" class="fallout-maw-icon-button fallout-maw-square-delete-button" data-action="deleteConditionItemCategory" title="Удалить категорию"><i class="fa-solid fa-trash"></i></button>
                  </div>
                  {{else}}
                  <span class="fallout-maw-empty-list">Категории не выбраны.</span>
                  {{/each}}
                </div>
              </div>
              <label>
                <span>Применений</span>
                <input type="number" data-field="conditionRequiredCount" value="{{requiredCount}}" min="1" step="1">
              </label>
              <label class="fallout-maw-split-number-field">
                <span>Длительность</span>
                <div>
                  <input type="number" data-field="conditionDurationAmount" value="{{durationAmount}}" min="0" step="1">
                  <select data-field="conditionDurationUnit">
                    {{#each durationUnitChoices}}
                    <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                    {{/each}}
                  </select>
                </div>
              </label>
              {{/if}}

              {{#if isCooldown}}
              <label>
                <span>Длительность, секунд</span>
                <input type="number" data-field="conditionDurationSeconds" value="{{durationSeconds}}" min="0" step="1">
              </label>
              {{/if}}

              {{#if isDuration}}
              <div class="fallout-maw-split-number-field-control fallout-maw-condition-duration-control">
                <input type="number" data-field="conditionDurationAmount" value="{{durationAmount}}" min="0" step="1" aria-label="Длительность">
                <select data-field="conditionDurationUnit" aria-label="Единицы длительности">
                  {{#each durationUnitChoices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </div>
              {{/if}}

            </div>
          </div>
          {{/if}}
        </div>
        {{/each}}
        {{#if isOrGroup}}
        </div>
        {{/if}}
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#if hasPenalties}}
    <div class="fallout-maw-ability-subsection">
      <div class="fallout-maw-panel-header">
        <h3>Штрафы</h3>
        <button type="button" data-action="addFunctionPenalty" {{#unless canAddPenalty}}disabled{{/unless}}><i class="fa-solid fa-plus"></i> Добавить строку</button>
      </div>
      {{#if hasUnsupportedEventReactionPenalties}}
      <p class="fallout-maw-event-reaction-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "FALLOUTMAW.Events.Reaction.UnsupportedPenalties"}}</p>
      {{/if}}
      <div data-ability-penalties>
        {{#each penalties}}
        <div class="fallout-maw-ability-change-card{{#if ../hasUnsupportedEventReactionPenalties}} unsupported{{/if}}" data-ability-penalty-row data-change-id="{{id}}">
          <div class="fallout-maw-trauma-effect-row fallout-maw-grid-header">
            <span>Ключ</span>
            <span>Тип</span>
            <span>Значение</span>
            <span>Приоритет</span>
            <span></span>
          </div>
          <div class="fallout-maw-trauma-effect-row">
            <input type="text" data-field="changeKey" data-effect-key-autocomplete value="{{key}}">
            <select data-field="changeType">
              {{#each typeChoices}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
            <input type="text" data-field="changeValue" value="{{value}}" data-formula-autocomplete="all">
            <input type="number" data-field="changePriority" value="{{priority}}" step="1">
            <button type="button" class="fallout-maw-icon-button" data-action="deleteFunctionPenalty" title="Удалить строку"><i class="fa-solid fa-trash"></i></button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}
  </section>
  {{else}}
  <section class="fallout-maw-panel">
    <p class="fallout-maw-empty-list">Функции не настроены.</p>
  </section>
  {{/each}}

</section>
{{/if}}

</div>
