<div class="fallout-maw-global-map-form">
  <div class="form-group">
    <label>{{localize 'FALLOUTMAW.AuditTemplates.Text72bf27f1a461'}}</label>
    <div class="form-fields">
      <input type="text" name="speedFormula" value="{{speedFormula}}" data-formula-autocomplete="all" autocomplete="off">
    </div>
    <p class="hint">{{localize 'FALLOUTMAW.AuditTemplates.Text24de567046f7'}} <code>mov</code> {{localize 'FALLOUTMAW.AuditTemplates.Texte0587328f9df'}} <code>{{defaultSpeedFormula}}</code>.</p>
  </div>
  <footer class="form-footer">
    <button type="button" data-action="migratePresetSettings"><i class="fa-solid fa-code-compare"></i> {{localize 'FALLOUTMAW.AuditTemplates.Textd65ee7f569f9'}}</button>
    <button type="submit"><i class="fa-solid fa-floppy-disk"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text4864057d626a'}}</button>
  </footer>
</div>
