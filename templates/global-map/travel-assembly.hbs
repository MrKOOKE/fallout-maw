<div class="fallout-maw-global-map-form fallout-maw-travel-assembly-body">
  {{#if missing}}
  <p class="notification warning">{{localize 'FALLOUTMAW.AuditTemplates.Text55d3f8a1a869'}}</p>
  {{else}}
  <div class="fallout-maw-travel-layout">
    <div class="fallout-maw-travel-vehicles">
      {{#each vehicles}}
      <section class="fallout-maw-travel-vehicle">
        <header class="fallout-maw-travel-vehicle-header">
          <img src="{{img}}" alt="{{name}}">
          <strong>{{name}}</strong>
        </header>

        <div class="fallout-maw-travel-vehicle-content">
          <h2>{{localize 'FALLOUTMAW.AuditTemplates.Textd24d43c042ef'}}</h2>
          {{#each seatGroups}}
          <div class="fallout-maw-travel-seat-group">
            <h3>{{name}}</h3>
            {{#each rows}}
            <div class="fallout-maw-actor-container-row fallout-maw-travel-seat-row">
              {{#each instances}}
            <div
              class="fallout-maw-inventory-grid fallout-maw-actor-container-grid fallout-maw-travel-grid"
              data-travel-drop
              data-drop-kind="vehicle-cell"
              data-vehicle-token-id="{{../../../tokenId}}"
              data-slot-id="{{slotId}}"
              data-slot-index="{{slotIndex}}"
              style="{{style}}"
            >
              {{#each occupants}}
              <article
                class="draggable fallout-maw-inventory-item fallout-maw-inventory-grid-item fallout-maw-actor-container-passenger equipped fallout-maw-travel-grid-occupant"
                data-travel-member-drag
                data-member-id="{{id}}"
                data-can-drag="{{canDrag}}"
                title="{{name}}"
                style="{{gridStyle}}"
              >
                <img src="{{img}}" alt="{{name}}">
              </article>
              {{/each}}
            </div>
              {{/each}}
            </div>
            {{/each}}
          </div>
          {{/each}}
        </div>
      </section>
      {{else}}
      <section class="fallout-maw-travel-empty-panel">{{localize 'FALLOUTMAW.AuditTemplates.Text6fc23641d2e7'}}</section>
      {{/each}}
    </div>

    <aside class="fallout-maw-travel-roster" data-travel-drop data-drop-kind="roster">
      <h2>{{localize 'FALLOUTMAW.Events.Reaction.Roles'}}</h2>
      <div class="fallout-maw-travel-member-list">
        {{#each members}}
        <section
          class="fallout-maw-travel-member {{#if requiresReady}}{{#if ready}}ready{{/if}}{{/if}} {{#if missing}}missing{{/if}}"
          data-travel-member-drag
          data-member-id="{{id}}"
          data-can-drag="{{canDrag}}"
        >
          <img src="{{img}}" alt="{{name}}">
          <strong>{{name}}</strong>
          <div class="fallout-maw-travel-member-actions">
            {{#if canReady}}
            <button
              type="button"
              data-action="toggleReady"
              data-member-id="{{id}}"
              class="fallout-maw-travel-ready-button {{#if ready}}ready{{/if}}"
              title="{{#if ready}}{{localize 'FALLOUTMAW.AuditTemplates.Texta339b08895b5'}}{{else}}{{localize 'FALLOUTMAW.AuditTemplates.Text965b4319f3f5'}}{{/if}}"
              aria-label="{{#if ready}}{{localize 'FALLOUTMAW.AuditTemplates.Texta339b08895b5'}}{{else}}{{localize 'FALLOUTMAW.AuditTemplates.Text965b4319f3f5'}}{{/if}}"
            >
              <i class="fa-solid {{#if ready}}fa-xmark{{else}}fa-check{{/if}}"></i>
            </button>
            {{/if}}
            {{#if canRemove}}
            <button type="button" data-action="removeMember" data-member-id="{{id}}" class="danger" title="{{localize 'FALLOUTMAW.AuditTemplates.Textde37aa82fa32'}}">
              <i class="fa-solid fa-user-minus"></i>
            </button>
            {{/if}}
          </div>
        </section>
        {{/each}}
      </div>
      {{#if canDepart}}
      <button
        type="button"
        class="fallout-maw-travel-depart-button"
        data-action="depart"
        {{#unless readyToDepart}}disabled{{/unless}}
      >
        <i class="fa-solid fa-route"></i>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Textc87b329924c7'}}</span>
      </button>
      {{/if}}
    </aside>
  </div>

  {{/if}}
</div>
