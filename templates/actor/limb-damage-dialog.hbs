<form class="fallout-maw fallout-maw-limb-damage-dialog">
  <section class="fallout-maw-panel">
    <div class="fallout-maw-inline-stat">
      <span>{{limb.label}}</span>
      <strong>{{limb.value}} / {{limb.max}}</strong>
    </div>
    <div class="fallout-maw-list-grid two-columns">
      <label>
        <span>{{localize 'FALLOUTMAW.Item.MitigationMode'}}</span>
        <select name="mode">
          <option value="damage">{{localize 'FALLOUTMAW.REGIONBEHAVIORS.PERIODICDAMAGE.FIELDS.damage.label'}}</option>
          <option value="healing">{{localize 'FALLOUTMAW.Item.FirstAidHealing'}}</option>
        </select>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.Common.Value'}}</span>
        <input type="number" name="amount" value="{{amount}}" min="0" step="1" autofocus>
      </label>
      <label>
        <span>{{localize 'FALLOUTMAW.Events.Reaction.DepthFilters.damageType.Label'}}</span>
        <select name="damageTypeKey">
          {{#each damageTypes}}
          <option value="{{key}}" {{#if (eq key ../defaultDamageTypeKey)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
  </section>
</form>
