<div class="fallout-maw-sheet fallout-maw-medicine-body fallout-maw-repair-body">
  <header class="fallout-maw-dialog-toolbar fallout-maw-repair-toolbar">
    <h2>{{localize 'FALLOUTMAW.AuditTemplates.Text0810bb2e8bb3'}} {{targetActor.name}}</h2>
    <button type="button" class="fallout-maw-dialog-primary-action" data-action="repairAll" {{#unless hasRepairableItems}}disabled{{/unless}}>
      <i class="fa-solid fa-screwdriver-wrench"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text0015ae55af57'}}
    </button>
    <strong>{{toolLabel}}</strong>
  </header>

  <div class="fallout-maw-action-table fallout-maw-action-table--repair">
    <div class="fallout-maw-action-row fallout-maw-action-row--target fallout-maw-action-row--head">
      <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.Common.Label'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.FunctionCondition'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.AuditTemplates.Textdaf8fa0a70a7'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Ability.Actions.EventSkillDifficulty'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Common.Skill'}}</div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Ability.Actions.Type'}}</div>
    </div>
    {{#each items}}
    <div class="fallout-maw-action-row fallout-maw-action-row--target {{#if active}}is-active{{/if}}">
      <div class="fallout-maw-action-cell fallout-maw-action-cell--image">
        <img src="{{img}}" alt="{{name}}" onerror="this.src='{{../fallbackIcon}}'">
      </div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--name">
        <strong>{{name}}</strong>
      </div>
      <div class="fallout-maw-action-cell"><strong>{{conditionLabel}}</strong></div>
      <div class="fallout-maw-action-cell"><strong>{{repairClassLabel}}</strong></div>
      <div class="fallout-maw-action-cell"><strong>{{repairDifficultyLabel}}</strong></div>
      <div class="fallout-maw-action-cell"><strong>{{repairSkillLabel}}</strong></div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--button">
        <button type="button" data-action="startRepair" data-item-id="{{id}}">
          {{#if active}}{{localize 'FALLOUTMAW.AuditTemplates.Text10729118a0e1'}}{{else}}{{localize 'FALLOUTMAW.Events.Groups.repair.Label'}}{{/if}}
        </button>
      </div>
    </div>
    {{#if active}}
    <div class="fallout-maw-action-subtable">
      <div class="fallout-maw-action-row fallout-maw-action-row--tool fallout-maw-action-row--head">
        <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
        <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.Common.Label'}}</div>
        <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.AuditTemplates.Textc6019eacffb5'}}</div>
        <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.FirstAidChatEffectiveness'}}</div>
        <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.EnergySourceReserve'}}</div>
        <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Common.Skill'}}</div>
        <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Ability.Actions.Type'}}</div>
      </div>
      {{#each availableInstruments}}
      <div class="fallout-maw-action-row fallout-maw-action-row--tool {{#unless usable}}is-disabled{{/unless}}">
        <div class="fallout-maw-action-cell fallout-maw-action-cell--image">
          <img src="{{img}}" alt="{{name}}" onerror="this.src='{{../../fallbackIcon}}'">
        </div>
        <div class="fallout-maw-action-cell fallout-maw-action-cell--name">
          <strong>{{name}}</strong>
        </div>
        <div class="fallout-maw-action-cell"><strong>{{toolClass}}</strong></div>
        <div class="fallout-maw-action-cell"><strong>{{efficiencyLabel}}</strong></div>
        <div class="fallout-maw-action-cell"><em>{{supplyValue}} / {{supplyMax}}</em></div>
        <div class="fallout-maw-action-cell"><small>{{skillRequirement}}</small></div>
        <div class="fallout-maw-action-cell fallout-maw-action-cell--button">
          <button type="button" data-action="repairWithInstrument" data-item-id="{{../id}}" data-method-index="{{methodIndex}}" data-instrument-id="{{id}}" {{#unless usable}}disabled{{/unless}}>
            {{localize 'FALLOUTMAW.AuditTemplates.Textfe4b0c80f09e'}}
          </button>
        </div>
      </div>
      {{else}}
      <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text518ebecd2f03'}}</p>
      {{/each}}
    </div>
    {{/if}}
    {{else}}
    <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text70e9060d6593'}}</p>
    {{/each}}
  </div>
</div>
