<div class="fallout-maw-sheet fallout-maw-medicine-body">
  <header class="fallout-maw-dialog-toolbar fallout-maw-medicine-panel-header {{#if tabs.trauma.active}}has-mass-action{{/if}}">
    <div class="fallout-maw-medicine-patient">
      <h2>{{targetActor.name}}</h2>
      <p class="fallout-maw-medicine-subtitle">{{#unless isSelfTreatment}}{{localize 'FALLOUTMAW.AuditTemplates.Text0d84d48ed3d5'}} {{sourceActor.name}} <span aria-hidden="true">·</span> {{/unless}}{{toolLabel}}</p>
    </div>
    {{#if tabs.trauma.active}}
    <div class="fallout-maw-medicine-mass-action">
    <button type="button" class="fallout-maw-dialog-primary-action" data-action="treatAll" {{#unless hasMassTreatments}}disabled{{/unless}}>
      <i class="fa-solid fa-kit-medical"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text49382d0b4164'}}
    </button>
    </div>
    {{/if}}
  </header>

  {{#if medicineCombatStatus}}
  <div class="fallout-maw-medicine-operation-status {{#if medicineCombatStatus.blocked}}is-blocked{{else}}is-available{{/if}}">
    <i class="{{medicineCombatStatus.icon}}" aria-hidden="true"></i>
    <strong>{{medicineCombatStatus.text}}</strong>
  </div>
  {{/if}}
  {{#if emergencyTreatmentStatus}}
  <div class="fallout-maw-medicine-operation-status is-prepared">
    <i class="fa-solid fa-kit-medical" aria-hidden="true"></i>
    <strong>{{emergencyTreatmentStatus.text}}</strong>
  </div>
  {{/if}}

  <nav class="fallout-maw-medicine-tabs" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Texta42c6988b2dd'}}">
    <button type="button" class="{{tabs.trauma.cssClass}}" data-action="setMedicineTab" data-medicine-tab="trauma" aria-pressed="{{tabs.trauma.active}}"><span aria-hidden="true">01</span> {{localize 'FALLOUTMAW.AuditTemplates.Text473ab1df609a'}}</button>
    <button type="button" class="{{tabs.disease.cssClass}}" data-action="setMedicineTab" data-medicine-tab="disease" aria-pressed="{{tabs.disease.active}}"><span aria-hidden="true">02</span> {{localize 'FALLOUTMAW.Common.Diseases'}}</button>
    <button type="button" class="{{tabs.implant.cssClass}}" data-action="setMedicineTab" data-medicine-tab="implant" aria-pressed="{{tabs.implant.active}}"><span aria-hidden="true">03</span> {{localize 'FALLOUTMAW.AuditTemplates.Text93f75dab61e9'}}</button>
    <button type="button" class="{{tabs.prosthesis.cssClass}}" data-action="setMedicineTab" data-medicine-tab="prosthesis" aria-pressed="{{tabs.prosthesis.active}}"><span aria-hidden="true">04</span> {{localize 'FALLOUTMAW.AuditTemplates.Text32e14f8b4d16'}}</button>
  </nav>

  {{#if tabs.trauma.active}}
  <div class="fallout-maw-limb-treatment-list">
    {{#if hasTraumaTreatments}}
    <div class="fallout-maw-action-row fallout-maw-action-row--target fallout-maw-action-row--head fallout-maw-limb-treatment-columns">
      <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.AuditTemplates.Text179cb7f060c3'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.FunctionCondition'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.AuditTemplates.Textc6019eacffb5'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Ability.Actions.EventSkillDifficulty'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Common.Skill'}}</div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Ability.Actions.Type'}}</div>
    </div>
    {{/if}}
    {{#each limbGroups}}
    <section class="fallout-maw-limb-treatment-block" data-limb-key="{{key}}">
      <header class="fallout-maw-limb-treatment-header">
        <h3>{{label}}</h3>
        <span>{{localize 'FALLOUTMAW.AuditTemplates.Text2b9eba706d89'}} <strong>{{value}} / {{max}}</strong></span>
        {{#if hasHealingLimit}}<span>{{localize 'FALLOUTMAW.AuditTemplates.Text3a803c1d8e2c'}} <strong>{{healingCap}}</strong></span>{{/if}}
        {{#if statusLabel}}<small>{{statusLabel}}</small>{{/if}}
      </header>
      <div class="fallout-maw-action-table fallout-maw-action-table--medicine">
        {{> "systems/fallout-maw/templates/actor/parts/medicine-treatment-row.hbs" limbTreatment}}
        {{#each traumas}}
          {{> "systems/fallout-maw/templates/actor/parts/medicine-treatment-row.hbs" this}}
        {{/each}}
      </div>
    </section>
    {{/each}}

    {{#if unassignedTraumas.length}}
    <section class="fallout-maw-limb-treatment-block fallout-maw-limb-treatment-block--unassigned">
      <header class="fallout-maw-limb-treatment-header"><h3>{{localize 'FALLOUTMAW.AuditTemplates.Text56680a9e075c'}}</h3></header>
      <div class="fallout-maw-action-table fallout-maw-action-table--medicine">
        {{#each unassignedTraumas}}
          {{> "systems/fallout-maw/templates/actor/parts/medicine-treatment-row.hbs" this}}
        {{/each}}
      </div>
    </section>
    {{/if}}

    {{#unless hasTraumaTreatments}}
    <div class="fallout-maw-medicine-empty-state">
      <strong><span aria-hidden="true">[ OK ]</span> {{localize 'FALLOUTMAW.AuditTemplates.Text5914e77cb235'}}</strong>
    </div>
    {{/unless}}
  </div>
  {{/if}}

  {{#if tabs.disease.active}}
  <div class="fallout-maw-action-table fallout-maw-action-table--medicine">
    <div class="fallout-maw-action-row fallout-maw-action-row--target fallout-maw-action-row--head">
      <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.Common.Label'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Research.Progress'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.AuditTemplates.Textdaf8fa0a70a7'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Ability.Actions.EventSkillDifficulty'}}</div>
      <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Common.Skill'}}</div>
      <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Ability.Actions.Type'}}</div>
    </div>
    {{#each diseases}}
      {{> "systems/fallout-maw/templates/actor/parts/medicine-treatment-row.hbs" this}}
    {{else}}
    <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Textc762acc72ea6'}}</p>
    {{/each}}
  </div>
  {{/if}}

  {{#if tabs.implant.active}}
  <div class="fallout-maw-prosthesis-medicine fallout-maw-implant-medicine">
    {{#if implants.hasLimbs}}
    <div class="fallout-maw-prosthesis-target">
      {{#if implants.silhouette.visible}}
      <div class="fallout-maw-prosthesis-silhouette fallout-maw-implant-silhouette">
        <svg viewBox="{{implants.silhouette.viewBox}}" role="img" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text93f75dab61e9'}}">
          {{#each implants.silhouette.outline}}
          <path class="fallout-maw-prosthesis-outline" d="{{d}}"></path>
          {{/each}}
          {{#each implants.silhouette.parts}}
          <path
            class="fallout-maw-prosthesis-part {{#if active}}active{{/if}} {{#unless interactive}}inactive{{/unless}}"
            d="{{d}}"
            fill="{{fill}}"
            {{#if interactive}}
            data-action="setImplantLimb"
            data-limb-key="{{limbKey}}"
            {{/if}}
          >
            <title>{{title}}</title>
          </path>
          {{/each}}
        </svg>
      </div>
      {{else}}
      <div class="fallout-maw-prosthesis-limb-list fallout-maw-implant-limb-list">
        {{#each implants.limbs}}
        <button type="button" class="{{cssClass}}" data-action="setImplantLimb" data-limb-key="{{key}}">
          <strong>{{label}}</strong>
          <small>{{statusLabel}}</small>
        </button>
        {{/each}}
      </div>
      {{/if}}

      {{#if implants.activeLimb}}
      <section class="fallout-maw-prosthesis-details fallout-maw-implant-details">
        <header>
          <h3>{{implants.activeLimb.label}}</h3>
          <span>{{implants.activeLimb.statusLabel}}</span>
        </header>

        <div class="fallout-maw-action-table fallout-maw-action-table--prosthesis fallout-maw-action-table--implant">
          <div class="fallout-maw-action-row fallout-maw-action-row--implant-installed fallout-maw-action-row--head">
            <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.AuditTemplates.Text434a5744a758'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.FunctionCondition'}}</div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Item.LightSourceExtract'}}</div>
          </div>
          {{#each implants.activeLimb.implants}}
          <div class="fallout-maw-action-row fallout-maw-action-row--implant-installed">
            <div class="fallout-maw-action-cell fallout-maw-action-cell--image">
              <img src="{{img}}" alt="{{name}}" onerror="this.src='{{../fallbackIcon}}'">
            </div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--name">
              <strong>{{name}}</strong>
            </div>
            <div class="fallout-maw-action-cell"><strong>{{conditionLabel}}</strong></div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--button">
              <button
                type="button"
                class="fallout-maw-icon-action-button"
                title="{{localize 'FALLOUTMAW.Item.LightSourceExtract'}}"
                aria-label="{{localize 'FALLOUTMAW.Item.LightSourceExtract'}}"
                data-action="removeImplant"
                data-limb-key="{{../implants.activeLimb.key}}"
                data-implant-item-id="{{id}}"
                {{#unless @root.medicineOperationsUsable}}disabled{{/unless}}
              >
                <i class="fa-solid fa-eject"></i>
              </button>
            </div>
          </div>
          {{else}}
          <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text0cfe10d2bf07'}}</p>
          {{/each}}
        </div>

        <div class="fallout-maw-action-table fallout-maw-action-table--prosthesis fallout-maw-action-table--implant">
          <div class="fallout-maw-action-row fallout-maw-action-row--implant-candidate fallout-maw-action-row--head">
            <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.Common.Label'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.FunctionCondition'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Common.Skill'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.AuditTemplates.Text906ddead2cb0'}}</div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Item.ImplantInstallation'}}</div>
          </div>
          {{#each implants.activeLimb.candidates}}
          <div class="fallout-maw-action-row fallout-maw-action-row--implant-candidate {{#unless usable}}is-disabled{{/unless}}">
            <div class="fallout-maw-action-cell fallout-maw-action-cell--image">
              <img src="{{img}}" alt="{{name}}" onerror="this.src='{{../fallbackIcon}}'">
            </div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--name">
              <strong>{{name}}</strong>
            </div>
            <div class="fallout-maw-action-cell"><strong>{{conditionLabel}}</strong></div>
            <div class="fallout-maw-action-cell"><strong>{{skillLabel}}</strong></div>
            <div class="fallout-maw-action-cell"><strong>{{difficulty}}</strong></div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--button">
              <button
                type="button"
                class="fallout-maw-icon-action-button"
                title="{{localize 'FALLOUTMAW.TrapPlacement.Place'}}"
                aria-label="{{localize 'FALLOUTMAW.TrapPlacement.Place'}}"
                data-action="installImplant"
                data-limb-key="{{../implants.activeLimb.key}}"
                data-implant-source="{{source}}"
                data-implant-item-id="{{id}}"
                {{#unless usable}}disabled{{/unless}}
              >
                <i class="fa-solid fa-gear"></i>
              </button>
            </div>
          </div>
          {{else}}
          <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text5c70fb1a204b'}}</p>
          {{/each}}
        </div>
      </section>
      {{/if}}
    </div>
    {{else}}
    <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Textbdd71e9c667d'}}</p>
    {{/if}}
  </div>
  {{/if}}

  {{#if tabs.prosthesis.active}}
  <div class="fallout-maw-prosthesis-medicine">
    {{#if prostheses.hasLimbs}}
    <div class="fallout-maw-prosthesis-target">
      {{#if prostheses.silhouette.visible}}
      <div class="fallout-maw-prosthesis-silhouette">
        <svg viewBox="{{prostheses.silhouette.viewBox}}" role="img" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text32e14f8b4d16'}}">
          {{#each prostheses.silhouette.outline}}
          <path class="fallout-maw-prosthesis-outline" d="{{d}}"></path>
          {{/each}}
          {{#each prostheses.silhouette.parts}}
          <path
            class="fallout-maw-prosthesis-part {{#if active}}active{{/if}} {{#unless interactive}}inactive{{/unless}}"
            d="{{d}}"
            fill="{{fill}}"
            {{#if interactive}}
            data-action="setProsthesisLimb"
            data-limb-key="{{limbKey}}"
            {{/if}}
          >
            <title>{{title}}</title>
          </path>
          {{/each}}
        </svg>
      </div>
      {{else}}
      <div class="fallout-maw-prosthesis-limb-list">
        {{#each prostheses.limbs}}
        <button type="button" class="{{cssClass}}" data-action="setProsthesisLimb" data-limb-key="{{key}}">
          <strong>{{label}}</strong>
          <small>{{statusLabel}}</small>
        </button>
        {{/each}}
      </div>
      {{/if}}

      {{#if prostheses.activeLimb}}
      <section class="fallout-maw-prosthesis-details">
        <header>
          <h3>{{prostheses.activeLimb.label}}</h3>
          <span>{{prostheses.activeLimb.statusLabel}}</span>
        </header>
        {{#if prostheses.activeLimb.prosthesis}}
        <div class="fallout-maw-prosthesis-installed">
          <img src="{{prostheses.activeLimb.prosthesis.img}}" alt="{{prostheses.activeLimb.prosthesis.name}}" onerror="this.src='{{fallbackIcon}}'">
          <div>
            <strong>{{prostheses.activeLimb.prosthesis.name}}</strong>
            <small>{{localize 'FALLOUTMAW.AuditTemplates.Text0ae07a918118'}} {{prostheses.activeLimb.conditionLabel}}</small>
            <small>{{localize 'FALLOUTMAW.AuditTemplates.Text70414879110e'}} {{prostheses.activeLimb.prosthesis.integrationPercent}}%</small>
          </div>
          <button
            type="button"
            data-action="removeProsthesis"
            data-limb-key="{{prostheses.activeLimb.key}}"
            data-prosthesis-item-id="{{prostheses.activeLimb.prosthesis.id}}"
            {{#unless medicineOperationsUsable}}disabled{{/unless}}
          >
            {{localize 'FALLOUTMAW.Item.Unequip'}}
          </button>
        </div>
        {{else}}
        <div class="fallout-maw-action-table fallout-maw-action-table--prosthesis">
          <div class="fallout-maw-action-row fallout-maw-action-row--prosthesis fallout-maw-action-row--head">
            <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.Common.Label'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.FunctionCondition'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.ProsthesisIntegration'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Common.Skill'}}</div>
            <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.AuditTemplates.Text906ddead2cb0'}}</div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Ability.Actions.Type'}}</div>
          </div>
          {{#each prostheses.activeLimb.candidates}}
          <div class="fallout-maw-action-row fallout-maw-action-row--prosthesis {{#unless usable}}is-disabled{{/unless}}">
            <div class="fallout-maw-action-cell fallout-maw-action-cell--image">
              <img src="{{img}}" alt="{{name}}" onerror="this.src='{{../fallbackIcon}}'">
            </div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--name">
              <strong>{{name}}</strong>
            </div>
            <div class="fallout-maw-action-cell"><strong>{{conditionLabel}}</strong></div>
            <div class="fallout-maw-action-cell"><strong>{{integrationPercent}}%</strong></div>
            <div class="fallout-maw-action-cell"><strong>{{skillLabel}}</strong></div>
            <div class="fallout-maw-action-cell"><strong>{{difficulty}}</strong></div>
            <div class="fallout-maw-action-cell fallout-maw-action-cell--button">
              <button
                type="button"
                data-action="installProsthesis"
                data-limb-key="{{../prostheses.activeLimb.key}}"
                data-prosthesis-source="{{source}}"
                data-prosthesis-item-id="{{id}}"
                {{#unless usable}}disabled{{/unless}}
              >
                {{localize 'FALLOUTMAW.TrapPlacement.Place'}}
              </button>
            </div>
          </div>
          {{else}}
          <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Textc8ba548cbbdb'}}</p>
          {{/each}}
        </div>
        {{/if}}
      </section>
      {{/if}}
    </div>
    {{else}}
    <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text7fd32184e004'}}</p>
    {{/if}}
  </div>
  {{/if}}
</div>
