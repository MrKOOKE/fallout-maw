<div class="fallout-maw-craft-window-recipe-list fallout-maw-pane-scroll" data-search-scroll-key="craft:recipes">
  {{#each recipeCategories}}
  <section class="fallout-maw-craft-window-recipe-category {{#if uncategorized}}transparent{{/if}} {{#if collapsed}}collapsed{{/if}}{{#if searching}} searching{{/if}}" data-craft-recipe-category="{{key}}">
    {{#unless uncategorized}}
    <div class="fallout-maw-craft-window-recipe-category-header" role="button" tabindex="0" data-craft-recipe-toggle data-craft-recipe-category-toggle="{{key}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
      <i class="fa-solid {{#if collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}"></i>
      <span>{{label}}</span>
      <strong>{{count}}</strong>
    </div>
    {{/unless}}
    <div class="fallout-maw-craft-window-recipe-category-list">
      {{#each subcategories}}
      <section class="fallout-maw-craft-window-recipe-subcategory {{#if transparent}}transparent{{/if}} {{#if collapsed}}collapsed{{/if}}{{#if searching}} searching{{/if}}{{#unless hasRecipes}} empty{{/unless}}{{#if hasClassFolders}} has-class-folders{{/if}}" data-craft-recipe-subcategory="{{key}}">
        {{#unless transparent}}
        <div class="fallout-maw-craft-window-recipe-subcategory-header" role="button" tabindex="0" data-craft-recipe-toggle data-craft-recipe-subcategory-toggle="{{key}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
          <i class="fa-solid {{#if collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}"></i>
          <span title="{{label}}">{{label}}</span>
          <strong>{{count}}</strong>
        </div>
        {{/unless}}
        <div class="fallout-maw-craft-window-recipe-subcategory-list">
          {{#each classFolders}}
          <section class="fallout-maw-craft-window-recipe-class {{#if collapsed}}collapsed{{/if}}{{#if searching}} searching{{/if}}" data-craft-recipe-class="{{itemClass}}">
            <div class="fallout-maw-craft-window-recipe-class-header" role="button" tabindex="0" data-craft-recipe-toggle data-craft-recipe-class-toggle="{{key}}" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
              <i class="fa-solid {{#if collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}"></i>
              <span title="{{label}}">{{label}}</span>
              <strong>{{count}}</strong>
            </div>
            <div class="fallout-maw-craft-window-recipe-class-list">
              {{#each recipes}}
              <article class="fallout-maw-craft-window-recipe {{#if selected}}selected{{/if}} {{#if missing}}missing{{/if}} {{#if unknown}}unknown{{/if}}" {{#if unknown}}aria-disabled="true" aria-label="Неизвестный рецепт"{{else}}role="button" tabindex="0" data-recipe-uuid="{{uuid}}" data-tooltip-uuid="{{itemUuid}}"{{/if}}>
                <img src="{{img}}" alt="{{#unless unknown}}{{displayName}}{{/unless}}">
                <span class="name">{{displayName}}</span>
              </article>
              {{/each}}
            </div>
          </section>
          {{/each}}
          {{#each recipes}}
          <article class="fallout-maw-craft-window-recipe {{#if selected}}selected{{/if}} {{#if missing}}missing{{/if}} {{#if unknown}}unknown{{/if}}" {{#if unknown}}aria-disabled="true" aria-label="Неизвестный рецепт"{{else}}role="button" tabindex="0" data-recipe-uuid="{{uuid}}" data-tooltip-uuid="{{itemUuid}}"{{/if}}>
            <img src="{{img}}" alt="{{#unless unknown}}{{displayName}}{{/unless}}">
            <span class="name">{{displayName}}</span>
          </article>
          {{/each}}
          {{#unless hasRecipes}}
          <p class="fallout-maw-craft-window-recipe-empty">Пусто</p>
          {{/unless}}
        </div>
      </section>
      {{/each}}
    </div>
  </section>
  {{else}}
  <p class="fallout-maw-empty-list">Рецептов нет.</p>
  {{/each}}
</div>
