<section class="fallout-maw-token-hud-meter-section {{#if meterSections.resources.collapsed}}collapsed{{/if}} {{#if meterSections.resources.editable}}editable{{/if}}" data-token-hud-meter-section="resources">
  <div class="fallout-maw-token-hud-meter-title-row">
    <button type="button" class="fallout-maw-token-hud-block-title fallout-maw-token-hud-collapse-toggle" data-action="toggleMeterSection" data-section="resources" data-token-hud-meter-toggle aria-expanded="{{meterSections.resources.expanded}}">
      <i class="fa-solid fa-caret-down" inert></i>
      <span>{{localize 'FALLOUTMAW.Common.Resources'}}</span>
    </button>
    {{#if gmControls}}
    <button type="button" class="fallout-maw-token-hud-meter-edit-lock {{#if meterSections.resources.editable}}unlocked{{/if}}" data-action="toggleMeterEdit" data-section="resources" title="{{localize 'FALLOUTMAW.AuditTemplates.Textab779180318d'}}" aria-pressed="{{meterSections.resources.editable}}">
      <i class="fa-solid {{#if meterSections.resources.editable}}fa-lock-open{{else}}fa-lock{{/if}}" inert></i>
    </button>
    {{/if}}
  </div>
  <div class="fallout-maw-token-hud-collapsible">
    <div class="fallout-maw-token-hud-collapsible-inner fallout-maw-token-hud-meter-list">
      {{#each resources}}
      <div class="fallout-maw-token-hud-meter-card{{#if oneTimeResource}} one-time-resource{{/if}}" data-token-hud-resource-card data-resource-key="{{key}}">
        <div class="fallout-maw-token-hud-meter-header">
          <span>{{label}}</span>
          {{#if hasRecoveryTarget}}<span class="fallout-maw-consciousness-recovery-label">{{localize "FALLOUTMAW.Actor.ConsciousnessRecoveryTarget" value=recoveryTarget}}</span>{{/if}}
          {{#if ../meterSections.resources.editable}}
          <span class="fallout-maw-token-hud-meter-value-editor">
            {{#if oneTimeResource}}
            <input type="number" class="fallout-maw-one-time-resource-input" value="{{onceValue}}" min="0" step="1" data-token-hud-meter-value-input data-section="resources" data-key="{{key}}" data-field="once" data-original-value="{{onceValue}}" aria-label="{{label}}: {{localize 'FALLOUTMAW.AuditTemplates.Text7462b903c641'}}" title="{{localize 'FALLOUTMAW.AuditTemplates.Text7462b903c641'}}">
            <b>+</b>
            {{/if}}
            <input type="number" value="{{value}}" min="{{min}}" max="{{max}}" step="1" data-token-hud-meter-value-input data-section="resources" data-key="{{key}}" data-original-value="{{value}}" aria-label="{{label}}">
            <b>/ {{max}}</b>
          </span>
          {{else}}
          <strong>{{valueLabel}} / {{maxLabel}}</strong>
          {{/if}}
        </div>
        <div class="fallout-maw-resource-meter" style="{{meterStyle}}" role="meter" aria-valuemin="{{min}}" aria-valuenow="{{#if oneTimeResource}}{{meterValue}}{{else}}{{value}}{{/if}}" aria-valuemax="{{#if oneTimeResource}}{{meterMax}}{{else}}{{max}}{{/if}}" data-token-hud-resource-meter data-resource-key="{{key}}" data-resource-min="{{min}}" data-resource-value="{{#if oneTimeResource}}{{meterValue}}{{else}}{{value}}{{/if}}" data-resource-max="{{#if oneTimeResource}}{{meterMax}}{{else}}{{max}}{{/if}}" data-resource-limited="{{blockedAmount}}">
          <span class="fallout-maw-resource-meter-fill" style="{{fillStyle}}"></span>
          {{#if oneTimeResource}}<span class="fallout-maw-resource-meter-once-fill" style="{{oneTimeFillStyle}}" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text7462b903c641'}}"></span>{{/if}}
          {{#if blockedAmount}}<span class="fallout-maw-resource-meter-blocked" style="{{blockedStyle}}" aria-hidden="true"></span>{{/if}}
          {{#if hasRecoveryTarget}}<span class="fallout-maw-consciousness-recovery-marker" style="{{recoveryTargetStyle}}" title="{{localize 'FALLOUTMAW.Actor.ConsciousnessRecoveryTarget' value=recoveryTarget}}" aria-label="{{localize 'FALLOUTMAW.Actor.ConsciousnessRecoveryTarget' value=recoveryTarget}}"></span>{{/if}}
          <span class="fallout-maw-resource-meter-preview" aria-hidden="true"></span>
        </div>
      </div>
      {{/each}}
    </div>
  </div>
</section>
