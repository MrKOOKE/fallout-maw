<div class="fallout-maw-action-row fallout-maw-action-row--target fallout-maw-treatment-row fallout-maw-treatment-row--{{type}} {{#if active}}is-active{{/if}} {{#unless treatable}}is-disabled{{/unless}}" data-treatment-type="{{type}}">
  <div class="fallout-maw-action-cell fallout-maw-action-cell--image">
    <img src="{{img}}" alt="{{name}}" onerror="this.src='{{@root.fallbackIcon}}'">
  </div>
  <div class="fallout-maw-action-cell fallout-maw-action-cell--name">
    <strong>{{name}}</strong>
    {{#each sources}}<small>{{summary}}</small>{{/each}}
    {{#if unavailableReason}}<small class="fallout-maw-treatment-unavailable">{{unavailableReason}}</small>{{/if}}
    {{#unless treatmentSkillThresholdMet}}<small class="fallout-maw-treatment-unavailable">{{treatmentSkillRequirement}}</small>{{/unless}}
  </div>
  <div class="fallout-maw-action-cell"><strong>{{progressValue}} / {{progressMax}}</strong></div>
  <div class="fallout-maw-action-cell fallout-maw-treatment-tool-class {{#if healingToolClassReduced}}is-reduced{{/if}}">
    {{#if healingToolClassReduced}}
    <span class="fallout-maw-treatment-tool-class__original">{{healingToolClassOriginal}}</span>
    <i class="fa-solid fa-arrow-right fallout-maw-treatment-tool-class__arrow" aria-hidden="true"></i>
    <strong class="fallout-maw-treatment-tool-class__effective">{{healingToolClassEffective}}</strong>
    {{else}}
    <strong>{{healingToolClass}}</strong>
    {{/if}}
  </div>
  <div class="fallout-maw-action-cell"><strong>{{healingDifficulty}}</strong></div>
  <div class="fallout-maw-action-cell"><strong>{{healingSkillLabel}}</strong></div>
  <div class="fallout-maw-action-cell fallout-maw-action-cell--button">
    <button type="button" data-action="startTreatment" data-treatment-type="{{type}}" data-treatment-id="{{id}}" {{#unless treatable}}disabled{{/unless}}>
      {{#if active}}{{localize 'FALLOUTMAW.AuditTemplates.Text10729118a0e1'}}{{else}}{{localize 'FALLOUTMAW.Item.FirstAidHealing'}}{{/if}}
    </button>
  </div>
</div>
{{#if active}}
<div class="fallout-maw-action-subtable">
  <p class="fallout-maw-medicine-instrument-heading"><span aria-hidden="true">↳</span> {{localize 'FALLOUTMAW.AuditTemplates.Text34ceb935a1ca'}}</p>
  <div class="fallout-maw-action-row fallout-maw-action-row--tool fallout-maw-action-row--head">
    <div class="fallout-maw-action-cell fallout-maw-action-cell--image">{{localize 'FALLOUTMAW.AuditTemplates.Text23d154f2f1d1'}}</div>
    <div class="fallout-maw-action-cell fallout-maw-action-cell--name">{{localize 'FALLOUTMAW.Common.Label'}}</div>
    <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.AuditTemplates.Textc6019eacffb5'}}</div>
    <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.FirstAidChatEffectiveness'}}</div>
    <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Item.EnergySourceReserve'}}</div>
    <div class="fallout-maw-action-cell">{{localize 'FALLOUTMAW.Common.Skill'}}</div>
    <div class="fallout-maw-action-cell fallout-maw-action-cell--button">{{localize 'FALLOUTMAW.Ability.Actions.Type'}}</div>
  </div>
  {{#each availableInstruments}}
  <div class="fallout-maw-action-row fallout-maw-action-row--tool {{#unless usable}}is-disabled{{/unless}}">
    <div class="fallout-maw-action-cell fallout-maw-action-cell--image">
      <img src="{{img}}" alt="{{name}}" onerror="this.src='{{@root.fallbackIcon}}'">
    </div>
    <div class="fallout-maw-action-cell fallout-maw-action-cell--name">
      <strong>{{name}}</strong>
      {{#if unavailableReason}}<small class="fallout-maw-treatment-unavailable">{{unavailableReason}}</small>{{/if}}
    </div>
    <div class="fallout-maw-action-cell"><strong>{{toolClass}}</strong></div>
    <div class="fallout-maw-action-cell"><strong>{{efficiencyLabel}}</strong></div>
    <div class="fallout-maw-action-cell"><em>{{supplyValue}} / {{supplyMax}}</em></div>
    <div class="fallout-maw-action-cell"><small>{{skillRequirement}}</small></div>
    <div class="fallout-maw-action-cell fallout-maw-action-cell--button">
      <button type="button" data-action="treatWithInstrument" data-treatment-type="{{../type}}" data-treatment-id="{{../id}}" data-instrument-id="{{id}}" {{#unless usable}}disabled{{/unless}}>
        {{localize 'FALLOUTMAW.AuditTemplates.Textfe4b0c80f09e'}}
      </button>
    </div>
  </div>
  {{else}}
  <p class="fallout-maw-empty-list">{{localize 'FALLOUTMAW.AuditTemplates.Text83735c828cdd'}}</p>
  {{/each}}
</div>
{{/if}}
