<section class="construct-visual-editor-body">
  <div class="construct-visual-editor-layout">
    <aside class="construct-visual-preview-panel">
      <header class="construct-visual-preview-heading"><div><h3>Предпросмотр</h3><p class="hint">Собранный токен и точки крепления</p></div><label class="construct-visual-check construct-visual-enabled"><input type="checkbox" data-visual-kind="config" data-visual-key="enabled" {{checked config.enabled}}><span>Включён</span></label></header>
      <div class="construct-visual-preview-frame"><div data-visual-preview style="aspect-ratio:{{previewAspect}}"></div></div>
      {{#if placingAnchor}}<p class="construct-visual-place-hint"><i class="fa-solid fa-crosshairs"></i> Нажмите на токен, чтобы поставить крепление.</p>{{else}}<p class="hint">Во вкладке «Крепления» точки можно перетаскивать по токену.</p>{{/if}}
      <div class="construct-visual-aim-toolbar"><label class="construct-visual-check"><input type="checkbox" data-preview-aim {{checked previewAim}}><span>Прицел по курсору</span></label><button type="button" class="construct-visual-icon-button" data-action="resetVisualAim" title="Вернуть исходный поворот"><i class="fa-solid fa-rotate-left"></i></button></div>
      <select data-preview-slot aria-label="Деталь для проверки прицела"><option value="">Первая вращаемая деталь</option>{{#each previewParts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      <details class="construct-visual-advanced construct-visual-background-settings"><summary>Подложка токена</summary><p class="hint">Необязательное изображение под всеми деталями.</p><div class="construct-visual-image-field"><input type="text" value="{{config.baseImage}}" data-visual-kind="config" data-visual-key="baseImage" placeholder="Без подложки"><button type="button" class="construct-visual-icon-button" data-action="pickVisualImage" data-kind="config" data-key="baseImage" title="Выбрать подложку"><i class="fa-solid fa-folder-open"></i></button></div></details>
      <details class="construct-visual-advanced"><summary>Поворот корпуса</summary><div class="construct-visual-two-columns"><label>Сектор, °<input type="number" value="{{config.hullRotationCost.degrees}}" min="1" max="360" step="1" data-visual-kind="config" data-visual-key="hullRotationCost" data-cost-key="degrees"></label><label>Цена, ОП<input type="number" value="{{config.hullRotationCost.points}}" min="0" step="1" data-visual-kind="config" data-visual-key="hullRotationCost" data-cost-key="points"></label></div><p class="hint">Первая оплата открывает сектор от угла в начале хода. 0 — без расхода. Энергия списывается как при движении.</p></details>
    </aside>
    <div class="construct-visual-settings-panel">
      <nav class="construct-visual-tabs" role="tablist" aria-label="Настройки конструкта">
        <button type="button" role="tab" aria-selected="{{#if partsTab}}true{{else}}false{{/if}}" class="{{#if partsTab}}active{{/if}}" data-action="switchVisualTab" data-tab="parts"><i class="fa-solid fa-layer-group"></i> Сборка <span>{{partCount}}</span></button>
        <button type="button" role="tab" aria-selected="{{#if anchorsTab}}true{{else}}false{{/if}}" class="{{#if anchorsTab}}active{{/if}}" data-action="switchVisualTab" data-tab="anchors"><i class="fa-solid fa-crosshairs"></i> Крепления <span>{{anchorCount}}</span></button>
        <button type="button" role="tab" aria-selected="{{#if seatsTab}}true{{else}}false{{/if}}" class="{{#if seatsTab}}active{{/if}}" data-action="switchVisualTab" data-tab="seats"><i class="fa-solid fa-users"></i> Экипаж <span>{{seatCount}}</span></button>
        <button type="button" role="tab" aria-selected="{{#if interiorTab}}true{{else}}false{{/if}}" class="{{#if interiorTab}}active{{/if}}" data-action="switchVisualTab" data-tab="interior"><i class="fa-solid fa-boxes-stacked"></i> Размещение <span>{{interiorCount}}</span></button>
      </nav>
      <div class="construct-visual-record-layout">
        <aside class="construct-visual-record-list">
          {{#if partsTab}}<button type="button" class="construct-visual-add-button" data-action="addVisualPart"><i class="fa-solid fa-plus"></i> Добавить слой</button>{{#each parts}}<button type="button" class="construct-visual-record {{#if selected}}selected{{/if}}" data-action="selectVisualRecord" data-kind="parts" data-index="{{index}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><img src="{{img}}" alt=""><span><strong>{{label}}</strong><small>{{#if rotates}}Вращается · {{/if}}{{status}}</small></span></button>{{else}}<p class="hint construct-visual-list-empty">Добавьте изображение установленной детали.</p>{{/each}}{{/if}}
          {{#if anchorsTab}}<button type="button" class="construct-visual-add-button" data-action="addVisualAnchor"><i class="fa-solid fa-plus"></i> Добавить точку</button>{{#each anchors}}<button type="button" class="construct-visual-record {{#if selected}}selected{{/if}}" data-action="selectVisualRecord" data-kind="anchors" data-index="{{index}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><i class="fa-solid fa-crosshairs"></i><span><strong>{{name}}</strong><small>{{#if parentSlotId}}Следует за деталью{{else if parentId}}Связана с креплением{{else}}На корпусе{{/if}}</small></span></button>{{else}}<p class="hint construct-visual-list-empty">Создайте точку и поставьте её на токене.</p>{{/each}}{{/if}}
          {{#if seatsTab}}<button type="button" class="construct-visual-add-button" data-action="addCrewSeat"><i class="fa-solid fa-plus"></i> Назначить место</button>{{#each seats}}<button type="button" class="construct-visual-record {{#if selected}}selected{{/if}}" data-action="selectVisualRecord" data-kind="seats" data-index="{{index}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><i class="fa-solid fa-user"></i><span><strong>{{name}}</strong><small>{{roleLabel}}</small></span></button>{{else}}<p class="hint construct-visual-list-empty">Выберите физическое место и назначьте роль.</p>{{/each}}{{/if}}
          {{#if interiorTab}}{{#each interior}}<button type="button" class="construct-visual-record {{#if selected}}selected{{/if}}" data-action="selectVisualRecord" data-kind="interior" data-slot-id="{{slotId}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><i class="fa-solid fa-cube"></i><span><strong>{{label}}</strong><small>{{locationLabel}}</small></span></button>{{else}}<p class="hint construct-visual-list-empty">Добавьте детали в строение конструкта.</p>{{/each}}{{/if}}
        </aside>
        <div class="construct-visual-fields">
          {{#if partsTab}}{{#with selectedPart}}
          <section class="construct-visual-inspector" aria-label="Выбранная деталь">
            <header class="construct-visual-inspector-heading"><h3>Изображение детали</h3><button type="button" class="construct-visual-icon-button danger" data-action="removeVisualPart" data-index="{{index}}" title="Убрать визуальный слой"><i class="fa-solid fa-trash"></i></button></header>
            <label>Деталь конструкта<select data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="slotId">{{#each slots}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <div class="construct-visual-art-picker"><div class="construct-visual-art-thumbnail">{{#if img}}<img src="{{img}}" alt="Изображение выбранной детали">{{else}}<i class="fa-regular fa-image"></i>{{/if}}</div><div><strong>Основное изображение</strong><p class="hint">Показывается, пока деталь исправна.</p><button type="button" data-action="pickVisualImage" data-kind="parts" data-index="{{index}}" data-key="img"><i class="fa-solid fa-folder-open"></i> Выбрать изображение</button></div></div>
            <label>Точка крепления<select data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="anchorId"><option value="">Центр токена</option>{{#each anchors}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label class="construct-visual-check construct-visual-setting-toggle"><input type="checkbox" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="rotates" {{checked rotates}}><span>Вращать при прицеливании</span></label>
            {{#if rotates}}<div class="construct-visual-motion-settings">
              <label>Скорость, °/с<input type="number" value="{{rotationSpeed}}" min="0.1" max="720" step="1" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="rotationSpeed"></label>
              <div class="construct-visual-two-columns"><label>Оплачиваемый сектор, °<input type="number" value="{{rotationCost.degrees}}" min="1" max="360" step="1" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="rotationCost" data-cost-key="degrees"></label><label>Цена, ОП<input type="number" value="{{rotationCost.points}}" min="0" step="1" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="rotationCost" data-cost-key="points"></label></div>
              {{#if rotationSystems}}<details class="construct-visual-advanced"><summary>Требуемые системы</summary>{{#each rotationSystems}}<label class="construct-visual-check"><input type="checkbox" data-visual-kind="parts" data-visual-index="{{../index}}" data-visual-key="rotationSystemIds" data-system-id="{{id}}" {{checked checked}}><span>{{name}}</span></label>{{/each}}<p class="hint">Для вращения все выбранные системы должны работать и иметь энергию. В бою они расходуют её пропорционально цене поворота.</p></details>{{/if}}
              <div class="construct-visual-two-columns"><label>Предел слева, °<input type="number" value="{{minRotation}}" step="1" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="minRotation"></label><label>Предел справа, °<input type="number" value="{{maxRotation}}" step="1" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="maxRotation"></label></div>
              <label>Точка вылета снаряда<select data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="muzzleAnchorId"><option value="">Точка крепления детали</option>{{#each muzzleAnchors}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </div>{{/if}}
            <details class="construct-visual-advanced"><summary>Дополнительно</summary>
              <div class="construct-visual-two-columns"><label>Ширина изображения<input type="number" value="{{width}}" min="0.01" step="0.01" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="width"></label><label>Высота изображения<input type="number" value="{{height}}" min="0.01" step="0.01" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="height"></label></div>
              <div class="construct-visual-two-columns"><label>Центр вращения по X<input type="number" value="{{pivotX}}" min="0" max="1" step="0.01" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="pivotX"></label><label>Центр вращения по Y<input type="number" value="{{pivotY}}" min="0" max="1" step="0.01" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="pivotY"></label></div>
              <div class="construct-visual-two-columns"><label>Исходный угол, °<input type="number" value="{{rotation}}" step="1" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="rotation"></label><label>Порядок наложения<input type="number" value="{{zIndex}}" step="1" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="zIndex"></label></div>
              <p class="hint">Размеры и центр вращения задаются в долях изображения. Выше находятся слои с большим порядком.</p>
              <label>Файл изображения<input type="text" value="{{img}}" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="img"></label>
              <label>Изображение при повреждении</label><div class="construct-visual-image-field"><input type="text" value="{{damagedImg}}" data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="damagedImg" placeholder="Скрывать повреждённую деталь"><button type="button" class="construct-visual-icon-button" data-action="pickVisualImage" data-kind="parts" data-index="{{index}}" data-key="damagedImg" title="Выбрать повреждённое изображение"><i class="fa-solid fa-folder-open"></i></button></div>
              {{#unless rotates}}<label>Точка вылета снаряда<select data-visual-kind="parts" data-visual-index="{{index}}" data-visual-key="muzzleAnchorId"><option value="">Точка крепления детали</option>{{#each muzzleAnchors}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/unless}}
            </details>
          </section>
          {{else}}<div class="construct-visual-empty-state"><i class="fa-solid fa-layer-group"></i><h3>Соберите изображение конструкта</h3><p>Добавьте слой установленной детали и выберите её изображение.</p></div>{{/with}}{{/if}}
          {{#if anchorsTab}}{{#with selectedAnchor}}
          <section class="construct-visual-inspector" aria-label="Выбранное крепление">
            <header class="construct-visual-inspector-heading"><h3>Точка крепления</h3><button type="button" class="construct-visual-icon-button danger" data-action="removeVisualAnchor" data-index="{{index}}" title="Удалить крепление"><i class="fa-solid fa-trash"></i></button></header>
            <label>Название<input type="text" value="{{name}}" data-visual-kind="anchors" data-visual-index="{{index}}" data-visual-key="name" placeholder="Например, погон башни"></label>
            <button type="button" class="construct-visual-placement-button" data-action="placeVisualAnchor" data-index="{{index}}"><i class="fa-solid fa-crosshairs"></i> Поставить на токене</button>
            <p class="hint">Нажмите слева на нужную точку. Для точной настройки перетащите маркер.</p>
            <label>Следовать за деталью<select data-visual-kind="anchors" data-visual-index="{{index}}" data-visual-key="parentSlotId"><option value="">Оставаться на корпусе</option>{{#each parentParts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <label>Связать с другим креплением<select data-visual-kind="anchors" data-visual-index="{{index}}" data-visual-key="parentId"><option value="">Не связывать</option>{{#each parents}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <details class="construct-visual-advanced"><summary>Дополнительно</summary><div class="construct-visual-two-columns"><label>Положение по X<input type="number" value="{{x}}" step="0.01" data-visual-kind="anchors" data-visual-index="{{index}}" data-visual-key="x"></label><label>Положение по Y<input type="number" value="{{y}}" step="0.01" data-visual-kind="anchors" data-visual-index="{{index}}" data-visual-key="y"></label></div><label>Направление крепления, °<input type="number" value="{{rotation}}" step="1" data-visual-kind="anchors" data-visual-index="{{index}}" data-visual-key="rotation"></label><p class="hint">Положение задаётся в долях токена. Для связанного крепления это смещение от родителя.</p></details>
          </section>
          {{else}}<div class="construct-visual-empty-state"><i class="fa-solid fa-crosshairs"></i><h3>Создайте крепление</h3><p>Поставьте точку на изображении, затем присоедините к ней деталь.</p></div>{{/with}}{{/if}}
          {{#if seatsTab}}{{#with selectedSeat}}
          <section class="construct-visual-inspector" aria-label="Выбранное место экипажа">
            <header class="construct-visual-inspector-heading"><h3>Место экипажа</h3><button type="button" class="construct-visual-icon-button danger" data-action="removeCrewSeat" data-index="{{index}}" title="Удалить назначение места"><i class="fa-solid fa-trash"></i></button></header>
            <label>Название места<input type="text" value="{{name}}" data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="name"></label>
            <label>Место в транспорте<select data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="physicalSeat"><option value="">Выберите место</option>{{#each physicalSeats}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            <div class="construct-visual-two-columns"><label>Назначение<select data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="role">{{#each roles}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>Управляемая деталь<select data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="partSlotId"><option value="">Без назначения</option>{{#each parts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div>
            <div class="construct-visual-function-heading">Разрешённые действия</div>
            <div class="construct-visual-crew-functions">{{#each functions}}<label class="construct-visual-check"><input type="checkbox" data-visual-kind="seats" data-visual-index="{{../index}}" data-visual-key="functions" data-function="{{value}}" {{checked checked}}><span>{{label}}</span></label>{{/each}}</div>
            {{#if systems}}<details class="construct-visual-advanced"><summary>Доступные системы</summary>{{#each systems}}<label class="construct-visual-check"><input type="checkbox" data-visual-kind="seats" data-visual-index="{{../index}}" data-visual-key="systemIds" data-system-id="{{id}}" {{checked checked}}><span>{{name}}</span></label>{{/each}}</details>{{/if}}
            <p class="hint">Роль задаёт начальный набор действий. Разрешения можно менять по отдельности: например, оставить заряжающему только перезарядку.</p>
            <section class="construct-visual-personal-settings" aria-label="Личное оружие экипажа">
              <h3>Личное оружие</h3>
              <label class="construct-visual-check"><input type="checkbox" data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="personalWeapons" data-personal-key="enabled" {{checked personalWeapons.enabled}}><span>Разрешить стрельбу своим оружием</span></label>
              {{#if personalWeapons.enabled}}
              <label>Точка стрельбы<select data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="personalWeapons" data-personal-key="anchorId"><option value="">Выберите крепление</option>{{#each personalAnchors}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
              <div class="construct-visual-two-columns"><label>Сектор от, °<input type="number" value="{{personalWeapons.minRotation}}" min="-180" max="180" step="1" data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="personalWeapons" data-personal-key="minRotation"></label><label>Сектор до, °<input type="number" value="{{personalWeapons.maxRotation}}" min="-180" max="180" step="1" data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="personalWeapons" data-personal-key="maxRotation"></label></div>
              <div class="construct-visual-two-columns"><label title="Пусто — дальность оружия. Число задаёт дополнительный предел расстояния от точки стрельбы.">Дальность, м<input type="number" value="{{personalWeapons.maxRangeMeters}}" min="0" step="0.1" placeholder="По оружию" data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="personalWeapons" data-personal-key="maxRangeMeters"></label><label title="0% — открытое окно; 70% — сохраняется 70% штатной защиты корпуса; 100% — полная защита.">Защита корпуса, %<input type="number" value="{{personalWeapons.coverPercent}}" min="0" max="100" step="1" data-visual-kind="seats" data-visual-index="{{index}}" data-visual-key="personalWeapons" data-personal-key="coverPercent"></label></div>
              <p class="hint">0° следует направлению выбранной точки. Сектор поворачивается вместе с ней и корпусом. Пустая дальность сохраняет дальность оружия.</p>
              {{/if}}
            </section>
          </section>
          {{else}}<div class="construct-visual-empty-state"><i class="fa-solid fa-users"></i><h3>Назначьте роли экипажу</h3><p>Добавьте назначение свободного физического места.</p></div>{{/with}}{{/if}}
          {{#if interiorTab}}{{#with selectedInterior}}
          <section class="construct-visual-inspector construct-visual-interior-inspector" aria-label="Физическое размещение детали">
            <header class="construct-visual-inspector-heading"><h3>{{label}}</h3></header>
            <label>Где находится деталь<select data-visual-kind="interior" data-visual-slot-id="{{slotId}}" data-visual-key="parentSlotId"><option value="">Снаружи конструкта</option>{{#each parents}}<option value="{{value}}" {{#if selected}}selected{{/if}}>Внутри: {{label}}</option>{{/each}}</select></label>
            <p class="hint">Наружные детали доступны для прямого попадания. Внутренние защищает выбранный отсек.</p>
            <div class="construct-visual-location-path"><i class="fa-solid fa-boxes-stacked"></i><span>{{pathLabel}}</span></div>
            <dl class="construct-visual-compartment-contents"><dt>Детали внутри</dt><dd>{{#if childrenLabel}}{{childrenLabel}}{{else}}Нет{{/if}}</dd><dt>Персонажи внутри</dt><dd>{{#if occupantsLabel}}{{occupantsLabel}}{{else}}Нет{{/if}}</dd></dl>
            <p class="hint">Здесь доступны все физические детали, включая двигатель и отсеки. Изображения и точки крепления настраиваются в соседних вкладках.</p>
          </section>
          {{else}}<div class="construct-visual-empty-state"><i class="fa-solid fa-boxes-stacked"></i><h3>Добавьте детали конструкта</h3><p>Размещение станет доступно после добавления физической детали.</p></div>{{/with}}{{/if}}
        </div>
      </div>
    </div>
  </div>
  <footer class="form-footer"><span class="hint">Изменения применяются после сохранения.</span><button type="submit"><i class="fa-solid fa-check"></i> Сохранить настройки</button></footer>
</section>

