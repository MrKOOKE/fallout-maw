<section class="fallout-maw-anatomy-study-body fallout-maw-quality-service-body">
  <header class="fallout-maw-anatomy-study-header fallout-maw-maintained-target-header">
    <button type="button" data-action="select" {{#if selectionDisabled}}disabled{{/if}} title="{{selectionDisabledReason}}">
      <i class="fa-solid fa-crosshairs"></i>
      {{localize 'FALLOUTMAW.AuditTemplates.Text588a3e37b4a9'}}
    </button>
  </header>

  <section class="fallout-maw-anatomy-costs">
    <span><i class="fa-solid fa-bolt"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text1ab8fabfa387'}} <strong>{{selectedTier.holdEnergy}} {{localize 'FALLOUTMAW.AuditTemplates.Textefffb67b4012'}}</strong></span>
    <span><i class="fa-solid fa-battery-three-quarters"></i> {{localize 'FALLOUTMAW.AuditTemplates.Text8acb442f5366'}} <strong>{{availableEnergy}} {{localize 'FALLOUTMAW.AuditTemplates.Text3c4db44df13d'}}</strong></span>
  </section>

  <section class="fallout-maw-quality-tier-list" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text5ed64c91aeaa'}}">
    {{#each tiers}}
    <button type="button" class="fallout-maw-quality-tier" data-action="tier" data-tier-id="{{id}}" aria-pressed="{{selected}}">
      <strong>{{localize 'FALLOUTMAW.AuditTemplates.Text017efd4e7b53'}} {{holdEnergy}} {{localize 'FALLOUTMAW.AuditTemplates.Text3c4db44df13d'}}</strong>
      <span>{{summary}}</span>
    </button>
    {{/each}}
  </section>

  {{#if selectionDisabledReason}}
  <section class="fallout-maw-anatomy-memory"><p>{{selectionDisabledReason}}</p></section>
  {{/if}}

  <section class="fallout-maw-anatomy-knowledge">
    <h2>{{localize 'FALLOUTMAW.AuditTemplates.Text20d2a17dc39c'}}</h2>
    {{#if hasHolds}}
      <div class="fallout-maw-maintained-target-list">
      {{#each holds}}
      <div class="fallout-maw-maintained-target-row">
        <img src="{{img}}" alt="{{name}}">
        <strong title="{{name}}">{{name}}</strong>
        <span class="fallout-maw-maintained-target-summary" title="{{summary}}">{{summary}}</span>
        <span class="fallout-maw-maintained-target-energy">{{energy}} <i class="fa-solid fa-bolt"></i></span>
        <button type="button" data-action="release" data-effect-id="{{effectId}}" title="{{localize 'FALLOUTMAW.AuditTemplates.Text23442a231caa'}}">
          <i class="fa-solid fa-link-slash"></i>
        </button>
      </div>
      {{/each}}
      </div>
    {{else}}
      <p class="fallout-maw-anatomy-empty">{{localize 'FALLOUTMAW.AuditTemplates.Text590e3e9e4148'}}</p>
    {{/if}}
  </section>
</section>
