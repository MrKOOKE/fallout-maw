<aside class="construct-visual-preview-panel">
  <header class="construct-visual-preview-heading"><h3>Предпросмотр</h3><label class="construct-visual-check construct-visual-enabled"><input type="checkbox" data-preview-anchors {{checked showPreviewAnchors}}><span>Отображение креплений</span></label></header>
  <div class="construct-visual-preview-frame" title="Колесо — масштаб; зажатая ПКМ — перемещение камеры"><div data-visual-preview style="aspect-ratio:{{previewAspect}}"></div>{{#if placingAnchor}}<p class="construct-visual-place-hint">Нажмите на модель, чтобы поставить крепление.</p>{{/if}}</div>
  <div class="construct-hub-preview-tools">
    <label class="construct-visual-check" title="Проверить прицел по курсору"><input type="checkbox" data-preview-aim {{checked previewAim}}><span>Прицел по курсору</span></label>
    <div class="construct-visual-camera-tools"><span class="construct-visual-camera-hint" title="Колесо — масштаб; зажатая ПКМ — перемещение камеры">Колесо · ПКМ</span><button type="button" class="construct-visual-fit-button" data-action="resetPreviewCamera" title="Вписать модель в предпросмотр" aria-label="Вписать модель в предпросмотр"><span data-preview-scale>{{previewScale}}</span><i class="fa-solid fa-expand"></i></button><button type="button" class="construct-visual-icon-button" data-action="resetVisualAim" title="Вернуть исходный поворот"><i class="fa-solid fa-rotate-left"></i></button></div>
  </div>
  <details class="construct-visual-advanced" data-hub-details="token-settings"><summary>Настройки токена</summary>
    <div class="construct-hub-token-settings">
    <label class="construct-visual-check"><input type="checkbox" data-visual-kind="config" data-visual-key="enabled" {{checked config.enabled}}><span>Модульный токен включён</span></label>
    <label>Проверить прицел<select data-preview-slot aria-label="Деталь для проверки прицела"><option value="">Первая вращаемая деталь</option>{{#each previewParts}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>Подложка токена</label><div class="construct-visual-image-field"><input type="text" value="{{config.baseImage}}" data-visual-kind="config" data-visual-key="baseImage" placeholder="Без подложки"><button type="button" class="construct-visual-icon-button" data-action="pickVisualImage" data-kind="config" data-key="baseImage" title="Выбрать подложку"><i class="fa-solid fa-folder-open"></i></button></div>
    <div class="construct-visual-two-columns"><label>Сектор корпуса, °<input type="number" value="{{config.hullRotationCost.degrees}}" min="1" max="360" step="1" data-visual-kind="config" data-visual-key="hullRotationCost" data-cost-key="degrees"></label><label>Цена, ОП<input type="number" value="{{config.hullRotationCost.points}}" min="0" step="1" data-visual-kind="config" data-visual-key="hullRotationCost" data-cost-key="points"></label></div>
    <p class="hint">Оплата открывает сектор от угла в начале хода. 0 — без расхода. Энергия списывается как при движении.</p>
    </div>
  </details>
</aside>
