<section class="fallout-maw-anatomy-study-body fallout-maw-perfect-fit-body">
  <header class="fallout-maw-anatomy-study-header fallout-maw-maintained-target-header">
    <button type="button" data-action="select" {{#if selectionDisabled}}disabled{{/if}} title="{{selectionDisabledReason}}">
      <i class="fa-solid fa-crosshairs"></i>
      Выбрать цель
    </button>
  </header>

  <section class="fallout-maw-anatomy-costs">
    <span><i class="fa-solid fa-vest"></i> Требования снаряжения: <strong>{{equipmentRequirementPercent}}%</strong></span>
    <span><i class="fa-solid fa-gun"></i> Требования оружия: <strong>{{weaponRequirementPercent}}%</strong></span>
    <span><i class="fa-solid fa-bolt"></i> Удержание одной цели: <strong>{{holdEnergy}} энергии</strong></span>
    <span><i class="fa-solid fa-battery-three-quarters"></i> Доступно: <strong>{{availableEnergy}} энергии</strong></span>
  </section>

  {{#if selectionDisabledReason}}
  <section class="fallout-maw-anatomy-memory"><p>{{selectionDisabledReason}}</p></section>
  {{/if}}

  <section class="fallout-maw-anatomy-knowledge">
    <h2>Удерживаемые цели</h2>
    {{#if hasHolds}}
      <div class="fallout-maw-maintained-target-list">
      {{#each holds}}
      <div class="fallout-maw-maintained-target-row">
        <img src="{{img}}" alt="{{name}}">
        <strong title="{{name}}">{{name}}</strong>
        <span class="fallout-maw-maintained-target-summary">снаряжение {{equipmentRequirementPercent}}% · оружие {{weaponRequirementPercent}}%</span>
        <span class="fallout-maw-maintained-target-energy">{{energy}} <i class="fa-solid fa-bolt"></i></span>
        <button type="button" data-action="release" data-effect-id="{{effectId}}" title="Отключить удержание">
          <i class="fa-solid fa-link-slash"></i>
        </button>
      </div>
      {{/each}}
      </div>
    {{else}}
      <p class="fallout-maw-anatomy-empty">Удерживаемых целей нет. Нажмите «Выбрать цель», чтобы передать пассивный бонус.</p>
    {{/if}}
  </section>
</section>
