<div class="{{#if isMechanical}}fallout-maw-mechanical{{else}}fallout-maw-hack{{/if}}" aria-busy="{{busy}}">
  {{#if isMechanical}}
    <div class="maw-mech-sheet" data-hack-scroll="screen">
      <header class="maw-mech-heading">
        <p class="maw-mech-status">{{statusLabel}}</p>
        <h2>{{targetName}}</h2>
        <p class="maw-mech-identity">{{hackerName}}<span aria-hidden="true"> / </span>{{skillLabel}}</p>
      </header>
      {{#if choosingMethod}}
        <section class="maw-mech-section" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text2df0274cdbcd'}}">
          <h3>{{localize 'FALLOUTMAW.AuditTemplates.Textefd846da906e'}}</h3>
          <div class="maw-mech-options" data-hack-options>
            {{#each methods}}
              <button type="button" class="maw-mech-option {{#if selected}}is-selected{{/if}}" data-action="selectMethod" data-hacking-method="{{id}}" data-focus-key="method:{{id}}" aria-pressed="{{selected}}" {{#if ../busy}}disabled{{/if}}>
                <span class="maw-mech-radio" aria-hidden="true"></span>
                <span class="maw-mech-option-copy"><strong>{{label}}</strong><span>{{localize 'FALLOUTMAW.Ability.Actions.EventSkillDifficulty'}} {{difficulty}} {{localize 'FALLOUTMAW.AuditTemplates.Textf549f8ca8cbc'}} {{toolClass}} {{localize 'FALLOUTMAW.AuditTemplates.Text789de28165a6'}} {{attemptsRemaining}} / {{attempts}}</span>{{#if blockReason}}<em>{{blockReason}}</em>{{/if}}</span>
              </button>
            {{else}}<p class="maw-mech-empty">{{localize 'FALLOUTMAW.AuditTemplates.Text9a78f5546c3d'}}</p>{{/each}}
          </div>
        </section>
      {{else}}
        <dl class="maw-mech-conditions" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text2e5ef6c28ac9'}}">
          <div><dt>{{localize 'FALLOUTMAW.Ability.Actions.EventSkillDifficulty'}}</dt><dd>{{difficulty}}</dd></div>
          <div><dt>{{localize 'FALLOUTMAW.AuditTemplates.Textf88162d24412'}}</dt><dd>{{requiredClass}}</dd></div>
          <div><dt>{{localize 'FALLOUTMAW.Item.TrapDisarmAttempts'}}</dt><dd>{{attemptsRemaining}} <span>/ {{attemptsTotal}}</span></dd></div>
        </dl>
        <section class="maw-mech-section" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text517d651f0adf'}}">
          <div class="maw-mech-method"><div><h3>{{localize 'FALLOUTMAW.AuditTemplates.Textefd846da906e'}}</h3><p>{{selectedMethod.label}}</p></div>{{#if canChooseMethod}}<button type="button" class="maw-mech-link" data-action="chooseMethod" data-focus-key="chooseMethod" {{#if busy}}disabled{{/if}}>{{localize 'FALLOUTMAW.AuditTemplates.Text279c2c3c9085'}}</button>{{/if}}</div>
          <div class="maw-mech-list-heading"><h3>{{localize 'FALLOUTMAW.Item.FunctionTool'}}</h3><span>{{localize 'FALLOUTMAW.Ability.TriggerCost.Resource'}}</span></div>
          <div class="maw-mech-options" data-hack-options>
            {{#each tools}}
              <button type="button" class="maw-mech-option {{#if selected}}is-selected{{/if}}" data-action="selectTool" data-hacking-candidate="{{candidateKey}}" data-focus-key="tool:{{candidateKey}}" aria-pressed="{{selected}}" {{#if disabled}}disabled{{/if}}>
                <span class="maw-mech-radio" aria-hidden="true"></span>
                <span class="maw-mech-option-copy"><strong>{{name}}</strong><span>{{localize 'FALLOUTMAW.Item.ConditionRecoveryClass'}} {{toolClass}}</span>{{#if blockReason}}<em>{{blockReason}}</em>{{/if}}</span>
                <span class="maw-mech-resource"><strong>{{supplyValue}}{{#if hasMeter}} <small>/ {{supplyMax}}</small>{{/if}}</strong><span>{{resourceLabel}}</span></span>
              </button>
            {{/each}}
          </div>
          {{#if selectedTool}}<p class="maw-mech-cost">{{localize 'FALLOUTMAW.AuditTemplates.Text46035349feee'}} <strong>{{selectedTool.toolCost}}</strong><span class="maw-mech-after">{{resourceLabel}} {{localize 'FALLOUTMAW.AuditTemplates.Text821cdcdc35e5'}} <strong>{{remainingSupply}}</strong></span></p>{{/if}}
        </section>
      {{/if}}
      <div class="maw-mech-feedback" role="status" aria-live="polite" aria-atomic="true">
        {{#if feedback}}<p><strong>{{feedback.title}}</strong></p><p>{{feedback.text}}</p>{{/if}}
        {{#unless choosingMethod}}{{#if blockReason}}<p>{{blockReason}}</p>{{/if}}{{/unless}}
        {{#if busy}}<p>{{actionLabel}}</p>{{/if}}
      </div>
    </div>
    <footer class="maw-mech-footer">
      <button type="button" class="maw-mech-close" data-action="closeDialog" data-focus-key="close">{{localize 'FALLOUTMAW.Common.Cancel'}}</button>
      {{#if choosingMethod}}<button type="button" class="maw-mech-submit" data-action="showTools" data-focus-key="back" {{#if busy}}disabled{{/if}}>{{localize 'FALLOUTMAW.AuditTemplates.Text3d6bce15c0ca'}}</button>
      {{else}}<button type="button" class="maw-mech-submit" data-action="attemptHack" data-focus-key="attempt" {{#if hackDisabled}}disabled{{/if}}>{{buttonLabel}}</button>{{/if}}
    </footer>
  {{else}}
  <div class="fallout-maw-hack-screen">
    <div class="fallout-maw-hack-readout" data-hack-scroll="screen">
      <section class="fallout-maw-hack-target" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text8654dfc8e81b'}}">
        <p class="fallout-maw-hack-state">[ {{statusLabel}} ]</p>
        <h2>{{targetName}}</h2>
        <p class="fallout-maw-hack-identity">{{hackerName}} <span aria-hidden="true">/</span> {{skillLabel}}</p>
      </section>

      {{#if choosingMethod}}
        <section class="fallout-maw-hack-menu" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text2df0274cdbcd'}}">
          <h3>{{localize 'FALLOUTMAW.AuditTemplates.Text06b73933e3e0'}}</h3>
          <div class="fallout-maw-hack-options" data-hack-options>
            {{#each methods}}
              <button type="button" class="fallout-maw-hack-option fallout-maw-hack-method {{#if selected}}is-selected{{/if}}"
                data-action="selectMethod" data-hacking-method="{{id}}" data-focus-key="method:{{id}}" aria-pressed="{{selected}}" {{#if ../busy}}disabled{{/if}}>
                <span class="fallout-maw-hack-cursor" aria-hidden="true">{{#if selected}}&gt;{{else}}·{{/if}}</span>
                <span class="fallout-maw-hack-option-content"><strong>{{label}}</strong>
                  <span class="fallout-maw-hack-option-details">{{localize 'FALLOUTMAW.Ability.Actions.EventSkillDifficulty'}} {{difficulty}} {{localize 'FALLOUTMAW.AuditTemplates.Text409ab2ac1b94'}} {{toolClass}} {{localize 'FALLOUTMAW.AuditTemplates.Text28bd77b5dd3a'}} {{attemptsRemaining}} {{localize 'FALLOUTMAW.AuditTemplates.Textbeed16881732'}} {{attempts}}</span>
                  {{#if blockReason}}<span class="fallout-maw-hack-reason">! {{blockReason}}</span>{{/if}}
                </span>
              </button>
            {{else}}
              <p class="fallout-maw-hack-empty">{{localize 'FALLOUTMAW.AuditTemplates.Text9a78f5546c3d'}}</p>
            {{/each}}
          </div>
        </section>
      {{else}}
        <section class="fallout-maw-hack-session" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text9a896629047a'}}">
          <div class="fallout-maw-hack-method-line">
            <span class="fallout-maw-hack-label">{{localize 'FALLOUTMAW.AuditTemplates.Textb83a5b3ff617'}}</span>
            <strong>{{#if selectedMethod}}{{selectedMethod.label}}{{else}}{{localize 'FALLOUTMAW.AuditTemplates.Text7faabdf7a4b6'}}{{/if}}</strong>
            {{#if canChooseMethod}}<button type="button" class="fallout-maw-hack-text-command" data-action="chooseMethod" data-focus-key="chooseMethod" {{#if busy}}disabled{{/if}}>{{localize 'FALLOUTMAW.AuditTemplates.Textb9be790cf6d9'}}</button>{{/if}}
          </div>
          {{#if selectedMethod}}
            <p class="fallout-maw-hack-requirements">
              <span>{{localize 'FALLOUTMAW.Ability.Actions.EventSkillDifficulty'}} <b>{{difficulty}}</b></span>
              <span>{{localize 'FALLOUTMAW.Item.ConditionRecoveryClass'}} <b>{{requiredClass}}</b></span>
              <span>{{localize 'FALLOUTMAW.Item.TrapDisarmAttempts'}} <b>{{attemptsRemaining}}/{{attemptsTotal}}</b> <span class="fallout-maw-hack-lives" aria-hidden="true">{{#each attemptMarkers}}<span class="{{#unless remaining}}is-spent{{/unless}}">■</span>{{/each}}</span></span>
            </p>
          {{/if}}
        </section>

        <section class="fallout-maw-hack-menu" aria-label="{{localize 'FALLOUTMAW.AuditTemplates.Text517d651f0adf'}}">
          <h3>{{localize 'FALLOUTMAW.AuditTemplates.Text1d20103fd614'}}</h3>
          <div class="fallout-maw-hack-options" data-hack-options>
            {{#each tools}}
              <button type="button" class="fallout-maw-hack-option fallout-maw-hack-tool {{#if selected}}is-selected{{/if}}"
                data-action="selectTool" data-hacking-candidate="{{candidateKey}}" data-focus-key="tool:{{candidateKey}}" aria-pressed="{{selected}}" {{#if disabled}}disabled{{/if}}>
                <span class="fallout-maw-hack-cursor" aria-hidden="true">{{#if selected}}&gt;{{else}}·{{/if}}</span>
                <span class="fallout-maw-hack-option-content"><strong>{{name}}</strong>
                  <span class="fallout-maw-hack-option-details">{{localize 'FALLOUTMAW.Item.ConditionRecoveryClass'}} {{toolClass}} / {{resourceLabel}} {{supplyValue}}{{#if hasMeter}} {{localize 'FALLOUTMAW.AuditTemplates.Textbeed16881732'}} {{supplyMax}}{{/if}}</span>
                  {{#if blockReason}}<span class="fallout-maw-hack-reason">! {{blockReason}}</span>{{/if}}
                </span>
              </button>
            {{else}}
              <p class="fallout-maw-hack-empty">{{localize 'FALLOUTMAW.AuditTemplates.Text0a6db7bcbff4'}}</p>
            {{/each}}
          </div>
          {{#if selectedTool}}
            <p class="fallout-maw-hack-resource-line">{{resourceLabel}} {{localize 'FALLOUTMAW.AuditTemplates.Textca97ac00809b'}} <strong>{{selectedTool.supplyValue}} → {{remainingSupply}}</strong><span class="fallout-maw-hack-resource-cost">{{localize 'FALLOUTMAW.AuditTemplates.Text3f13eb3291a4'}} {{selectedTool.toolCost}}</span></p>
          {{/if}}
        </section>
      {{/if}}

      <div class="fallout-maw-hack-output" role="status" aria-live="polite" aria-atomic="true">
        {{#if feedback}}
          <p class="fallout-maw-hack-output-title">&gt; {{feedback.title}}</p>
          <p>{{feedback.text}}</p>
        {{/if}}
        {{#unless choosingMethod}}{{#if blockReason}}<p class="fallout-maw-hack-error">! {{blockReason}}</p>{{/if}}{{/unless}}
        {{#if busy}}<p>&gt; {{actionLabel}}<span class="fallout-maw-hack-block-cursor" aria-hidden="true">▌</span></p>{{/if}}
      </div>
    </div>

    <footer class="fallout-maw-hack-command-line">
      {{#if choosingMethod}}
        <button type="button" class="fallout-maw-hack-run" data-action="showTools" data-focus-key="back" {{#if busy}}disabled{{/if}}><span aria-hidden="true">&lt;</span> {{localize 'FALLOUTMAW.AuditTemplates.Textb214d3c6508e'}}</button>
      {{else}}
        <button type="button" class="fallout-maw-hack-run" data-action="attemptHack" data-focus-key="attempt" {{#if hackDisabled}}disabled{{/if}}><span aria-hidden="true">&gt;</span> {{buttonLabel}}<span class="fallout-maw-hack-command-end" aria-hidden="true">↵</span></button>
      {{/if}}
      <button type="button" class="fallout-maw-hack-exit" data-action="closeDialog" data-focus-key="close">{{localize 'FALLOUTMAW.AuditTemplates.Text725d31d2c2d3'}}</button>
    </footer>
  </div>
  {{/if}}
</div>
