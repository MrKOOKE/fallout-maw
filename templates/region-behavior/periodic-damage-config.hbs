<div class="fallout-maw-periodic-damage-region-form">
  <fieldset>
    <legend>{{localize "BEHAVIOR.SECTIONS.identity"}}</legend>
    <label>
      <span>{{localize "DOCUMENT.FIELDS.name.label"}}</span>
      <input type="text" name="name" value="{{source.name}}">
    </label>
  </fieldset>

  <fieldset>
    <legend>Получатели</legend>
    <p class="hint">Отношение определяется фракциями источника области. Выбор применяется ко всем воздействиям области: эффектам, урону и особым свойствам вроде дыма. Для прикреплённой области источником считается актёр токена-носителя.</p>
    <div class="fallout-maw-list-grid three-columns">
      {{#each targetRelationChoices}}
      <label>
        <span>{{label}}</span>
        <input type="checkbox" name="system.targetRelations.{{key}}" {{checked checked}}>
      </label>
      {{/each}}
    </div>
    <label>
      <span>UUID актёра-источника (необязательно)</span>
      <input type="text" name="system.sourceActorUuid" value="{{system.sourceActorUuid}}">
    </label>
  </fieldset>

  <fieldset>
    <legend>Эффект внутри области</legend>
    <div class="fallout-maw-list-grid two-columns">
      <label><span>Название эффекта</span><input type="text" name="system.effectName" value="{{system.effectName}}"></label>
      <label><span>Изображение эффекта</span><input type="text" name="system.effectImg" value="{{system.effectImg}}"></label>
    </div>
    <div class="fallout-maw-panel-header">
      <h3>Изменения</h3>
      <button type="button" data-action="addEffectChange"><i class="fa-solid fa-plus"></i> Добавить изменение</button>
    </div>
    <div class="fallout-maw-settings-table fallout-maw-region-effect-change-table">
      <div class="fallout-maw-settings-row fallout-maw-grid-header">
        <span>Ключ</span><span>Тип</span><span>Значение</span><span>Приоритет</span><span></span>
      </div>
      <div class="fallout-maw-region-effect-change-list">
        {{#each effectChanges}}
        <div class="fallout-maw-settings-row fallout-maw-region-effect-change-row" data-effect-change-index="{{index}}">
          <input type="text" name="system.effectChanges.{{index}}.key" value="{{key}}" data-effect-key-autocomplete>
          <select name="system.effectChanges.{{index}}.type">
            <option value="add" {{#if (eq type "add")}}selected{{/if}}>Сложение</option>
            <option value="multiply" {{#if (eq type "multiply")}}selected{{/if}}>Умножение</option>
            <option value="override" {{#if (eq type "override")}}selected{{/if}}>Замена</option>
            <option value="upgrade" {{#if (eq type "upgrade")}}selected{{/if}}>Повышение</option>
            <option value="downgrade" {{#if (eq type "downgrade")}}selected{{/if}}>Понижение</option>
          </select>
          <input type="text" name="system.effectChanges.{{index}}.value" value="{{value}}" data-formula-autocomplete="all">
          <input type="hidden" name="system.effectChanges.{{index}}.phase" value="{{phase}}">
          <input type="number" name="system.effectChanges.{{index}}.priority" value="{{priority}}" step="1">
          <button type="button" class="fallout-maw-icon-delete-button" data-action="deleteEffectChange" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{else}}
        <p class="fallout-maw-empty-list">Изменения не настроены.</p>
        {{/each}}
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "BEHAVIOR.SECTIONS.status"}}</legend>
    <div>
      <span>{{localize "DOCUMENT.FIELDS.disabled.label"}}</span>
      <input aria-label="{{localize 'DOCUMENT.FIELDS.disabled.label'}}" type="checkbox" name="disabled" {{checked source.disabled}}>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.DamageEntries"}}</legend>
    <div class="fallout-maw-panel-header">
      <h3>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.DamageEntries"}}</h3>
      <button type="button" data-action="addDamageEntry"><i class="fa-solid fa-plus"></i> {{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.AddDamageEntry"}}</button>
    </div>
    <div class="fallout-maw-settings-table fallout-maw-damage-entry-table">
      <div class="fallout-maw-settings-row fallout-maw-grid-header">
        <span>{{localize "FALLOUTMAW.Item.WeaponDamageType"}}</span>
        <span>{{localize "FALLOUTMAW.Common.Value"}}</span>
        <span></span>
      </div>
      <div class="fallout-maw-damage-entry-list">
        {{#each damageEntries}}
        <div class="fallout-maw-settings-row" data-damage-entry-index="{{index}}">
          <select name="system.damageEntries.{{index}}.damageTypeKey">
            {{#each damageTypeChoices}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          <input type="text" name="system.damageEntries.{{index}}.amount" value="{{amount}}" data-formula-autocomplete="all">
          <button type="button" class="fallout-maw-icon-delete-button" data-action="deleteDamageEntry" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{else}}
        <p class="fallout-maw-empty-list">{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.NoDamageEntries"}}</p>
        {{/each}}
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.Timing"}}</legend>
    <div class="fallout-maw-list-grid two-columns">
      <label>
        <span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.IntervalSeconds"}}</span>
        <input type="number" name="system.intervalSeconds" value="{{system.intervalSeconds}}" min="1" step="1">
      </label>
      <label>
        <span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.DelaySeconds"}}</span>
        <input type="number" name="system.delaySeconds" value="{{system.delaySeconds}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.DurationSeconds"}}</span>
        <input type="number" name="system.durationSeconds" value="{{system.durationSeconds}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.RadiusDeltaMeters"}}</span>
        <input type="number" name="system.radiusDeltaMeters" value="{{system.radiusDeltaMeters}}" step="1">
      </label>
      <div>
        <span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.DeleteRegionWhenExpired"}}</span>
        <input aria-label="{{localize 'FALLOUTMAW.RegionBehavior.PeriodicDamage.DeleteRegionWhenExpired'}}" type="checkbox" name="system.deleteRegionWhenExpired" {{checked system.deleteRegionWhenExpired}}>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.SpecialProperties"}}</legend>
    <div class="fallout-maw-panel-header">
      <h3>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.SpecialProperties"}}</h3>
      <button type="button" data-action="addRegionSpecialProperty"><i class="fa-solid fa-plus"></i> {{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.AddSpecialProperty"}}</button>
    </div>
    <div class="fallout-maw-region-special-property-list">
      {{#each regionSpecialProperties}}
      <div class="fallout-maw-settings-row fallout-maw-region-special-property-row" data-region-special-property-index="{{index}}">
        <select name="system.regionSpecialProperties.{{index}}.type" data-region-special-property-type="{{index}}">
          {{#each choices}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        {{#if isSmoke}}
        <label><span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.SmokeThickness"}}</span><input type="number" min="0" max="1" step="0.01" name="system.regionSpecialProperties.{{index}}.smoke.thickness" value="{{smoke.thickness}}"></label>
        <label><span>{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.SmokeDensity"}}</span><input type="number" min="0" max="100" step="1" name="system.regionSpecialProperties.{{index}}.smoke.densityPercent" value="{{smoke.densityPercent}}"></label>
        {{/if}}
        <button type="button" class="fallout-maw-icon-delete-button" data-action="deleteRegionSpecialProperty" title="{{localize 'FALLOUTMAW.Common.Delete'}}"><i class="fa-solid fa-trash"></i></button>
      </div>
      {{else}}
      <p class="fallout-maw-empty-list">{{localize "FALLOUTMAW.RegionBehavior.PeriodicDamage.NoSpecialProperties"}}</p>
      {{/each}}
    </div>
  </fieldset>
</div>
