<form action="submit">

    <div class="form-group">
        <input type="text" name="title" id="title" value="{{title}}" placeholder="{{localize "Name"}}">
        <input data-tooltip-direction="UP" data-tooltip="{{localize "simple-quest.markerConfig.displayLabel"}}" type="checkbox" name="displayLabel" id="displayLabel" {{#if displayLabel}}checked{{/if}}>
    </div>

    <div class="form-group">
        <textarea name="description" cols="30" rows="10" placeholder="{{localize "Description"}}">{{description}}</textarea>
    </div>

    <div class="form-group">
        <input type="text" name="journal" id="journal" value="{{journal}}" placeholder="{{localize "simple-quest.markerConfig.journal"}}">
    </div>

    <div class="form-group">
        <color-picker name="color" value="{{color}}"></color-picker>
    </div>

    <div class="form-group">
        <label for="hidden">{{localize "simple-quest.markerConfig.hidden"}}</label>
        <input type="checkbox" name="hidden" id="hidden" {{#if hidden}}checked{{/if}}>
    </div>

    <div class="form-group">
        <label for="scale">{{localize "Scale"}}</label>
        {{rangePicker name="scale" value=scale min=1 max=5 step=0.1}}
        <input type="checkbox" name="fixedScale" data-tooltip="simple-quest.markerConfig.fixedScale" {{#if fixedScale}}checked{{/if}}>
    </div>

    

    <div class="form-group">
        <input type="text" name="icon" id="icon" value="{{icon}}" placeholder="{{localize "simple-quest.markerConfig.icon"}}">
        {{filePicker type="imagevideo" target="icon"}}
    </div>

    <div class="quest-icons flexrow">
        {{#each icons as |icon|}}
        {{#if icon.isImage}}
        <i style="background-image: url('{{icon.icon}}');" class="{{icon.icon}}"></i>
        {{else}}
        <i class="{{icon.icon}}"></i>
        {{/if}}
        {{/each}}
    </div>

    <footer class="flexrow">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{localize
            "Save"}}</button>

        <button {{#unless id}}style="display: none" {{/unless}} type="button" id="delete-marker"><i
                class="fa-solid fa-trash"></i> {{localize "Delete"}}</button>

    </footer>
</form>
