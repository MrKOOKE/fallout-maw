<Window x:Class="FalloutMaW.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fallout TTG Launcher"
        Width="940" Height="700" MinWidth="800" MinHeight="610"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
  <Grid Margin="24" Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="FALLOUT TTG" FontSize="29" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
      </StackPanel>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="14,9" CornerRadius="4">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Установлено: " Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock x:Name="InstalledVersionText" Text="—" FontWeight="SemiBold" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Состояние" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
          <TextBlock x:Name="StatusText" Text="Подготовка…" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
          <TextBlock x:Name="ReleaseNotesText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="70" Margin="0,7,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="1" x:Name="AvailableVersionText" Foreground="{StaticResource AccentBrush}" FontSize="22" FontWeight="Bold" Margin="16,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <WrapPanel Grid.Row="2" Margin="0,0,0,6">
      <Button x:Name="CheckButton" Content="Проверить обновления" Click="CheckButton_Click" />
      <Button x:Name="InstallButton" Content="Установить / обновить" Style="{StaticResource PrimaryButton}" Click="InstallButton_Click" IsEnabled="False" />
      <Button x:Name="RepairButton" Content="Восстановить полностью" Click="RepairButton_Click" />
      <Button x:Name="RollbackButton" Content="Откатить" Click="RollbackButton_Click" />
      <Button x:Name="LaunchButton" Content="Запустить Foundry" Click="LaunchButton_Click" />
      <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" Visibility="Collapsed" />
    </WrapPanel>

    <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="FoundryVTT\Data" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox Grid.Column="1" x:Name="DataPathBox" Margin="0,0,8,8" />
        <Button Grid.Column="2" Content="Обзор…" Click="BrowseDataButton_Click" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Text="Канал обновлений" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ManifestUrlBox" Margin="0,0,0,8" />

        <TextBlock Grid.Row="2" Text="Foundry.exe" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="FoundryPathBox" Margin="0,0,8,8" />
        <Button Grid.Row="2" Grid.Column="2" Content="Обзор…" Click="BrowseFoundryButton_Click" Margin="0,0,0,8" />

        <CheckBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="AllowUnsignedCheck"
                  Content="Разрешить неподписанный канал (только для локальной проверки)"
                  Foreground="{StaticResource MutedTextBrush}" />
      </Grid>
    </Border>

    <TextBox Grid.Row="4" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" />

    <StackPanel Grid.Row="5" Margin="0,14,0,0">
      <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" IsIndeterminate="False" Foreground="{StaticResource AccentBrush}" />
      <TextBlock x:Name="ProgressText" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
    </StackPanel>
  </Grid>
</Window>
